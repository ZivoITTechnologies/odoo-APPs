<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ tools -->
    <record id="zivo_mcp_tool_view_list" model="ir.ui.view">
        <field name="name">zivo.mcp.tool.list</field>
        <field name="model">zivo.mcp.tool</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" decoration-muted="not available">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="technical_name"/>
                <field name="category" widget="badge" decoration-info="category == 'core'" decoration-success="category == 'finance'" decoration-warning="category == 'write'"/>
                <field name="default_enabled" widget="boolean_toggle"/>
                <field name="available"/>
                <field name="required_apps"/>
                <field name="call_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="zivo_mcp_tool_view_form" model="ir.ui.view">
        <field name="name">zivo.mcp.tool.form</field>
        <field name="model">zivo.mcp.tool</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_calls" type="object" class="oe_stat_button" icon="fa-bar-chart">
                            <field name="call_count" widget="statinfo" string="Calls (30d)"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <field name="technical_name" readonly="1" class="text-muted font-monospace"/>
                    </div>
                    <group>
                        <group>
                            <field name="category"/>
                            <field name="is_write" readonly="1"/>
                        </group>
                        <group>
                            <field name="default_enabled"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" readonly="1"/>
                            <group string="Custom description (optional)">
                                <field name="description_override" nolabel="1" colspan="2"/>
                            </group>
                        </page>
                        <page string="Parameters" name="schema">
                            <field name="input_schema" widget="ace" options="{'mode': 'javascript'}" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_zivo_mcp_tool" model="ir.actions.act_window">
        <field name="name">Tools</field>
        <field name="res_model">zivo.mcp.tool</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <!-- ============================================================ prompts -->
    <record id="zivo_mcp_prompt_view_list" model="ir.ui.view">
        <field name="name">zivo.mcp.prompt.list</field>
        <field name="model">zivo.mcp.prompt</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="technical_name"/>
                <field name="category" widget="badge"/>
                <field name="description"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="zivo_mcp_prompt_view_form" model="ir.ui.view">
        <field name="name">zivo.mcp.prompt.form</field>
        <field name="model">zivo.mcp.prompt</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Quarterly P&amp;L review"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="technical_name" placeholder="e.g. quarterly_pl_review"/>
                            <field name="category"/>
                        </group>
                        <group>
                            <field name="description"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Prompt">
                        <field name="template" nolabel="1" colspan="2" placeholder="Using the Odoo tools, give me the P&amp;L of {company} for {period}..."/>
                    </group>
                    <field name="argument_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="description"/>
                            <field name="required"/>
                            <field name="default_value"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_zivo_mcp_prompt" model="ir.actions.act_window">
        <field name="name">Prompt Library</field>
        <field name="res_model">zivo.mcp.prompt</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Share tested questions with your team</p>
            <p>Prompts appear in Claude and other MCP clients (e.g. the "+" menu in Claude Desktop) with their arguments.</p>
        </field>
    </record>

    <!-- ============================================================ key wizard -->
    <record id="zivo_mcp_key_wizard_view_form" model="ir.ui.view">
        <field name="name">zivo.mcp.key.wizard.form</field>
        <field name="model">zivo.mcp.key.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="state" invisible="1"/>
                <group invisible="state != 'setup'">
                    <group>
                        <field name="connector_id" readonly="1"/>
                        <field name="key_name"/>
                    </group>
                    <group>
                        <field name="duration"/>
                        <field name="revoke_previous"/>
                    </group>
                </group>
                <p class="text-muted" invisible="state != 'setup'">
                    The key is an Odoo API key of the integration user with the <b>MCP</b> scope. It is shown only once.
                </p>
                <div invisible="state != 'done'">
                    <div class="alert alert-warning" role="alert">
                        <i class="fa fa-exclamation-triangle me-1" title="Warning"/>
                        Copy the key now and store it in AnythingMCP (or your MCP client). It will not be shown again.
                    </div>
                    <group>
                        <field name="odoo_url" widget="CopyClipboardChar" string="ODOO_URL"/>
                        <field name="key" widget="CopyClipboardChar" string="ODOO_MCP_API_KEY"/>
                        <field name="endpoint_url" widget="CopyClipboardChar"/>
                    </group>
                    <field name="snippet" widget="CopyClipboardText" class="o_zivo_snippet"/>
                </div>
                <footer>
                    <button name="action_generate" string="Generate Key" type="object" class="btn-primary" invisible="state != 'setup'"/>
                    <button string="Cancel" special="cancel" invisible="state != 'setup'"/>
                    <button string="Done" special="cancel" class="btn-primary" invisible="state != 'done'"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
