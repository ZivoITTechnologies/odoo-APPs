<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_zivo_mcp" model="ir.module.category">
        <field name="name">AI Connector</field>
        <field name="sequence">90</field>
    </record>

    <record id="res_groups_privilege_zivo_mcp" model="res.groups.privilege">
        <field name="name">AI Connector (MCP)</field>
        <field name="sequence">90</field>
        <field name="category_id" ref="module_category_zivo_mcp"/>
    </record>

    <record id="group_zivo_mcp_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">5</field>
        <field name="privilege_id" ref="res_groups_privilege_zivo_mcp"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can connect Claude, ChatGPT and other AI assistants with "Sign in with Odoo" and manage their own AI sessions.</field>
    </record>

    <record id="group_zivo_mcp_auditor" model="res.groups">
        <field name="name">Auditor</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_zivo_mcp"/>
        <field name="implied_ids" eval="[(4, ref('group_zivo_mcp_user'))]"/>
        <field name="comment">Can see connectors, the prompt library and the audit log.</field>
    </record>

    <record id="group_zivo_mcp_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_zivo_mcp"/>
        <field name="implied_ids" eval="[(4, ref('group_zivo_mcp_auditor'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Configures connectors, integration users, tools and API keys.</field>
    </record>

    <record id="rule_zivo_mcp_oauth_token_own" model="ir.rule">
        <field name="name">AI sessions: own sessions</field>
        <field name="model_id" ref="model_zivo_mcp_oauth_token"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_zivo_mcp_user'))]"/>
    </record>
    <record id="rule_zivo_mcp_oauth_token_all" model="ir.rule">
        <field name="name">AI sessions: all sessions</field>
        <field name="model_id" ref="model_zivo_mcp_oauth_token"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_zivo_mcp_auditor'))]"/>
    </record>
</odoo>
