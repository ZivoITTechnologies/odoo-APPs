<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_job_work" name="Job Work" customize_show="True" inherit_id="portal.portal_my_home" priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_vendor_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_vendor_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/zivo_job_work_360/static/description/icon.png'"/>
                <t t-set="title">Job Work</t>
                <t t-set="text">Accept jobs, report progress and upload documents</t>
                <t t-set="url" t-value="'/my/job-works'"/>
                <t t-set="placeholder_count" t-value="'jw_count'"/>
            </t>
        </div>
    </template>

    <template id="portal_breadcrumbs_job_work" name="Portal layout: job work entries" inherit_id="portal.portal_breadcrumbs" priority="35">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'job_work'" class="breadcrumb-item active">Job Work</li>
            <li t-if="page_name == 'job_work_detail'" class="breadcrumb-item">
                <a t-attf-href="/my/job-works?{{ keep_query() }}">Job Work</a>
            </li>
            <li t-if="page_name == 'job_work_detail' and job" class="breadcrumb-item active">
                <t t-esc="job.name"/>
            </li>
        </xpath>
    </template>

    <template id="portal_my_job_works" name="My Job Work">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Job Work</t>
            </t>
            <div t-if="score" class="card mb-3 o_jw_portal_score">
                <div class="card-body d-flex flex-wrap gap-3 align-items-center">
                    <div>
                        <div class="text-muted small">Your performance (last <t t-esc="(score.date_to - score.date_from).days"/> days)</div>
                        <div class="fs-3 fw-bold">Grade <t t-esc="score.grade"/> · <t t-esc="'%.0f' % score.score"/>/100</div>
                    </div>
                    <div class="ms-md-auto d-flex flex-wrap gap-3 small">
                        <span>On-time <strong t-esc="'%.1f%%' % score.on_time_rate"/></span>
                        <span>Quality <strong t-esc="'%.1f%%' % score.quality_rate"/></span>
                        <span>Yield <strong t-esc="'%.1f%%' % score.yield_rate"/></span>
                        <span>Scrap <strong t-esc="'%.2f%%' % score.scrap_rate"/></span>
                    </div>
                </div>
            </div>
            <t t-if="not jobs">
                <div class="alert alert-info">There are no job work orders in this view.</div>
            </t>
            <t t-if="jobs" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Job Work</th>
                        <th class="d-none d-md-table-cell">Process</th>
                        <th>Product</th>
                        <th class="text-end">Quantity</th>
                        <th class="text-end">Due</th>
                        <th class="text-end">Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="jobs" t-as="job">
                        <td>
                            <a t-att-href="job.get_portal_url()"><strong t-esc="job.name"/></a>
                            <span t-if="job.priority == '2'" class="badge text-bg-danger ms-1">Urgent</span>
                        </td>
                        <td class="d-none d-md-table-cell" t-esc="job.job_type_id.name"/>
                        <td t-esc="job.product_id.display_name"/>
                        <td class="text-end"><t t-esc="job._jw_fmt_qty(job.product_qty)"/> <t t-esc="job.product_uom_id.name"/></td>
                        <td class="text-end">
                            <span t-field="job.date_expected" t-options='{"widget": "date"}'
                                  t-att-class="'text-danger fw-bold' if job.is_overdue else ''"/>
                        </td>
                        <td class="text-end">
                            <span t-attf-class="badge #{'text-bg-warning' if job.vendor_state in ('new',) else 'text-bg-info' if job.vendor_state in ('accepted', 'received', 'processing') else 'text-bg-success' if job.vendor_state == 'completed' else 'text-bg-danger'}"
                                  t-field="job.vendor_state"/>
                        </td>
                    </tr>
                </tbody>
            </t>
        </t>
    </template>

    <template id="portal_job_work_page" name="Job Work Portal Page">
        <t t-call="portal.portal_layout">
            <t t-set="o_portal_fullwidth_alert" groups="zivo_job_work_360.group_job_work_user">
                <t t-call="portal.portal_back_in_edit_mode">
                    <t t-set="backend_url" t-value="'/odoo/action-zivo_job_work_360.action_zivo_job_work/%s' % job.id"/>
                </t>
            </t>
            <t t-set="token_q" t-value="('?access_token=%s' % access_token) if access_token else ''"/>
            <div class="o_jw_portal row mt-3">
                <div class="col-12">
                    <div t-if="error" class="alert alert-danger" role="alert" t-esc="error"/>
                    <div t-if="success" class="alert alert-success" role="alert" t-esc="success"/>

                    <!-- Mobile job view -->
                    <div class="card mb-3 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex flex-wrap align-items-start gap-2">
                                <div>
                                    <h3 class="mb-0"><t t-esc="job.name"/> <small class="text-muted">| <t t-esc="job.product_id.display_name"/></small></h3>
                                    <div class="text-muted">
                                        <t t-esc="job.job_type_id.name"/> · Due
                                        <span t-field="job.date_expected" t-options='{"widget": "date"}'
                                              t-att-class="'text-danger fw-bold' if job.is_overdue else ''"/>
                                        <t t-if="job.client_ref"> · Ref <t t-esc="job.client_ref"/></t>
                                    </div>
                                </div>
                                <div class="ms-auto text-end">
                                    <span class="badge text-bg-primary fs-6" t-field="job.vendor_state"/>
                                    <div class="mt-1">
                                        <a class="btn btn-sm btn-outline-secondary" t-att-href="job.get_portal_url(report_type='pdf', download=True)">
                                            <i class="fa fa-download"/> Job Sheet PDF
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div class="row g-2 mt-3 text-center">
                                <div class="col-4 col-md">
                                    <div class="border rounded p-2"><div class="small text-muted">Required</div>
                                        <div class="fs-4 fw-bold" t-esc="job._jw_fmt_qty(job.product_qty)"/><div class="small" t-esc="job.product_uom_id.name"/></div>
                                </div>
                                <div class="col-4 col-md">
                                    <div class="border rounded p-2"><div class="small text-muted">Completed</div>
                                        <div class="fs-4 fw-bold" t-esc="job._jw_fmt_qty(job.vendor_reported_qty)"/><div class="small">reported</div></div>
                                </div>
                                <div class="col-4 col-md">
                                    <div class="border rounded p-2"><div class="small text-muted">Delivered</div>
                                        <div class="fs-4 fw-bold" t-esc="job._jw_fmt_qty(job.qty_received)"/><div class="small">received by us</div></div>
                                </div>
                                <div class="col-6 col-md">
                                    <div class="border rounded p-2"><div class="small text-muted">Scrap</div>
                                        <div class="fs-4 fw-bold" t-esc="job._jw_fmt_qty(job.vendor_reported_scrap)"/><div class="small">reported</div></div>
                                </div>
                                <div class="col-6 col-md">
                                    <div class="border rounded p-2"><div class="small text-muted">Balance</div>
                                        <div class="fs-4 fw-bold" t-esc="job._jw_fmt_qty(job.qty_remaining)"/><div class="small">to deliver</div></div>
                                </div>
                            </div>

                            <!-- Actions -->
                            <div t-if="can_act" class="d-flex flex-wrap gap-2 mt-3">
                                <form t-if="job.vendor_state in ('new', 'rejected') and job.state in ('planned', 'ready', 'issued')"
                                      method="post" t-attf-action="/my/job-works/#{job.id}/action">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="access_token" t-att-value="access_token"/>
                                    <input type="hidden" name="action" value="accept"/>
                                    <button type="submit" class="btn btn-success btn-lg"><i class="fa fa-check"/> Accept Job</button>
                                </form>
                                <button t-if="job.vendor_state == 'new' and job.state in ('planned', 'ready')" type="button"
                                        class="btn btn-outline-danger btn-lg" data-bs-toggle="collapse" data-bs-target="#jw_reject">
                                    <i class="fa fa-times"/> Reject
                                </button>
                                <form t-if="job.state == 'issued' and job.vendor_state in ('new', 'accepted')"
                                      method="post" t-attf-action="/my/job-works/#{job.id}/action">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="access_token" t-att-value="access_token"/>
                                    <input type="hidden" name="action" value="receipt"/>
                                    <button type="submit" class="btn btn-primary btn-lg"><i class="fa fa-inbox"/> Confirm Material Receipt</button>
                                </form>
                                <form t-if="job.state in ('issued', 'at_vendor') and job.vendor_state in ('accepted', 'received')"
                                      method="post" t-attf-action="/my/job-works/#{job.id}/action">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="access_token" t-att-value="access_token"/>
                                    <input type="hidden" name="action" value="start"/>
                                    <button type="submit" class="btn btn-primary btn-lg"><i class="fa fa-play"/> Start</button>
                                </form>
                                <button t-if="job.state in ('issued', 'at_vendor', 'processing', 'qc_pending')" type="button"
                                        class="btn btn-secondary btn-lg" data-bs-toggle="collapse" data-bs-target="#jw_report">
                                    <i class="fa fa-pencil"/> Report
                                </button>
                                <button t-if="job.state in ('ready', 'issued', 'at_vendor', 'processing', 'qc_pending')" type="button"
                                        class="btn btn-secondary btn-lg" data-bs-toggle="collapse" data-bs-target="#jw_request">
                                    <i class="fa fa-cubes"/> Request Material
                                </button>
                                <button type="button" class="btn btn-secondary btn-lg" data-bs-toggle="collapse" data-bs-target="#jw_upload">
                                    <i class="fa fa-upload"/> Upload
                                </button>
                                <form t-if="job.state in ('issued', 'at_vendor', 'processing', 'qc_pending') and job.vendor_state != 'completed'"
                                      method="post" t-attf-action="/my/job-works/#{job.id}/action">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="access_token" t-att-value="access_token"/>
                                    <input type="hidden" name="action" value="complete"/>
                                    <button type="submit" class="btn btn-success btn-lg"><i class="fa fa-flag-checkered"/> Complete</button>
                                </form>
                            </div>

                            <div class="collapse mt-3" id="jw_reject">
                                <form method="post" t-attf-action="/my/job-works/#{job.id}/action" class="card card-body">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="access_token" t-att-value="access_token"/>
                                    <input type="hidden" name="action" value="reject"/>
                                    <label class="form-label" for="jw_reject_reason">Reason for rejecting the job</label>
                                    <textarea id="jw_reject_reason" name="reason" class="form-control" rows="2" required="required"/>
                                    <button type="submit" class="btn btn-danger mt-2 align-self-start">Reject Job</button>
                                </form>
                            </div>
                            <div class="collapse mt-3" id="jw_report">
                                <form method="post" t-attf-action="/my/job-works/#{job.id}/progress" class="card card-body">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="access_token" t-att-value="access_token"/>
                                    <h5>Report production</h5>
                                    <div class="row g-2">
                                        <div class="col-6 col-md-3">
                                            <label class="form-label" for="jw_qty_completed">Completed (<t t-esc="job.product_uom_id.name"/>)</label>
                                            <input id="jw_qty_completed" type="number" step="any" min="0" name="qty_completed" class="form-control"/>
                                        </div>
                                        <div class="col-6 col-md-3">
                                            <label class="form-label" for="jw_qty_scrap">Scrap</label>
                                            <input id="jw_qty_scrap" type="number" step="any" min="0" name="qty_scrap" class="form-control"/>
                                        </div>
                                        <div class="col-6 col-md-3">
                                            <label class="form-label" for="jw_qty_rejected">Rejected</label>
                                            <input id="jw_qty_rejected" type="number" step="any" min="0" name="qty_rejected" class="form-control"/>
                                        </div>
                                        <div class="col-6 col-md-3">
                                            <label class="form-label" for="jw_qty_rework">Rework</label>
                                            <input id="jw_qty_rework" type="number" step="any" min="0" name="qty_rework" class="form-control"/>
                                        </div>
                                    </div>
                                    <label class="form-label mt-2" for="jw_note">Comment</label>
                                    <textarea id="jw_note" name="note" class="form-control" rows="2"/>
                                    <button type="submit" class="btn btn-primary mt-2 align-self-start">Submit Report</button>
                                </form>
                            </div>
                            <div class="collapse mt-3" id="jw_request">
                                <form method="post" t-attf-action="/my/job-works/#{job.id}/request" class="card card-body">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="access_token" t-att-value="access_token"/>
                                    <h5>Request additional material</h5>
                                    <div class="row g-2">
                                        <div class="col-md-6">
                                            <label class="form-label" for="jw_req_material">Material</label>
                                            <select id="jw_req_material" name="material_id" class="form-select" required="required">
                                                <t t-foreach="materials" t-as="mat">
                                                    <option t-att-value="mat.id"><t t-esc="mat.product_id.display_name"/> (<t t-esc="mat.product_uom_id.name"/>)</option>
                                                </t>
                                            </select>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label" for="jw_req_qty">Quantity</label>
                                            <input id="jw_req_qty" type="number" step="any" min="0" name="qty" class="form-control" required="required"/>
                                        </div>
                                    </div>
                                    <label class="form-label mt-2" for="jw_req_reason">Reason</label>
                                    <textarea id="jw_req_reason" name="reason" class="form-control" rows="2" required="required"/>
                                    <button type="submit" class="btn btn-primary mt-2 align-self-start">Send Request</button>
                                </form>
                            </div>
                            <div class="collapse mt-3" id="jw_upload">
                                <form method="post" t-attf-action="/my/job-works/#{job.id}/upload" enctype="multipart/form-data" class="card card-body">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="access_token" t-att-value="access_token"/>
                                    <h5>Upload documents</h5>
                                    <div class="row g-2">
                                        <div class="col-md-5">
                                            <label class="form-label" for="jw_doc_type">Document type</label>
                                            <select id="jw_doc_type" name="doc_type" class="form-select">
                                                <t t-foreach="doc_types.items()" t-as="dt">
                                                    <option t-att-value="dt[0]" t-esc="dt[1]"/>
                                                </t>
                                            </select>
                                        </div>
                                        <div class="col-md-7">
                                            <label class="form-label" for="jw_file">Files (PDF, images, office documents - max 20 MB)</label>
                                            <input id="jw_file" type="file" name="attachment" multiple="multiple" class="form-control" required="required"/>
                                        </div>
                                    </div>
                                    <button type="submit" class="btn btn-primary mt-2 align-self-start">Upload</button>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- Material -->
                    <div class="card mb-3">
                        <div class="card-header"><strong>Material supplied to you</strong></div>
                        <div class="table-responsive">
                            <table class="table table-sm mb-0">
                                <thead>
                                    <tr>
                                        <th>Material</th>
                                        <th class="text-end">Required</th>
                                        <th class="text-end">Sent</th>
                                        <th class="text-end d-none d-md-table-cell">Consumed</th>
                                        <th class="text-end d-none d-md-table-cell">Returned</th>
                                        <th class="text-end d-none d-md-table-cell">Scrap</th>
                                        <th class="text-end">Balance</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="materials" t-as="mat">
                                        <td><t t-esc="mat.product_id.display_name"/> <small class="text-muted" t-esc="mat.product_uom_id.name"/></td>
                                        <td class="text-end" t-esc="job._jw_fmt_qty(mat.planned_qty, mat.product_uom_id)"/>
                                        <td class="text-end" t-esc="job._jw_fmt_qty(mat.qty_issued, mat.product_uom_id)"/>
                                        <td class="text-end d-none d-md-table-cell" t-esc="job._jw_fmt_qty(mat.qty_consumed, mat.product_uom_id)"/>
                                        <td class="text-end d-none d-md-table-cell" t-esc="job._jw_fmt_qty(mat.qty_returned, mat.product_uom_id)"/>
                                        <td class="text-end d-none d-md-table-cell" t-esc="job._jw_fmt_qty(mat.qty_scrap, mat.product_uom_id)"/>
                                        <td class="text-end fw-bold" t-esc="job._jw_fmt_qty(mat.balance_qty, mat.product_uom_id)"/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="card mb-3" t-if="job.notes or job.shared_attachment_ids">
                        <div class="card-header"><strong>Instructions &amp; Documents</strong></div>
                        <div class="card-body">
                            <div t-if="job.notes" t-field="job.notes"/>
                            <ul t-if="job.shared_attachment_ids" class="list-unstyled mb-0 mt-2">
                                <li t-foreach="job.shared_attachment_ids" t-as="att">
                                    <a t-attf-href="/web/content/#{att.id}?download=true&amp;access_token=#{att.access_token}">
                                        <i class="fa fa-file-o"/> <t t-esc="att.name"/>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div class="card mb-3" t-if="job.progress_ids">
                        <div class="card-header"><strong>Your progress reports</strong></div>
                        <div class="table-responsive">
                            <table class="table table-sm mb-0">
                                <thead><tr><th>Date</th><th class="text-end">Completed</th><th class="text-end">Scrap</th>
                                    <th class="text-end">Rejected</th><th class="text-end">Rework</th><th class="d-none d-md-table-cell">Comment</th></tr></thead>
                                <tbody>
                                    <tr t-foreach="job.progress_ids" t-as="p">
                                        <td><span t-field="p.date" t-options='{"widget": "date"}'/></td>
                                        <td class="text-end" t-esc="job._jw_fmt_qty(p.qty_completed)"/>
                                        <td class="text-end" t-esc="job._jw_fmt_qty(p.qty_scrap)"/>
                                        <td class="text-end" t-esc="job._jw_fmt_qty(p.qty_rejected)"/>
                                        <td class="text-end" t-esc="job._jw_fmt_qty(p.qty_rework)"/>
                                        <td class="d-none d-md-table-cell" t-esc="p.note"/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div id="job_work_communication" class="mt-4">
                        <h4>Communication</h4>
                        <t t-call="portal.message_thread"/>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
