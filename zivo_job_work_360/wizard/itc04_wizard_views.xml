<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zivo_job_work_itc04_wizard_form" model="ir.ui.view">
        <field name="name">zivo.job.work.itc04.wizard.form</field>
        <field name="model">zivo.job.work.itc04.wizard</field>
        <field name="arch" type="xml">
            <form string="ITC-04 Preparation">
                <div class="alert alert-info" role="alert">
                    Choose the return period configured for your company (quarterly, half-yearly or annual).
                    The export prepares Table 4 (goods sent) and Table 5A (goods received back, losses &amp;
                    wastes) with a validation sheet. Validate against the current GSTN offline tool before filing.
                </div>
                <group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="table4_count"/>
                        <field name="table5_count"/>
                        <field name="warning_count" decoration-warning="warning_count &gt; 0"/>
                    </group>
                </group>
                <field name="warning_text" readonly="1"/>
                <footer>
                    <button name="action_export_xlsx" type="object" string="Export XLSX" class="btn-primary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_zivo_job_work_itc04_wizard" model="ir.actions.act_window">
        <field name="name">ITC-04 Preparation</field>
        <field name="res_model">zivo.job.work.itc04.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
