<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_job_work" model="res.groups.privilege">
        <field name="name">Job Work</field>
        <field name="sequence">6</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>

    <record id="group_job_work_viewer" model="res.groups">
        <field name="name">Viewer (Management)</field>
        <field name="sequence">5</field>
        <field name="privilege_id" ref="res_groups_privilege_job_work"/>
        <field name="comment">Read-only access to job work orders, dashboards and reports.</field>
    </record>

    <record id="group_job_work_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_job_work"/>
        <field name="implied_ids" eval="[(4, ref('group_job_work_viewer')), (4, ref('stock.group_stock_user')), (4, ref('purchase.group_purchase_user')), (4, ref('stock.group_stock_multi_locations'))]"/>
        <field name="comment">Planners, stores, quality and accounts users: create, issue, receive, inspect and cost job work.</field>
    </record>

    <record id="group_job_work_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_job_work"/>
        <field name="implied_ids" eval="[(4, ref('group_job_work_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Configuration, approvals (loss, extra material, bill variance), reconciliation and scorecards.</field>
    </record>
</odoo>
