<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_job_list" model="ir.ui.view">
        <field name="name">zivo.shopify.job.list</field>
        <field name="model">zivo.shopify.job</field>
        <field name="arch" type="xml">
            <list create="0" decoration-danger="state == 'failed'" decoration-muted="state == 'cancelled'">
                <header>
                    <button name="action_retry" string="Retry" type="object"/>
                    <button name="action_cancel" string="Cancel" type="object"/>
                </header>
                <field name="create_date" string="Created"/>
                <field name="name"/>
                <field name="instance_id"/>
                <field name="job_type"/>
                <field name="source" widget="badge"/>
                <field name="attempts"/>
                <field name="duration"/>
                <field name="ai_root_cause"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-danger="state == 'failed'" decoration-info="state in ('pending', 'running')"/>
            </list>
        </field>
    </record>
    <record id="view_job_form" model="ir.ui.view">
        <field name="name">zivo.shopify.job.form</field>
        <field name="model">zivo.shopify.job</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <header>
                    <button name="action_retry" string="Retry" type="object" class="btn-primary" invisible="state not in ('failed', 'cancelled')"/>
                    <button name="action_run_now" string="Run Now" type="object" invisible="state != 'pending'"/>
                    <button name="action_ai_diagnose" string="Ask AI for Deeper Diagnosis" type="object" invisible="not error_message"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state not in ('pending', 'failed')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="instance_id"/>
                            <field name="job_type"/>
                            <field name="source"/>
                            <field name="external_ref"/>
                        </group>
                        <group>
                            <field name="attempts"/>
                            <field name="next_attempt_at"/>
                            <field name="finished_at"/>
                            <field name="duration"/>
                        </group>
                    </group>
                    <div class="alert alert-danger" role="alert" invisible="not ai_root_cause">
                        <strong><field name="ai_root_cause" nolabel="1"/></strong>
                        <div class="mt-2"><field name="ai_fix" nolabel="1"/></div>
                        <small class="text-muted">Diagnosed by <field name="ai_source" nolabel="1" class="d-inline"/></small>
                    </div>
                    <group string="Result" invisible="not result"><field name="result" nolabel="1"/></group>
                    <group string="Technical Details" invisible="not error_message">
                        <field name="error_code"/>
                        <field name="transient_error"/>
                        <field name="error_message"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_job_search" model="ir.ui.view">
        <field name="name">zivo.shopify.job.search</field>
        <field name="model">zivo.shopify.job</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="external_ref"/>
                <field name="instance_id"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <filter name="open" string="In Queue" domain="[('state', 'in', ('pending', 'running'))]"/>
                <filter name="webhook" string="Webhooks" domain="[('source', '=', 'webhook')]"/>
                <filter name="group_type" string="Job Type" context="{'group_by': 'job_type'}"/>
                <filter name="group_cause" string="Root Cause" context="{'group_by': 'ai_root_cause'}"/>
            </search>
        </field>
    </record>
    <record id="action_jobs" model="ir.actions.act_window">
        <field name="name">Sync Queue</field>
        <field name="res_model">zivo.shopify.job</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_failed_jobs" model="ir.actions.act_window">
        <field name="name">Failed Jobs</field>
        <field name="res_model">zivo.shopify.job</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'failed')]</field>
        <field name="context">{'search_default_group_cause': 1}</field>
    </record>
</odoo>
