        <field name="code">model._cron_import_checkouts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
    </record>
    <record id="cron_import_payouts" model="ir.cron">
        <field name="name">Shopify: Import Payouts</field>
        <field name="model_id" ref="model_zivo_shopify_instance"/>
