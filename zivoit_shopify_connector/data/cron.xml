        <field name="name">Shopify: Stock Drift Guard</field>
        <field name="model_id" ref="model_zivo_shopify_instance"/>
        <field name="state">code</field>
        <field name="code">model._cron_drift_guard()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
    <record id="cron_cleanup" model="ir.cron">
        <field name="name">Shopify: Clean Old Jobs</field>
        <field name="model_id" ref="model_zivo_shopify_job"/>
        <field name="state">code</field>
