<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_tally" model="ir.module.category">
        <field name="name">Tally Connector</field>
        <field name="sequence">60</field>
    </record>
    <record id="privilege_tally" model="res.groups.privilege">
        <field name="name">Tally Connector</field>
        <field name="category_id" ref="module_category_tally"/>
    </record>

    <record id="group_tally_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_tally"/>
        <field name="comment">Review Tally vouchers, mappings and logs; push documents.</field>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>
    <record id="group_tally_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_tally"/>
        <field name="comment">Configure connections, AI keys and agent tokens.</field>
        <field name="implied_ids" eval="[(4, ref('group_tally_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="group_tally_agent" model="res.groups">
        <field name="name">Tally Bridge Agent (API user)</field>
        <field name="comment">Technical user whose API key the on-premise agent uses.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_tally_connection_company" model="ir.rule">
        <field name="name">Tally connection: multi-company</field>
        <field name="model_id" ref="model_tally_connection"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_tally_voucher_company" model="ir.rule">
        <field name="name">Tally voucher: multi-company</field>
        <field name="model_id" ref="model_tally_voucher"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_tally_mapping_company" model="ir.rule">
        <field name="name">Tally mapping: multi-company</field>
        <field name="model_id" ref="model_tally_mapping"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_tally_request_company" model="ir.rule">
        <field name="name">Tally request: multi-company</field>
        <field name="model_id" ref="model_tally_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
