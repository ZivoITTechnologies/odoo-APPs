<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_tally_sync" model="ir.cron">
            <field name="name">Tally: two-way sync cycle</field>
            <field name="model_id" ref="model_tally_connection"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>

    <record id="action_server_move_push" model="ir.actions.server">
        <field name="name">Push to Tally</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="group_ids" eval="[(4, ref('group_tally_user'))]"/>
        <field name="state">code</field>
        <field name="code">records.action_tally_push()</field>
    </record>
    <record id="action_server_partner_push" model="ir.actions.server">
        <field name="name">Push to Tally</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="group_ids" eval="[(4, ref('group_tally_user'))]"/>
        <field name="state">code</field>
        <field name="code">records.action_tally_push()</field>
    </record>
    <record id="action_server_product_push" model="ir.actions.server">
        <field name="name">Push to Tally</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="group_ids" eval="[(4, ref('group_tally_user'))]"/>
        <field name="state">code</field>
        <field name="code">records.action_tally_push()</field>
    </record>
</odoo>
