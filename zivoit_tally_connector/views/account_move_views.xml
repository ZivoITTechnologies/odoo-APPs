<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_tally" model="ir.ui.view">
        <field name="name">account.move.form.tally</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_tally_push" type="object" string="Push to Tally"
                        groups="zivoit_tally_connector.group_tally_user"
                        invisible="state != 'posted' or tally_state in ('synced', 'imported', 'queued')"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0" role="status"
                     invisible="tally_state not in ('error', 'held', 'deleted')"
                     groups="zivoit_tally_connector.group_tally_user">
                    <strong>Tally: </strong><field name="tally_error" readonly="1"/>
                </div>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Tally" name="tally" groups="zivoit_tally_connector.group_tally_user"
                      invisible="not tally_state">
                    <group>
                        <group>
                            <field name="tally_state" readonly="1"/>
                            <field name="tally_connection_id" readonly="1"/>
                            <field name="tally_number" readonly="1"/>
                            <field name="tally_risk_score" readonly="1"/>
                        </group>
                        <group>
                            <field name="tally_last_sync" readonly="1"/>
                            <field name="tally_master_id" readonly="1"/>
                            <field name="tally_guid" readonly="1" groups="base.group_no_one"/>
                            <field name="tally_voucher_id" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_invoice_list_tally" model="ir.ui.view">
        <field name="name">account.move.list.tally</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="tally_state" optional="show" widget="badge"
                       decoration-success="tally_state in ('synced', 'imported')"
                       decoration-danger="tally_state in ('error', 'held', 'deleted')"
                       decoration-info="tally_state == 'queued'"
                       groups="zivoit_tally_connector.group_tally_user"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_search_tally" model="ir.ui.view">
        <field name="name">account.move.search.tally</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='draft']" position="before">
                <filter name="tally_error" string="Tally errors" domain="[('tally_state', 'in', ('error', 'held'))]"/>
                <filter name="tally_not_synced" string="Not in Tally"
                        domain="[('state', '=', 'posted'), ('tally_state', '=', False)]"/>
                <separator/>
            </xpath>
        </field>
    </record>
</odoo>
