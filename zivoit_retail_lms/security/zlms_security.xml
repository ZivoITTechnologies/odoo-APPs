<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_zlms" model="ir.module.category">
        <field name="name">Retail LMS</field>
        <field name="sequence">40</field>
    </record>

    <record id="res_groups_privilege_zlms" model="res.groups.privilege">
        <field name="name">Retail LMS</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_zlms"/>
    </record>

    <record id="group_zlms_store_manager" model="res.groups">
        <field name="name">Store Manager</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_zlms"/>
        <field name="comment">Sees and coaches the team of the stores they manage, signs off on-the-job tasks.</field>
    </record>

    <record id="group_zlms_manager" model="res.groups">
        <field name="name">L&amp;D Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_zlms"/>
        <field name="implied_ids" eval="[(4, ref('group_zlms_store_manager')), (4, ref('website_slides.group_website_slides_officer'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Full control of the retail learning network.</field>
    </record>

    <!-- Store managers / area managers: own stores only -->
    <record id="rule_zlms_store_manager_store" model="ir.rule">
        <field name="name">Retail LMS: store manager sees own stores</field>
        <field name="model_id" ref="model_zlms_store"/>
        <field name="domain_force">['|', ('manager_user_id', '=', user.id), ('area_manager_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_zlms_store_manager'))]"/>
    </record>
    <record id="rule_zlms_store_manager_learner" model="ir.rule">
        <field name="name">Retail LMS: store manager sees own team</field>
        <field name="model_id" ref="model_zlms_learner"/>
        <field name="domain_force">['|', '|', ('store_id.manager_user_id', '=', user.id), ('store_id.area_manager_user_id', '=', user.id), ('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_zlms_store_manager'))]"/>
    </record>
    <record id="rule_zlms_store_manager_assignment" model="ir.rule">
