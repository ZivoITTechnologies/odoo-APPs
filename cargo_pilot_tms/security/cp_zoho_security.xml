<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_cp_zoho_account_company" model="ir.rule">
        <field name="name">Zoho connections: own companies</field>
        <field name="model_id" ref="model_cp_zoho_account"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_cp_zoho_sync_company" model="ir.rule">
        <field name="name">Zoho jobs: own companies</field>
        <field name="model_id" ref="model_cp_zoho_sync"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
