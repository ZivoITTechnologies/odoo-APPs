<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_cargo_pilot" model="ir.module.category">
        <field name="name">Cargo Pilot TMS</field>
        <field name="description">Transport management for shippers and transporters.</field>
        <field name="sequence">40</field>
    </record>

    <record id="res_groups_privilege_cargo_pilot" model="res.groups.privilege">
        <field name="name">Cargo Pilot TMS</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="module_category_cargo_pilot"/>
    </record>

    <record id="group_cp_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_cargo_pilot"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('fleet.fleet_group_user'))]"/>
        <field name="comment">Planners, dispatchers, booking clerks and yard staff.</field>
    </record>

    <record id="group_cp_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_cargo_pilot"/>
        <field name="implied_ids" eval="[(4, ref('group_cp_user')), (4, ref('fleet.fleet_group_manager')), (4, ref('account.group_account_invoice'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Approves contracts, awards auctions, approves freight bills and invoices.</field>
    </record>

    <!-- Multi-company -->
    <record id="rule_cp_indent_company" model="ir.rule">
        <field name="name">Indent: multi-company</field>
        <field name="model_id" ref="model_cp_indent"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_cp_trip_company" model="ir.rule">
        <field name="name">Trip: multi-company</field>
        <field name="model_id" ref="model_cp_trip"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_cp_auction_company" model="ir.rule">
        <field name="name">Auction: multi-company</field>
        <field name="model_id" ref="model_cp_auction"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_cp_rfq_company" model="ir.rule">
        <field name="name">RFQ: multi-company</field>
        <field name="model_id" ref="model_cp_rfq"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_cp_contract_company" model="ir.rule">
        <field name="name">Rate contract: multi-company</field>
        <field name="model_id" ref="model_cp_rate_contract"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_cp_bill_company" model="ir.rule">
        <field name="name">Freight bill: multi-company</field>
        <field name="model_id" ref="model_cp_freight_bill"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_cp_consignment_company" model="ir.rule">
        <field name="name">Consignment: multi-company</field>
        <field name="model_id" ref="model_cp_consignment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_cp_challan_company" model="ir.rule">
        <field name="name">Challan: multi-company</field>
        <field name="model_id" ref="model_cp_challan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_cp_hire_company" model="ir.rule">
        <field name="name">Hire slip: multi-company</field>
        <field name="model_id" ref="model_cp_hire_slip"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_cp_gate_company" model="ir.rule">
        <field name="name">Gate entry: multi-company</field>
        <field name="model_id" ref="model_cp_gate_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_cp_fuel_company" model="ir.rule">
        <field name="name">Fuel log: multi-company</field>
        <field name="model_id" ref="model_cp_fuel_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_cp_exception_company" model="ir.rule">
        <field name="name">Issue: multi-company</field>
        <field name="model_id" ref="model_cp_exception"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_cp_trip_order_company" model="ir.rule">
        <field name="name">Shipment orders: own companies</field>
        <field name="model_id" ref="model_cp_trip_order"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_cp_trip_offer_company" model="ir.rule">
        <field name="name">Booking offers: own companies</field>
        <field name="model_id" ref="model_cp_trip_offer"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_cp_capacity_plan_company" model="ir.rule">
        <field name="name">Capacity plans: own companies</field>
        <field name="model_id" ref="model_cp_capacity_plan"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_cp_webhook_company" model="ir.rule">
        <field name="name">Webhooks: own companies</field>
        <field name="model_id" ref="model_cp_webhook"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
