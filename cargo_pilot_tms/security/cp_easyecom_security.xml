<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_cp_easyecom_account_company" model="ir.rule">
        <field name="name">EasyEcom connections: own companies</field>
        <field name="model_id" ref="model_cp_easyecom_account"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_cp_channel_order_company" model="ir.rule">
        <field name="name">Channel orders: own companies</field>
        <field name="model_id" ref="model_cp_channel_order"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_cp_channel_stock_company" model="ir.rule">
        <field name="name">Channel stock: own companies</field>
        <field name="model_id" ref="model_cp_channel_stock"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_cp_easyecom_log_company" model="ir.rule">
        <field name="name">EasyEcom log: own companies</field>
        <field name="model_id" ref="model_cp_easyecom_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
