<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_carrier_form_cp_courier" model="ir.ui.view">
        <field name="name">delivery.carrier.form.cp.courier</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='pricing']" position="before">
                <page string="Courier" name="cp_courier" invisible="delivery_type != 'cp_courier'">
                    <group>
                        <group>
                            <field name="cp_account_id" required="delivery_type == 'cp_courier'" options="{'no_create': True}"/>
                            <field name="cp_provider"/>
                            <field name="cp_choice" widget="radio"/>
                        </group>
                        <group>
                            <field name="cp_cod_policy"/>
                            <field name="cp_default_weight"/>
                            <field name="cp_default_dims"/>
                        </group>
                    </group>
                    <p class="text-muted small">Prices come from the courier's price API or, if it has none, from the rate card on the courier account. Validating a delivery order books the AWB and attaches the label.</p>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_picking_form_cp_courier" model="ir.ui.view">
        <field name="name">stock.picking.form.cp.courier</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_cp_view_parcels" type="object" class="oe_stat_button" icon="fa-cube"
                        invisible="not cp_parcel_count">
                    <field name="cp_parcel_count" widget="statinfo" string="Courier Parcel"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="view_cp_parcel_form_delivery" model="ir.ui.view">
        <field name="name">cp.parcel.form.delivery</field>
        <field name="model">cp.parcel</field>
        <field name="inherit_id" ref="cargo_pilot_tms.view_cp_parcel_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='consignment_id']" position="before">
                <field name="sale_order_id" invisible="not sale_order_id"/>
                <field name="picking_id" invisible="not picking_id"/>
            </xpath>
        </field>
    </record>
</odoo>
