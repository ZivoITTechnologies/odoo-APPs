<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cp_challan_list" model="ir.ui.view">
        <field name="name">cp.challan.list</field>
        <field name="model">cp.challan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="from_hub_id"/>
                <field name="to_hub_id"/>
                <field name="vehicle_number"/>
                <field name="total_packages"/>
                <field name="total_weight_kg"/>
                <field name="is_last_mile" optional="show"/>
                <field name="state" widget="badge" decoration-warning="state == 'dispatched'" decoration-success="state == 'received'"/>
            </list>
        </field>
    </record>

    <record id="view_cp_challan_form" model="ir.ui.view">
        <field name="name">cp.challan.form</field>
        <field name="model">cp.challan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_load_pending" string="Add Waiting Consignments" type="object"
                            invisible="state != 'draft'"/>
                    <button name="action_dispatch" string="Dispatch" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_receive" string="Receive at Hub" type="object" class="btn-primary"
                            invisible="state != 'dispatched'"/>
                    <button name="%(action_cp_report_challan)d" string="Print Challan" type="action"
                            invisible="state == 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('received', 'cancel')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,dispatched,received"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="from_hub_id" readonly="state != 'draft'"/>
                            <field name="to_hub_id" readonly="state != 'draft'"/>
                            <field name="is_last_mile" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="trip_id"/>
                            <field name="vehicle_number"/>
                            <field name="total_packages"/>
                            <field name="total_weight_kg"/>
                            <field name="total_freight"/>
                            <field name="received_time" invisible="not received_time"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="consignment_ids" readonly="state != 'draft'">
                        <list>
                            <field name="name"/>
                            <field name="consignee_id"/>
                            <field name="to_location_id"/>
                            <field name="total_packages" sum="Packages"/>
                            <field name="actual_weight_kg" sum="Weight"/>
                            <field name="payment_type"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_cp_challan" model="ir.actions.act_window">
        <field name="name">Hub Transfers</field>
        <field name="res_model">cp.challan</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a loading challan</p>
            <p>Group PTL consignments onto one vehicle between hubs. Receiving the challan moves the goods into the destination hub's stock.</p>
        </field>
    </record>
</odoo>
