<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vehicle form extension -->
    <record id="view_fleet_vehicle_form_cp" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.cargo.pilot</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_cp_trips" type="object" class="oe_stat_button" icon="fa-road"
                        groups="cargo_pilot_tms.group_cp_user">
                    <field name="cp_trip_count" widget="statinfo" string="TMS Trips"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Transport Ops" name="cp_ops" groups="cargo_pilot_tms.group_cp_user">
                    <group>
                        <group string="Tracking">
                            <field name="cp_vehicle_type_id"/>
                            <field name="cp_device_id"/>
                            <field name="cp_current_trip_id"/>
                        </group>
                        <group string="Fuel">
                            <field name="cp_mileage_benchmark"/>
                            <field name="cp_avg_mileage"/>
                            <field name="cp_fuel_anomaly_count" decoration-danger="cp_fuel_anomaly_count &gt; 0"/>
                        </group>
                    </group>
                    <separator string="Documents"/>
                    <field name="cp_document_ids" context="{'default_vehicle_id': id}">
                        <list editable="bottom" decoration-danger="status == 'expired'" decoration-warning="status == 'expiring'">
                            <field name="doc_type"/>
                            <field name="name"/>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="days_left"/>
                            <field name="status" widget="badge"/>
                            <field name="attachment" filename="attachment_name" optional="show"/>
                            <field name="attachment_name" column_invisible="1"/>
                        </list>
                    </field>
                    <separator string="Preventive Maintenance"/>
                    <field name="cp_maintenance_plan_ids" context="{'default_vehicle_id': id}">
                        <list editable="bottom" decoration-danger="due_state == 'overdue'" decoration-warning="due_state == 'soon'">
                            <field name="name"/>
                            <field name="service_type_id" optional="hide"/>
                            <field name="interval_km"/>
                            <field name="interval_days"/>
                            <field name="last_done_date"/>
                            <field name="last_done_odometer"/>
                            <field name="next_due_date"/>
                            <field name="next_due_odometer"/>
                            <field name="due_state" widget="badge"/>
                            <button name="action_mark_done" type="object" string="Done" icon="fa-check"/>
                        </list>
                    </field>
                    <separator string="Tyres"/>
                    <field name="cp_tyre_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="position"/>
                            <field name="brand"/>
                            <field name="km_run"/>
                            <field name="wear_pct" widget="progressbar"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Fuel -->
    <record id="view_cp_fuel_log_list" model="ir.ui.view">
        <field name="name">cp.fuel.log.list</field>
        <field name="model">cp.fuel.log</field>
        <field name="arch" type="xml">
            <list editable="top" decoration-danger="is_anomaly">
                <field name="date"/>
                <field name="vehicle_id"/>
                <field name="driver_id" optional="show"/>
                <field name="trip_id" optional="hide"/>
                <field name="odometer"/>
                <field name="litres" sum="Litres"/>
                <field name="price_per_litre" optional="show"/>
                <field name="amount" sum="Amount"/>
                <field name="full_tank"/>
                <field name="station" optional="show"/>
                <field name="payment_mode" optional="hide"/>
                <field name="mileage_kmpl"/>
                <field name="is_anomaly"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_cp_fuel_log_search" model="ir.ui.view">
        <field name="name">cp.fuel.log.search</field>
        <field name="model">cp.fuel.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="station"/>
                <filter name="anomalies" string="Anomalies" domain="[('is_anomaly', '=', True)]"/>
                <filter name="date" string="Date" date="date"/>
                <group>
                    <filter name="group_vehicle" string="Vehicle" context="{'group_by': 'vehicle_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_cp_fuel_log_graph" model="ir.ui.view">
        <field name="name">cp.fuel.log.graph</field>
        <field name="model">cp.fuel.log</field>
        <field name="arch" type="xml">
            <graph string="Fuel Spend" type="line">
                <field name="date" interval="week"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_cp_fuel_log" model="ir.actions.act_window">
        <field name="name">Fuel Logs</field>
        <field name="res_model">cp.fuel.log</field>
        <field name="view_mode">list,graph,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Log fuel fills</p>
            <p>Mileage is measured between full-tank fills. Fills well below the vehicle benchmark are flagged for review.</p>
        </field>
    </record>

    <!-- Maintenance -->
    <record id="view_cp_maintenance_plan_list" model="ir.ui.view">
        <field name="name">cp.maintenance.plan.list</field>
        <field name="model">cp.maintenance.plan</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-danger="due_state == 'overdue'" decoration-warning="due_state == 'soon'">
                <field name="vehicle_id"/>
                <field name="name"/>
                <field name="interval_km"/>
                <field name="interval_days"/>
                <field name="last_done_date"/>
                <field name="current_odometer"/>
                <field name="next_due_date"/>
                <field name="next_due_odometer"/>
                <field name="due_state" widget="badge"/>
                <button name="action_mark_done" type="object" string="Mark Done" icon="fa-check"/>
            </list>
        </field>
    </record>

    <record id="action_cp_maintenance_plan" model="ir.actions.act_window">
        <field name="name">Preventive Maintenance</field>
        <field name="res_model">cp.maintenance.plan</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set service intervals</p>
            <p>Plans fall due by kilometres or days. Marking one done logs a service on the vehicle.</p>
        </field>
    </record>

    <!-- Tyres -->
    <record id="view_cp_tyre_list" model="ir.ui.view">
        <field name="name">cp.tyre.list</field>
        <field name="model">cp.tyre</field>
        <field name="arch" type="xml">
            <list decoration-danger="wear_pct &gt;= 90" decoration-muted="state == 'scrapped'">
                <field name="name"/>
                <field name="brand"/>
                <field name="size" optional="show"/>
                <field name="vehicle_id"/>
                <field name="position"/>
                <field name="km_run"/>
                <field name="wear_pct" widget="progressbar"/>
                <field name="cost_per_km" optional="show"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_cp_tyre_form" model="ir.ui.view">
        <field name="name">cp.tyre.form</field>
        <field name="model">cp.tyre</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_fit" string="Fit to Vehicle" type="object" class="btn-primary" invisible="state != 'stock'"/>
                    <button name="action_remove" string="Remove" type="object" invisible="state != 'fitted'"/>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Serial number"/></h1></div>
                    <group>
                        <group>
                            <field name="brand"/>
                            <field name="size"/>
                            <field name="purchase_date"/>
                            <field name="cost"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="vehicle_id"/>
                            <field name="position"/>
                            <field name="fitted_date"/>
                            <field name="fitted_odometer"/>
                        </group>
                        <group string="Life">
                            <field name="expected_life_km"/>
                            <field name="previous_km"/>
                            <field name="km_run"/>
                            <field name="wear_pct" widget="progressbar"/>
                            <field name="cost_per_km"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cp_tyre" model="ir.actions.act_window">
        <field name="name">Tyres</field>
        <field name="res_model">cp.tyre</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Documents -->
    <record id="view_cp_document_list" model="ir.ui.view">
        <field name="name">cp.document.list</field>
        <field name="model">cp.document</field>
        <field name="arch" type="xml">
            <list editable="top" decoration-danger="status == 'expired'" decoration-warning="status == 'expiring'">
                <field name="doc_type"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="name"/>
                <field name="expiry_date"/>
                <field name="days_left"/>
                <field name="status" widget="badge"/>
                <field name="attachment" filename="attachment_name" optional="show"/>
                <field name="attachment_name" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_cp_document_search" model="ir.ui.view">
        <field name="name">cp.document.search</field>
        <field name="model">cp.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="name"/>
                <filter name="expiring_30" string="Expiring in 30 Days"
                        domain="[('expiry_date', '&lt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <filter name="expired" string="Expired"
                        domain="[('expiry_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_type" string="Type" context="{'group_by': 'doc_type'}"/>
                    <filter name="group_vehicle" string="Vehicle" context="{'group_by': 'vehicle_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cp_document" model="ir.actions.act_window">
        <field name="name">Compliance Documents</field>
        <field name="res_model">cp.document</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_expiring_30': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Track RC, insurance, permits, fitness and licenses</p>
            <p>You get an activity before each document expires.</p>
        </field>
    </record>

    <!-- Driving events -->
    <record id="view_cp_driving_event_list" model="ir.ui.view">
        <field name="name">cp.driving.event.list</field>
        <field name="model">cp.driving.event</field>
        <field name="arch" type="xml">
            <list editable="top" decoration-danger="severity == 'high'">
                <field name="event_time"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="event_type"/>
                <field name="severity"/>
                <field name="speed" optional="show"/>
                <field name="penalty" optional="show"/>
                <field name="video_url" widget="url" optional="show"/>
                <field name="coached"/>
            </list>
        </field>
    </record>

    <record id="view_cp_driving_event_search" model="ir.ui.view">
        <field name="name">cp.driving.event.search</field>
        <field name="model">cp.driving.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="driver_id"/>
                <field name="vehicle_id"/>
                <filter name="to_coach" string="To Coach" domain="[('coached', '=', False), ('severity', '!=', 'low')]"/>
                <group>
                    <filter name="group_driver" string="Driver" context="{'group_by': 'driver_id'}"/>
                    <filter name="group_type" string="Event" context="{'group_by': 'event_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_cp_driving_event_pivot" model="ir.ui.view">
        <field name="name">cp.driving.event.pivot</field>
        <field name="model">cp.driving.event</field>
        <field name="arch" type="xml">
            <pivot string="Safety Events">
                <field name="driver_id" type="row"/>
                <field name="event_type" type="col"/>
                <field name="penalty" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_cp_driving_event" model="ir.actions.act_window">
        <field name="name">Safety Events</field>
        <field name="res_model">cp.driving.event</field>
        <field name="view_mode">list,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No safety events</p>
            <p>Telematics devices and dashcams post overspeeding, harsh braking and distraction events through the API. Each driver gets a safety score.</p>
        </field>
    </record>
</odoo>
