<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cp_auction_award_wizard_form" model="ir.ui.view">
        <field name="name">cp.auction.award.wizard.form</field>
        <field name="model">cp.auction.award.wizard</field>
        <field name="arch" type="xml">
            <form string="Award Auction">
                <p class="text-muted">
                    Suggested allocation fills the cheapest bids first. Adjust the vehicles per transporter if needed.
                </p>
                <group>
                    <group>
                        <field name="auction_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="vehicle_count" string="Vehicles Required"/>
                        <field name="allocated" decoration-danger="allocated &gt; vehicle_count"/>
                    </group>
                </group>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="bid_id"/>
                        <field name="transporter_id"/>
                        <field name="rate"/>
                        <field name="offered"/>
                        <field name="vehicle_count"/>
                        <field name="currency_id" column_invisible="1"/>
                    </list>
                </field>
                <footer>
                    <button name="action_award" string="Award &amp; Create Trips" type="object" class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
