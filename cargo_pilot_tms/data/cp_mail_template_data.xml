<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_cp_auction_invite" model="mail.template">
            <field name="name">Cargo Pilot: Auction Invitation</field>
            <field name="model_id" ref="model_cp_auction"/>
            <field name="subject">Load available: {{ object.lane_id.name }} ({{ object.vehicle_count }} x {{ object.vehicle_type_id.name }}) - {{ object.name }}</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="description">Sent to invited transporters when a spot auction is published</field>
            <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; font-size: 14px; color: #1f2a33;">
    <p>Hello,</p>
    <p><strong t-out="object.company_id.name or ''">Company</strong> has a new load open for bidding.</p>
    <table style="border-collapse: collapse; margin: 12px 0;">
        <tr><td style="padding: 4px 12px 4px 0; color: #55606b;">Auction</td><td t-out="object.name or ''">AUC/0001</td></tr>
        <tr><td style="padding: 4px 12px 4px 0; color: #55606b;">Lane</td><td t-out="object.lane_id.name or ''">Lane</td></tr>
        <tr><td style="padding: 4px 12px 4px 0; color: #55606b;">Vehicles</td><td><t t-out="object.vehicle_count"/> x <t t-out="object.vehicle_type_id.name or ''"/></td></tr>
        <tr><td style="padding: 4px 12px 4px 0; color: #55606b;">Placement</td><td t-out="format_datetime(object.required_date) or ''">Date</td></tr>
        <tr><td style="padding: 4px 12px 4px 0; color: #55606b;">Bidding closes</td><td t-out="format_datetime(object.date_end) or ''">Date</td></tr>
    </table>
    <p>
        <a t-att-href="object.get_base_url() + '/my/cp/auctions/' + str(object.id)"
           style="background: #2E7D6B; color: #ffffff; padding: 10px 18px; text-decoration: none; border-radius: 6px;">Place your bid</a>
    </p>
    <p style="color: #55606b; font-size: 12px;">Sign in to your transporter portal to bid. Late bids extend the auction automatically.</p>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
