<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_cp_fastag" model="ir.cron">
        <field name="name">Cargo Pilot: FASTag toll crossings</field>
        <field name="model_id" ref="model_cp_ulip_account"/>
        <field name="state">code</field>
        <field name="code">model._cron_fastag()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
    </record>
    <record id="cron_cp_sim" model="ir.cron">
        <field name="name">Cargo Pilot: SIM tracking</field>
        <field name="model_id" ref="model_cp_sim_provider"/>
        <field name="state">code</field>
        <field name="code">model._cron_sim()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
    </record>
    <record id="cron_cp_ewb_extend" model="ir.cron">
        <field name="name">Cargo Pilot: extend e-way bills before expiry</field>
        <field name="model_id" ref="model_cp_gsp_account"/>
        <field name="state">code</field>
        <field name="code">model._cron_extend()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
    </record>
    <record id="cron_cp_pod_reminder" model="ir.cron">
        <field name="name">Cargo Pilot: POD reminders</field>
        <field name="model_id" ref="cargo_pilot_tms.model_cp_trip"/>
        <field name="state">code</field>
        <field name="code">model._cron_pod_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
