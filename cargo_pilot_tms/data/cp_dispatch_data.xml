<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_cp_dispatch_plan" model="ir.sequence">
            <field name="name">Dispatch Plan</field>
            <field name="code">cp.dispatch.plan</field>
            <field name="prefix">DSP/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_cp_dispatch_awb" model="ir.sequence">
            <field name="name">Dispatch Booking Reference</field>
            <field name="code">cp.dispatch.awb</field>
            <field name="prefix">BK%(y)s</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_cp_detention_record" model="ir.sequence">
            <field name="name">Detention Claim</field>
            <field name="code">cp.detention.record</field>
            <field name="prefix">DET/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_cp_dispatch_pod" model="ir.sequence">
            <field name="name">Proof of Delivery</field>
            <field name="code">cp.dispatch.pod</field>
            <field name="prefix">POD/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="product_cp_detention" model="product.product">
            <field name="name">Detention / Halting Charges</field>
            <field name="type">service</field>
            <field name="default_code">CP-DETENTION</field>
            <field name="sale_ok" eval="False"/>
            <field name="purchase_ok" eval="True"/>
            <field name="purchase_method">purchase</field>
        </record>

        <!-- Regular logistics partners named by the client -->
        <record id="partner_carrier_dhl" model="res.partner">
            <field name="name">DHL Express India</field>
            <field name="is_company" eval="True"/>
            <field name="cp_regular_carrier" eval="True"/>
            <field name="cp_carrier_sequence">10</field>
            <field name="website">https://www.dhl.com/in-en</field>
            <field name="cp_tracking_url_template">https://www.dhl.com/in-en/home/tracking/tracking-express.html?submit=1&amp;tracking-id={ref}</field>
        </record>
        <record id="partner_carrier_delhivery" model="res.partner">
            <field name="name">Delhivery</field>
            <field name="is_company" eval="True"/>
            <field name="cp_regular_carrier" eval="True"/>
            <field name="cp_carrier_sequence">20</field>
            <field name="website">https://www.delhivery.com</field>
            <field name="cp_tracking_url_template">https://www.delhivery.com/track-v2/package/{ref}</field>
        </record>
        <record id="partner_carrier_fedex" model="res.partner">
            <field name="name">FedEx India</field>
            <field name="is_company" eval="True"/>
            <field name="cp_regular_carrier" eval="True"/>
            <field name="cp_carrier_sequence">30</field>
            <field name="website">https://www.fedex.com/en-in</field>
            <field name="cp_tracking_url_template">https://www.fedex.com/fedextrack/?trknbr={ref}</field>
        </record>

        <record id="cron_cp_dispatch_followups" model="ir.cron">
            <field name="name">Cargo Pilot Dispatch: reporting, delays and POD follow-up</field>
            <field name="model_id" ref="model_cp_dispatch_plan"/>
            <field name="state">code</field>
            <field name="code">model._cron_followups()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
        </record>
    </data>
    <function model="product.product" name="write"
              eval="[[ref('cargo_pilot_tms.product_cp_freight')], {'purchase_ok': True, 'purchase_method': 'purchase'}]"/>
</odoo>
