<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="zlms_learning_path_list" model="ir.ui.view">
        <field name="name">zlms.learning.path.list</field>
        <field name="model">zlms.learning.path</field>
        <field name="arch" type="xml">
            <list string="Learning Paths">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="path_type"/>
                <field name="role_ids" widget="many2many_tags"/>
                <field name="duration_days"/>
                <field name="auto_assign"/>
                <field name="line_count" string="Steps"/>
                <field name="assignment_count"/>
                <field name="completion_rate" widget="progressbar"/>
                <field name="state" widget="badge" decoration-success="state == 'published'" decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="zlms_learning_path_kanban" model="ir.ui.view">
        <field name="name">zlms.learning.path.kanban</field>
        <field name="model">zlms.learning.path</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="color"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="name" class="fw-bold fs-5"/>
                            <field name="state" widget="badge" decoration-success="state == 'published'"/>
                        </div>
                        <field name="path_type" class="text-muted"/>
                        <field name="role_ids" widget="many2many_tags"/>
                        <div class="mt-2"><field name="completion_rate" widget="progressbar"/></div>
                        <div class="d-flex justify-content-between small mt-1">
                            <span><i title="List Ol" class="fa fa-list-ol"/> <field name="line_count"/> steps</span>
                            <span><i title="Users" class="fa fa-users"/> <field name="assignment_count"/> assigned</span>
                            <span><i title="Calendar" class="fa fa-calendar"/> <field name="duration_days"/> days</span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="zlms_learning_path_form" model="ir.ui.view">
        <field name="name">zlms.learning.path.form</field>
        <field name="model">zlms.learning.path</field>
        <field name="arch" type="xml">
            <form string="Learning Path">
                <header>
                    <button name="action_publish" type="object" string="Publish" class="btn-primary"
                            invisible="state == 'published'"/>
                    <button name="action_open_assign_wizard" type="object" string="Assign" icon="fa-user-plus"
                            invisible="state != 'published'"/>
                    <button name="action_retire" type="object" string="Retire" invisible="state != 'published'"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,published"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_assignments" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="assignment_count" widget="statinfo" string="Assigned"/>
                        </button>
                    </div>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_1920'}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. 30-Day Store Associate Onboarding"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="path_type"/>
                            <field name="role_ids" widget="many2many_tags"/>
                            <field name="store_format"/>
                            <field name="skill_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="auto_assign"/>
                            <field name="duration_days"/>
                            <field name="pass_score"/>
                            <field name="issue_certificate"/>
                            <field name="certificate_validity_months" invisible="not issue_certificate"/>
                            <field name="completion_points"/>
                            <field name="completion_rate" widget="progressbar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Journey Steps" name="steps">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="day_offset" string="Day"/>
                                    <field name="line_type"/>
                                    <field name="name"/>
                                    <field name="channel_id" required="line_type == 'course'" readonly="line_type != 'course'"/>
                                    <field name="survey_id" required="line_type == 'certification'" readonly="line_type != 'certification'" optional="show"/>
                                    <field name="scenario_id" required="line_type == 'roleplay'" readonly="line_type != 'roleplay'" optional="show"/>
                                    <field name="instructions" optional="hide"/>
                                    <field name="min_score" optional="show"/>
                                    <field name="mandatory"/>
                                    <field name="weight" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Why this journey matters and what the learner will be able to do..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="zlms_learning_path_search" model="ir.ui.view">
        <field name="name">zlms.learning.path.search</field>
        <field name="model">zlms.learning.path</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="role_ids"/>
                <filter name="published" string="Published" domain="[('state', '=', 'published')]"/>
                <filter name="auto" string="Auto-assigned" domain="[('auto_assign', '=', True)]"/>
                <group>
                    <filter name="group_type" string="Type" context="{'group_by': 'path_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="zlms_learning_path_action" model="ir.actions.act_window">
        <field name="name">Learning Paths</field>
        <field name="res_model">zlms.learning.path</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Design your first learning journey</p>
            <p>Combine eLearning courses, certification exams, AI role-plays and on-the-job tasks signed off by store managers.</p>
        </field>
    </record>
</odoo>
