<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="zlms_ai_insight_list" model="ir.ui.view">
        <field name="name">zlms.ai.insight.list</field>
        <field name="model">zlms.ai.insight</field>
        <field name="arch" type="xml">
            <list string="AI Insights" create="false">
                <field name="create_date"/>
                <field name="name"/>
                <field name="scope"/>
                <field name="learner_id" optional="show"/>
                <field name="store_id" optional="show"/>
                <field name="engine"/>
            </list>
        </field>
    </record>
    <record id="zlms_ai_insight_form" model="ir.ui.view">
        <field name="name">zlms.ai.insight.form</field>
        <field name="model">zlms.ai.insight</field>
        <field name="arch" type="xml">
            <form string="AI Insight" create="false">
                <header>
                    <button name="action_assign_recommended" type="object" string="Assign Recommended Paths"
                            class="btn-primary" invisible="not recommended_path_ids or scope == 'network'"
                            groups="zivoit_retail_lms.group_zlms_manager"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="scope" readonly="1"/>
                            <field name="learner_id" readonly="1" invisible="not learner_id"/>
                            <field name="store_id" readonly="1" invisible="not store_id"/>
                        </group>
                        <group>
                            <field name="engine"/>
                            <field name="create_date"/>
                            <field name="recommended_path_ids" widget="many2many_tags" readonly="1"/>
                        </group>
                    </group>
                    <field name="content_html" nolabel="1"/>
                    <notebook>
                        <page string="Data analysed" name="snapshot" groups="zivoit_retail_lms.group_zlms_manager">
                            <field name="snapshot" widget="code" options="{'mode': 'javascript'}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="zlms_ai_insight_action" model="ir.actions.act_window">
        <field name="name">AI Insights</field>
        <field name="res_model">zlms.ai.insight</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="zlms_ai_network_insight_action" model="ir.actions.server">
        <field name="name">AI L&amp;D Advisor (Network)</field>
        <field name="model_id" ref="model_zlms_dashboard"/>
        <field name="state">code</field>
        <field name="code">action = model.action_network_insight()</field>
    </record>

    <record id="zlms_ai_log_list" model="ir.ui.view">
        <field name="name">zlms.ai.log.list</field>
        <field name="model">zlms.ai.log</field>
        <field name="arch" type="xml">
            <list string="AI Usage" create="false" edit="false">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="feature"/>
                <field name="provider"/>
                <field name="model_name"/>
                <field name="duration"/>
                <field name="success" widget="boolean"/>
                <field name="prompt_excerpt" optional="hide"/>
                <field name="response_excerpt" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="zlms_ai_log_action" model="ir.actions.act_window">
        <field name="name">AI Usage Log</field>
        <field name="res_model">zlms.ai.log</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
