<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="zlms_certificate_list" model="ir.ui.view">
        <field name="name">zlms.certificate.list</field>
        <field name="model">zlms.certificate</field>
        <field name="arch" type="xml">
            <list string="Certificates" create="false">
                <field name="name"/>
                <field name="learner_id"/>
                <field name="store_id"/>
                <field name="path_id"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
                <field name="score"/>
                <field name="state" widget="badge" decoration-success="state == 'valid'"
                       decoration-warning="state == 'expiring'" decoration-danger="state in ('expired', 'revoked')"/>
            </list>
        </field>
    </record>

    <record id="zlms_certificate_form" model="ir.ui.view">
        <field name="name">zlms.certificate.form</field>
        <field name="model">zlms.certificate</field>
        <field name="arch" type="xml">
            <form string="Certificate" create="false">
                <header>
                    <button name="action_print" type="object" string="Print" class="btn-primary" icon="fa-print"/>
                    <button name="action_revoke" type="object" string="Revoke" invisible="state == 'revoked'"
                            groups="zivoit_retail_lms.group_zlms_manager"
                            confirm="Revoke this certificate?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="learner_id"/>
                            <field name="store_id"/>
                            <field name="role_id"/>
                            <field name="path_id"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="score"/>
                            <field name="assignment_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="zlms_certificate_search" model="ir.ui.view">
        <field name="name">zlms.certificate.search</field>
        <field name="model">zlms.certificate</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="learner_id"/>
                <field name="path_id"/>
                <field name="store_id"/>
                <filter name="valid" string="Valid" domain="[('state', 'in', ('valid', 'expiring'))]"/>
                <filter name="expiring" string="Expiring Soon" domain="[('state', '=', 'expiring')]"/>
                <filter name="expired" string="Expired" domain="[('state', '=', 'expired')]"/>
                <group>
                    <filter name="group_path" string="Path" context="{'group_by': 'path_id'}"/>
                    <filter name="group_store" string="Store" context="{'group_by': 'store_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="zlms_certificate_action" model="ir.actions.act_window">
        <field name="name">Certificates</field>
        <field name="res_model">zlms.certificate</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
