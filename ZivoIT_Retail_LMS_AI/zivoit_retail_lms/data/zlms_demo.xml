<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Store manager demo user -->
    <record id="base.user_demo" model="res.users">
        <field name="group_ids" eval="[(4, ref('zivoit_retail_lms.group_zlms_store_manager'))]"/>
    </record>

    <!-- Regions -->
    <record id="demo_region_south" model="zlms.region"><field name="name">South Zone</field><field name="code">S</field><field name="sequence">1</field></record>
    <record id="demo_region_west" model="zlms.region"><field name="name">West Zone</field><field name="code">W</field><field name="sequence">2</field></record>
    <record id="demo_region_east" model="zlms.region"><field name="name">East Zone</field><field name="code">E</field><field name="sequence">3</field></record>
    <record id="demo_region_north" model="zlms.region"><field name="name">North Zone</field><field name="code">N</field><field name="sequence">4</field></record>

    <!-- Stores (fictional) -->
