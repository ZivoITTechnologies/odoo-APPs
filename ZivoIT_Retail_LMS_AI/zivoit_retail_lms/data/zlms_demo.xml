        <field name="region_id" ref="demo_region_south"/><field name="city">Lakeside</field><field name="mall_name">Lakeside Mall</field>
        <field name="manager_user_id" ref="base.user_demo"/><field name="area_sqft">2100</field>
    </record>
    <record id="demo_store_blr" model="zlms.store">
        <field name="name">Tech Park High Street</field><field name="code">ST-003</field>
        <field name="region_id" ref="demo_region_south"/><field name="city">Tech Park</field><field name="area_sqft">2400</field>
