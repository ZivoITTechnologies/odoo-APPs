<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_slip">
        <t t-foreach="docs" t-as="o">
            <t t-call="web.basic_layout">
                <t t-set="company" t-value="res_company"/>
                <div class="page bpcl-rpt bpcl-slip">
                    <div class="text-center">
                        <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="height:48px;" alt="Logo"/>
                        <div class="bpcl-rpt-outlet" style="font-size:14px;" t-out="company.pump_outlet_name or company.name"/>
                        <div class="bpcl-rpt-sub">CREDIT FILLING SLIP</div>
                    </div>
                    <div class="bpcl-rpt-band"/>
                    <table class="bpcl-slip-table">
                        <tr><td>Slip Ref</td><td><b t-out="o.name"/></td></tr>
                        <tr t-if="o.slip_no"><td>Book Slip</td><td t-out="o.slip_no"/></tr>
                        <tr><td>Date</td><td t-out="o.date.strftime('%d-%m-%Y')"/></tr>
                        <tr t-if="o.shift_id"><td>Shift</td><td t-out="o.shift_id.name"/></tr>
                        <tr><td>Customer</td><td><b t-out="o.partner_id.name"/> (<t t-out="o.partner_id.pump_code"/>)</td></tr>
                        <tr><td>Vehicle</td><td t-out="o.vehicle_no or '-'"/></tr>
                        <tr><td>Product</td><td t-out="o.product_id.name"/></tr>
                        <tr><td>Quantity</td><td><t t-out="'{:,.2f}'.format(o.qty)"/> <t t-out="o.product_id.uom"/></td></tr>
                        <tr><td>Rate</td><td t-out="'{:,.2f}'.format(o.rate - o.discount)"/></tr>
                        <tr class="bpcl-slip-amt"><td>Amount</td><td t-out="'%s {:,.2f}'.format(o.amount) % (o.currency_id.symbol or '')"/></tr>
                        <tr t-if="o.employee_id"><td>Filled by</td><td t-out="o.employee_id.name"/></tr>
                        <tr t-if="o.note"><td>Comment</td><td t-out="o.note"/></tr>
                    </table>
                    <div style="margin-top:28px;">
                        <span>Driver's Signature</span><span style="float:right;">Cashier</span>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
