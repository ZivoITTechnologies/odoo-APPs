<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ledger_wizard" model="ir.ui.view">
        <field name="name">pump.ledger.wizard.form</field>
        <field name="model">pump.ledger.wizard</field>
        <field name="arch" type="xml">
            <form string="Customer Ledger / Statement">
                <group>
                    <field name="partner_id" options="{'no_create': True}"/>
                    <label for="date_from" string="Period"/>
                    <div class="o_row">
                        <field name="date_from"/> <span>to</span> <field name="date_to"/>
                    </div>
                </group>
                <footer>
                    <button name="action_pdf" type="object" string="PDF Statement" class="btn-primary" icon="fa-file-pdf-o"/>
                    <button name="action_excel" type="object" string="Excel" class="btn-secondary" icon="fa-file-excel-o"/>
                    <button name="action_view" type="object" string="View Entries" class="btn-secondary"/>
                    <button special="cancel" string="Close"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_ledger_wizard" model="ir.actions.act_window">
        <field name="name">Customer Ledger / Statement</field>
        <field name="res_model">pump.ledger.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_quick_voucher_wizard" model="ir.ui.view">
        <field name="name">pump.quick.voucher.wizard.form</field>
        <field name="model">pump.quick.voucher.wizard</field>
        <field name="arch" type="xml">
            <form string="Quick Voucher">
                <group>
                    <group>
                        <field name="voucher_type" widget="radio"/>
                        <field name="date"/>
                        <field name="shift_id"/>
                        <field name="partner_id" invisible="voucher_type == 'contra'"
                               required="voucher_type == 'receipt'"
                               context="{'default_is_pump_customer': voucher_type == 'receipt'}"/>
                        <field name="partner_currency_id" invisible="1"/>
                        <field name="partner_balance" invisible="voucher_type != 'receipt' or not partner_id"/>
                        <field name="contra_direction" invisible="voucher_type != 'contra'" widget="radio"/>
                        <field name="settle_account_id" invisible="voucher_type != 'contra' or contra_direction != 'settle'"
                               required="voucher_type == 'contra' and contra_direction == 'settle'"/>
                        <field name="charges" invisible="voucher_type != 'contra' or contra_direction != 'settle'"/>
                    </group>
                    <group>
                        <field name="amount" class="fs-4"/>
                        <field name="via" widget="radio" invisible="voucher_type == 'contra'"/>
                        <field name="payment_mode" invisible="voucher_type == 'contra'"/>
                        <field name="cheque_no" invisible="payment_mode in ('cash', False)"/>
                        <field name="account_id" invisible="voucher_type != 'payment'"
                               required="voucher_type == 'payment' and not partner_id"/>
                        <field name="narration"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Save &amp; Post" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_quick_receipt" model="ir.actions.act_window">
        <field name="name">Quick Receipt</field>
        <field name="res_model">pump.quick.voucher.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_voucher_type': 'receipt'}</field>
    </record>
    <record id="action_quick_payment" model="ir.actions.act_window">
        <field name="name">Quick Payment / Expense</field>
        <field name="res_model">pump.quick.voucher.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_voucher_type': 'payment', 'default_via': 'cash', 'default_payment_mode': 'cash'}</field>
    </record>
    <record id="action_quick_contra" model="ir.actions.act_window">
        <field name="name">Bank Deposit / Withdrawal</field>
        <field name="res_model">pump.quick.voucher.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_voucher_type': 'contra'}</field>
    </record>

    <record id="view_bill_generate_wizard" model="ir.ui.view">
        <field name="name">pump.bill.generate.wizard.form</field>
        <field name="model">pump.bill.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Period Bills">
                <group>
                    <group>
                        <label for="date_from" string="Billing Period"/>
                        <div class="o_row"><field name="date_from"/> <span>to</span> <field name="date_to"/></div>
                        <field name="bill_date"/>
                        <field name="post"/>
                    </group>
                    <group>
                        <field name="preview_count"/>
                        <field name="preview_amount"/>
                    </group>
                </group>
                <field name="partner_ids" widget="many2many_tags" placeholder="All customers with unbilled slips"/>
                <footer>
                    <button name="action_generate" type="object" string="Generate Bills" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_bill_generate_wizard" model="ir.actions.act_window">
        <field name="name">Generate Bills</field>
        <field name="res_model">pump.bill.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_trial_balance_wizard" model="ir.ui.view">
        <field name="name">pump.trial.balance.wizard.form</field>
        <field name="model">pump.trial.balance.wizard</field>
        <field name="arch" type="xml">
            <form string="Trial Balance">
                <group>
                    <label for="date_from" string="Period"/>
                    <div class="o_row"><field name="date_from"/> <span>to</span> <field name="date_to"/></div>
                </group>
                <footer>
                    <button name="action_pdf" type="object" string="Print PDF" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_trial_balance_wizard" model="ir.actions.act_window">
        <field name="name">Trial Balance</field>
        <field name="res_model">pump.trial.balance.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_portal_access_wizard" model="ir.ui.view">
        <field name="name">pump.portal.access.wizard.form</field>
        <field name="model">pump.portal.access.wizard</field>
        <field name="arch" type="xml">
            <form string="Customer Portal Login">
                <div class="alert alert-info" role="status">
                    The customer signs in at <b>/web/login</b> and lands on the fuel portal
                    (balance, ledger, statements, bills, slips and indents).
                </div>
                <group>
                    <field name="partner_id" readonly="1"/>
                    <field name="existing_user_id" invisible="not existing_user_id"/>
                    <field name="login"/>
                    <field name="password" password="True"/>
                </group>
                <footer>
                    <button name="action_grant" type="object" string="Create / Update Login" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_opening_wizard" model="ir.ui.view">
        <field name="name">pump.opening.wizard.form</field>
        <field name="model">pump.opening.wizard</field>
        <field name="arch" type="xml">
            <form string="Opening Balance">
                <group>
                    <field name="partner_id" readonly="1"/>
                    <field name="date"/>
                    <field name="amount"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Post" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_rate_update_wizard" model="ir.ui.view">
        <field name="name">pump.rate.update.wizard.form</field>
        <field name="model">pump.rate.update.wizard</field>
        <field name="arch" type="xml">
            <form string="Daily Rate Update">
                <group><field name="date"/></group>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="product_id" readonly="1" force_save="1"/>
                        <field name="old_rate" force_save="1"/>
                        <field name="new_rate"/>
                    </list>
                </field>
                <footer>
                    <button name="action_apply" type="object" string="Apply Rates" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_rate_update_wizard" model="ir.actions.act_window">
        <field name="name">Update Today's Rates</field>
        <field name="res_model">pump.rate.update.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
