<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===== Vehicle (Odoo Fleet) extension ===== -->
    <record id="fleet_vehicle_form_pump" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.pump</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_pump_trips" type="object" class="oe_stat_button" icon="fa-road" invisible="not is_pump_fleet">
                    <field name="pump_trip_count" widget="statinfo" string="Trips"/>
                </button>
                <button name="action_pump_jobs" type="object" class="oe_stat_button" icon="fa-wrench" invisible="not is_pump_fleet">
                    <field name="pump_job_count" widget="statinfo" string="Job Cards"/>
                </button>
            </div>
            <notebook position="inside">
                <page string="Fuel Station" name="pump_fleet">
                    <group>
                        <group string="Role">
                            <field name="is_pump_fleet"/>
                            <field name="pump_role" invisible="not is_pump_fleet"/>
                            <field name="pump_driver_emp_id" invisible="not is_pump_fleet"/>
                            <field name="pump_status" widget="badge" invisible="not is_pump_fleet"
                                   decoration-success="pump_status == 'available'" decoration-info="pump_status == 'on_trip'"
                                   decoration-warning="pump_status == 'maintenance'"/>
                        </group>
                        <group string="Performance" invisible="not is_pump_fleet">
                            <field name="pump_capacity"/>
                            <field name="pump_avg_kmpl"/>
                            <field name="pump_month_cost"/>
                            <field name="pump_doc_alert" widget="badge" decoration-success="pump_doc_alert == 'ok'"
                                   decoration-warning="pump_doc_alert == 'expiring'" decoration-danger="pump_doc_alert == 'expired'"/>
                        </group>
                    </group>
                    <div invisible="not is_pump_fleet">
                        <h5 class="mt-3">Compartments</h5>
                        <field name="pump_compartment_ids">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="name"/><field name="capacity" sum="Total"/><field name="product_id"/>
                            </list>
                        </field>
                        <h5 class="mt-3">Statutory Documents</h5>
                        <field name="pump_document_ids">
                            <list editable="bottom" decoration-danger="state == 'expired'" decoration-warning="state == 'expiring'">
                                <field name="doc_type"/><field name="number"/><field name="issue_date"/><field name="expiry_date"/>
                                <field name="days_left"/>
                                <field name="state" widget="badge" decoration-success="state == 'valid'"
                                       decoration-warning="state == 'expiring'" decoration-danger="state == 'expired'"/>
                                <field name="attachment" filename="attachment_name" widget="binary" optional="show"/>
                                <field name="attachment_name" column_invisible="1"/>
                            </list>
                        </field>
                        <h5 class="mt-3">Preventive Maintenance Plan</h5>
                        <field name="pump_schedule_ids">
                            <list editable="bottom" decoration-danger="due_state == 'overdue'" decoration-warning="due_state == 'due'">
                                <field name="service_type_id"/><field name="interval_km"/><field name="interval_days"/>
                                <field name="last_done_date"/><field name="last_done_km"/>
                                <field name="next_due_date"/><field name="next_due_km"/>
                                <field name="due_state" widget="badge" decoration-success="due_state == 'ok'"
                                       decoration-warning="due_state == 'due'" decoration-danger="due_state == 'overdue'"/>
                            </list>
                        </field>
                    </div>
                </page>
            </notebook>
        </field>
    </record>

    <record id="fleet_vehicle_pump_list" model="ir.ui.view">
        <field name="name">fleet.vehicle.pump.list</field>
        <field name="model">fleet.vehicle</field>
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <list>
                <field name="license_plate"/>
                <field name="model_id"/>
                <field name="pump_role"/>
                <field name="pump_capacity"/>
                <field name="pump_driver_emp_id"/>
                <field name="odometer"/>
                <field name="pump_avg_kmpl"/>
                <field name="pump_month_cost" sum="Cost"/>
                <field name="pump_status" widget="badge" decoration-success="pump_status == 'available'"
                       decoration-info="pump_status == 'on_trip'" decoration-warning="pump_status == 'maintenance'"/>
                <field name="pump_doc_alert" widget="badge" decoration-success="pump_doc_alert == 'ok'"
                       decoration-warning="pump_doc_alert == 'expiring'" decoration-danger="pump_doc_alert == 'expired'"/>
            </list>
        </field>
    </record>

    <record id="action_pump_fleet" model="ir.actions.act_window">
        <field name="name">Tankers &amp; Station Fleet</field>
        <field name="res_model">fleet.vehicle</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('is_pump_fleet', '=', True)]</field>
        <field name="context">{'default_is_pump_fleet': True}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('fleet_vehicle_pump_list')}),
            (0, 0, {'view_mode': 'kanban'}), (0, 0, {'view_mode': 'form'})]"/>
    </record>

    <!-- ===== Documents ===== -->
    <record id="view_vehicle_document_list" model="ir.ui.view">
        <field name="name">pump.vehicle.document.list</field>
        <field name="model">pump.vehicle.document</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'expired'" decoration-warning="state == 'expiring'">
                <field name="vehicle_id"/><field name="doc_type"/><field name="number"/>
                <field name="issue_date"/><field name="expiry_date"/><field name="days_left"/>
                <field name="state" widget="badge" decoration-success="state == 'valid'"
                       decoration-warning="state == 'expiring'" decoration-danger="state == 'expired'"/>
                <button name="action_renew" type="object" string="Renew" icon="fa-refresh"/>
            </list>
        </field>
    </record>
    <record id="view_vehicle_document_form" model="ir.ui.view">
        <field name="name">pump.vehicle.document.form</field>
        <field name="model">pump.vehicle.document</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group><field name="vehicle_id"/><field name="doc_type"/><field name="number"/></group>
                        <group><field name="issue_date"/><field name="expiry_date"/><field name="remind_days"/><field name="state"/></group>
                    </group>
                    <field name="attachment" filename="attachment_name"/><field name="attachment_name" invisible="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_vehicle_document" model="ir.actions.act_window">
        <field name="name">Fleet Documents</field>
        <field name="res_model">pump.vehicle.document</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ===== Fuel logs ===== -->
    <record id="view_fleet_fuel_log_list" model="ir.ui.view">
        <field name="name">pump.fleet.fuel.log.list</field>
        <field name="model">pump.fleet.fuel.log</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'" decoration-muted="state == 'cancel'">
                <field name="date"/><field name="name"/><field name="vehicle_id"/><field name="source"/><field name="tank_id"/>
                <field name="qty" sum="Litres"/><field name="rate"/><field name="amount" sum="Cost"/>
                <field name="odometer"/><field name="distance" sum="Km"/><field name="kmpl"/>
                <field name="state" widget="badge" decoration-success="state == 'posted'"/>
            </list>
        </field>
    </record>
    <record id="view_fleet_fuel_log_form" model="ir.ui.view">
        <field name="name">pump.fleet.fuel.log.form</field>
        <field name="model">pump.fleet.fuel.log</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_post" type="object" string="Post" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state != 'posted'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="vehicle_id" readonly="state != 'draft'"/>
                            <field name="driver_id"/>
                            <field name="source" readonly="state != 'draft'"/>
                            <field name="tank_id" invisible="source != 'station'" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="qty" readonly="state != 'draft'"/>
                            <field name="rate" readonly="state != 'draft'"/>
                            <field name="amount"/>
                            <field name="odometer" readonly="state != 'draft'"/>
                            <field name="distance"/>
                            <field name="kmpl"/>
                            <field name="voucher_id" invisible="not voucher_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_fleet_fuel_log" model="ir.actions.act_window">
        <field name="name">Fleet Fuel Logs</field>
        <field name="res_model">pump.fleet.fuel.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ===== Trips ===== -->
    <record id="view_tanker_trip_list" model="ir.ui.view">
        <field name="name">pump.tanker.trip.list</field>
        <field name="model">pump.tanker.trip</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'in_transit'" decoration-muted="state in ('closed', 'cancel')">
                <field name="date"/><field name="name"/><field name="trip_type"/><field name="vehicle_id"/>
                <field name="driver_id"/><field name="destination"/><field name="partner_id" optional="show"/>
                <field name="product_id"/><field name="qty"/><field name="delivered_qty"/>
                <field name="distance" sum="Km"/><field name="expense_total" sum="Expenses"/>
                <field name="state" widget="badge" decoration-info="state == 'in_transit'" decoration-success="state == 'closed'"
                       decoration-warning="state == 'delivered'"/>
            </list>
        </field>
    </record>
    <record id="view_tanker_trip_kanban" model="ir.ui.view">
        <field name="name">pump.tanker.trip.kanban</field>
        <field name="model">pump.tanker.trip</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" group_create="0" quick_create="0">
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between"><field name="name" class="fw-bold"/><field name="trip_type" class="badge text-bg-light"/></div>
                        <div><i class="fa fa-truck" title="Vehicle"/> <field name="vehicle_id"/> · <field name="driver_id"/></div>
                        <div class="text-muted small"><field name="origin"/> → <field name="destination"/></div>
                        <div class="small"><field name="product_id"/>: <field name="qty"/> L</div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="view_tanker_trip_form" model="ir.ui.view">
        <field name="name">pump.tanker.trip.form</field>
        <field name="model">pump.tanker.trip</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Dispatch" class="btn-primary" invisible="state != 'planned'"/>
                    <button name="action_deliver" type="object" string="Mark Delivered / Unloaded" class="btn-primary" invisible="state != 'in_transit'"/>
                    <button name="action_close" type="object" string="Close Trip" class="btn-primary" invisible="state != 'delivered'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('planned', 'in_transit')"/>
                    <field name="state" widget="statusbar" statusbar_visible="planned,in_transit,delivered,closed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group string="Trip">
                            <field name="trip_type" widget="radio" readonly="state != 'planned'"/>
                            <field name="date" readonly="state != 'planned'"/>
                            <field name="vehicle_id" readonly="state != 'planned'"/>
                            <field name="driver_id"/>
                            <field name="origin"/>
                            <field name="destination"/>
                        </group>
                        <group string="Load">
                            <field name="product_id" readonly="state != 'planned'"/>
                            <field name="qty" readonly="state != 'planned'"/>
                            <field name="delivered_qty" readonly="state not in ('planned', 'in_transit')"/>
                            <field name="odometer_start"/>
                            <field name="odometer_end"/>
                            <field name="distance"/>
                        </group>
                    </group>
                    <group invisible="trip_type != 'depot'" string="Depot Loading">
                        <group>
                            <field name="invoice_no"/>
                            <field name="load_rate"/>
                        </group>
                        <group>
                            <field name="dest_tank_id"/>
                            <field name="purchase_id"/>
                        </group>
                    </group>
                    <group invisible="trip_type != 'delivery'" string="Doorstep Delivery">
                        <group>
                            <field name="partner_id" readonly="state != 'planned'"/>
                            <field name="customer_vehicle_id"/>
                        </group>
                        <group>
                            <field name="source_tank_id" readonly="state != 'planned'"/>
                            <field name="sale_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Trip Expenses" name="expenses">
                            <field name="expense_ids" readonly="state in ('closed', 'cancel')">
                                <list editable="bottom">
                                    <field name="expense_type"/><field name="description"/><field name="amount" sum="Total"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="expense_total"/>
                                <field name="cost_per_km"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_tanker_trip" model="ir.actions.act_window">
        <field name="name">Tanker &amp; Delivery Trips</field>
        <field name="res_model">pump.tanker.trip</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <!-- ===== Maintenance ===== -->
    <record id="view_maint_schedule_list" model="ir.ui.view">
        <field name="name">pump.maintenance.schedule.list</field>
        <field name="model">pump.maintenance.schedule</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-danger="due_state == 'overdue'" decoration-warning="due_state == 'due'">
                <field name="vehicle_id"/><field name="service_type_id"/><field name="interval_km"/><field name="interval_days"/>
                <field name="last_done_date"/><field name="last_done_km"/><field name="next_due_date"/><field name="next_due_km"/>
                <field name="km_left"/>
                <field name="due_state" widget="badge" decoration-success="due_state == 'ok'"
                       decoration-warning="due_state == 'due'" decoration-danger="due_state == 'overdue'"/>
                <button name="action_create_job" type="object" string="Job Card" icon="fa-wrench"/>
            </list>
        </field>
    </record>
    <record id="action_maint_schedule" model="ir.actions.act_window">
        <field name="name">Maintenance Plan</field>
        <field name="res_model">pump.maintenance.schedule</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_maint_order_list" model="ir.ui.view">
        <field name="name">pump.maintenance.order.list</field>
        <field name="model">pump.maintenance.order</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'in_progress'" decoration-muted="state == 'cancel'">
                <field name="date"/><field name="name"/><field name="vehicle_id"/><field name="maintenance_type"/>
                <field name="service_type_id"/><field name="vendor_id"/><field name="downtime_hours" sum="Hours"/>
                <field name="amount_total" sum="Total"/>
                <field name="state" widget="badge" decoration-info="state == 'in_progress'" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>
    <record id="view_maint_order_form" model="ir.ui.view">
        <field name="name">pump.maintenance.order.form</field>
        <field name="model">pump.maintenance.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Send to Workshop" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" type="object" string="Complete &amp; Post Cost" class="btn-primary" invisible="state not in ('draft', 'in_progress')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state == 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="vehicle_id" readonly="state == 'done'"/>
                            <field name="maintenance_type"/>
                            <field name="schedule_id"/>
                            <field name="service_type_id"/>
                            <field name="date"/>
                            <field name="odometer"/>
                        </group>
                        <group>
                            <field name="vendor_id"/>
                            <field name="vendor_ref"/>
                            <field name="paid_from"/>
                            <field name="downtime_start"/>
                            <field name="downtime_end"/>
                            <field name="downtime_hours"/>
                            <field name="service_log_id" invisible="not service_log_id"/>
                            <field name="voucher_id" invisible="not voucher_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="complaint"/>
                        <field name="work_done"/>
                    </group>
                    <field name="line_ids" readonly="state == 'done'">
                        <list editable="bottom">
                            <field name="line_type"/><field name="name"/><field name="qty"/><field name="unit_price"/>
                            <field name="subtotal" sum="Total"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer"><field name="amount_total"/></group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_maint_order" model="ir.actions.act_window">
        <field name="name">Maintenance Job Cards</field>
        <field name="res_model">pump.maintenance.order</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ===== AI conversation log ===== -->
    <record id="view_ai_log_list" model="ir.ui.view">
        <field name="name">pump.ai.log.list</field>
        <field name="model">pump.ai.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="create_date"/><field name="mode"/><field name="partner_id"/><field name="intent"/>
                <field name="source" widget="badge"/><field name="question"/><field name="answer"/>
            </list>
        </field>
    </record>
    <record id="action_ai_log" model="ir.actions.act_window">
        <field name="name">AI Conversations</field>
        <field name="res_model">pump.ai.log</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
