<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pump_shift_list" model="ir.ui.view">
        <field name="name">pump.shift.list</field>
        <field name="model">pump.shift</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time" widget="float_time"/>
            </list>
        </field>
    </record>
    <record id="action_pump_shift" model="ir.actions.act_window">
        <field name="name">Shifts</field>
        <field name="res_model">pump.shift</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_shift_sheet_list" model="ir.ui.view">
        <field name="name">pump.shift.sheet.list</field>
        <field name="model">pump.shift.sheet</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'" decoration-muted="state == 'cancel'">
                <field name="date"/>
                <field name="shift_id"/>
                <field name="name"/>
                <field name="manager_id" optional="show"/>
                <field name="total_qty" sum="Litres"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="total_amount" sum="Sale"/>
                <field name="credit_amount" sum="Credit" optional="show"/>
                <field name="card_amount" sum="Card" optional="show"/>
                <field name="upi_amount" sum="UPI" optional="show"/>
                <field name="expected_cash" sum="Cash" optional="show"/>
                <field name="short_excess" sum="Short/Excess" decoration-danger="short_excess &lt; 0"/>
                <field name="state" widget="badge" decoration-success="state == 'posted'"/>
            </list>
        </field>
    </record>

    <record id="view_shift_sheet_form" model="ir.ui.view">
        <field name="name">pump.shift.sheet.form</field>
        <field name="model">pump.shift.sheet</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_load_nozzles" type="object" string="Load Nozzles" invisible="state != 'draft'"/>
                    <button name="action_post" type="object" string="Post Shift" class="btn-primary" invisible="state != 'draft'"
                            confirm="Post this shift? Meter readings, stock and cash will be booked."/>
                    <button name="action_print" type="object" string="Print DSR" invisible="state != 'posted'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state != 'posted'"
                            groups="zivoit_fuel_management.group_pump_manager"/>
                    <button name="action_draft" type="object" string="Reset to Draft" invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="shift_id" readonly="state != 'draft'"/>
                            <field name="manager_id"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="total_qty"/>
                            <field name="total_amount" class="fw-bold"/>
                            <field name="voucher_id" invisible="not voucher_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Nozzle Readings" name="readings">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="nozzle_id"/>
                                    <field name="product_id"/>
                                    <field name="employee_id"/>
                                    <field name="opening"/>
                                    <field name="closing"/>
                                    <field name="testing_qty"/>
                                    <field name="gross_qty" optional="hide"/>
                                    <field name="sale_qty" sum="Litres"/>
                                    <field name="rate"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="amount" sum="Amount"/>
                                </list>
                            </field>
                        </page>
                        <page string="Collections" name="collections">
                            <group>
                                <group string="Non-cash">
                                    <field name="credit_amount"/>
                                    <field name="card_amount" readonly="state != 'draft'"/>
                                    <field name="upi_amount" readonly="state != 'draft'"/>
                                    <field name="fleet_card_amount" readonly="state != 'draft'"/>
                                </group>
                                <group string="Cash">
                                    <field name="expected_cash" class="fw-bold"/>
                                    <field name="cash_collected" readonly="state != 'draft'"/>
                                    <field name="short_excess" decoration-danger="short_excess &lt; 0" decoration-success="short_excess &gt; 0"/>
                                    <button name="action_recompute" type="object" string="Refresh credit slips" class="btn-link" invisible="state != 'draft'" colspan="2"/>
                                </group>
                            </group>
                            <field name="note" placeholder="Remarks..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_shift_sheet_search" model="ir.ui.view">
        <field name="name">pump.shift.sheet.search</field>
        <field name="model">pump.shift.sheet</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="shift_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="posted" string="Posted" domain="[('state', '=', 'posted')]"/>
                <filter name="date" string="Date" date="date"/>
                <group>
                    <filter name="g_day" string="Day" context="{'group_by': 'date:day'}"/>
                    <filter name="g_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_shift_sheet" model="ir.actions.act_window">
        <field name="name">Shift Sheets (Nozzle Readings)</field>
        <field name="res_model">pump.shift.sheet</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Start a shift sheet</p>
            <p>Nozzles are loaded automatically with their last closing reading. Enter closing meters, testing and collections, then post.</p></field>
    </record>

    <!-- Sales analysis on nozzle readings -->
    <record id="view_sheet_line_pivot" model="ir.ui.view">
        <field name="name">pump.shift.sheet.line.pivot</field>
        <field name="model">pump.shift.sheet.line</field>
        <field name="arch" type="xml">
            <pivot string="Fuel Sales">
                <field name="date" interval="day" type="row"/>
                <field name="product_id" type="col"/>
                <field name="sale_qty" type="measure"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_sheet_line_graph" model="ir.ui.view">
        <field name="name">pump.shift.sheet.line.graph</field>
        <field name="model">pump.shift.sheet.line</field>
        <field name="arch" type="xml">
            <graph string="Fuel Sales" type="bar" stacked="1">
                <field name="date" interval="day"/>
                <field name="product_id"/>
                <field name="sale_qty" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_sheet_line_list" model="ir.ui.view">
        <field name="name">pump.shift.sheet.line.list</field>
        <field name="model">pump.shift.sheet.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="date"/><field name="sheet_id"/><field name="nozzle_id"/><field name="product_id"/>
                <field name="employee_id"/><field name="opening"/><field name="closing"/><field name="testing_qty"/>
                <field name="sale_qty" sum="Litres"/><field name="rate"/>
                <field name="currency_id" column_invisible="1"/><field name="amount" sum="Amount"/>
            </list>
        </field>
    </record>
    <record id="view_sheet_line_search" model="ir.ui.view">
        <field name="name">pump.shift.sheet.line.search</field>
        <field name="model">pump.shift.sheet.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="nozzle_id"/>
                <field name="product_id"/>
                <field name="employee_id"/>
                <filter name="posted" string="Posted" domain="[('state', '=', 'posted')]"/>
                <filter name="date" string="Date" date="date"/>
                <group>
                    <filter name="g_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="g_nozzle" string="Nozzle" context="{'group_by': 'nozzle_id'}"/>
                    <filter name="g_emp" string="Attendant" context="{'group_by': 'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_sales_analysis" model="ir.actions.act_window">
        <field name="name">Fuel Sales Analysis</field>
        <field name="res_model">pump.shift.sheet.line</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="context">{'search_default_posted': 1}</field>
    </record>
</odoo>
