<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_pump_form" model="ir.ui.view">
        <field name="name">res.company.pump.form</field>
        <field name="model">res.company</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <form string="Station Settings">
                <sheet>
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <field name="logo" widget="image" class="oe_avatar" options="{'size': [90, 90]}"/>
                        <div>
                            <h1 class="mb-0"><field name="name"/></h1>
                            <div class="text-muted">Fuel station profile used on bills, statements and the customer portal</div>
                        </div>
                    </div>
                    <group>
                        <group string="Outlet">
                            <field name="pump_outlet_name" placeholder="e.g. Sri Venkateswara Filling Station"/>
                            <field name="pump_dealer_code"/>
                            <field name="street"/>
                            <field name="city"/>
                            <field name="state_id"/>
                            <field name="zip"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="vat" string="GSTIN"/>
                            <field name="currency_id"/>
                        </group>
                        <group string="Billing">
                            <field name="pump_fy_start_month"/>
                            <field name="pump_billing_days"/>
                            <field name="pump_bank_name"/>
                            <field name="pump_bank_account"/>
                            <field name="pump_bank_ifsc"/>
                            <field name="pump_bank_branch"/>
                            <field name="pump_upi_id"/>
                        </group>
                    </group>
                    <group string="AI Assistant">
                        <group>
                            <field name="pump_ai_enabled"/>
                            <field name="pump_ai_provider"/>
                        </group>
                        <group invisible="pump_ai_provider == 'builtin'">
                            <field name="pump_ai_api_key" password="True"/>
                            <field name="pump_ai_model" placeholder="claude-haiku-5-5 / gpt-4o-mini"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="status" invisible="pump_ai_provider == 'builtin'">
                        With an external AI engine the assistant sends the asking customer's own account summary
                        (balances, bills, vehicles) to the provider. The built-in engine keeps all data inside Odoo.
                    </div>
                    <group string="Terms printed on bills &amp; statements">
                        <field name="pump_bill_terms" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pump_settings" model="ir.actions.server">
        <field name="name">Station Settings</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="state">code</field>
        <field name="code">action = env['res.company'].action_open_pump_settings()</field>
    </record>
</odoo>
