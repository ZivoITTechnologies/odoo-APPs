<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_pump" model="ir.ui.view">
        <field name="name">hr.employee.form.pump</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Petrol Pump" name="pump" groups="zivoit_fuel_management.group_pump_manager">
                    <group>
                        <group string="Role">
                            <field name="pump_role"/>
                        </group>
                        <group string="Monthly Salary">
                            <field name="pump_basic"/>
                            <field name="pump_da"/>
                            <field name="pump_hra"/>
                            <field name="pump_gross"/>
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <record id="view_pump_staff_list" model="ir.ui.view">
        <field name="name">hr.employee.pump.list</field>
        <field name="model">hr.employee</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="pump_role"/>
                <field name="mobile_phone"/>
                <field name="pump_basic"/>
                <field name="pump_da"/>
                <field name="pump_hra"/>
                <field name="pump_gross"/>
            </list>
        </field>
    </record>
    <record id="action_pump_staff" model="ir.actions.act_window">
        <field name="name">Pump Staff</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('pump_role', '!=', False)]</field>
        <field name="context">{'default_pump_role': 'dsm'}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_pump_staff_list')}),
            (0, 0, {'view_mode': 'kanban'}),
            (0, 0, {'view_mode': 'form'})]"/>
    </record>

    <record id="view_pump_attendance_list" model="ir.ui.view">
        <field name="name">pump.attendance.list</field>
        <field name="model">pump.attendance</field>
        <field name="arch" type="xml">
            <list editable="top" decoration-danger="status == 'absent'" decoration-warning="status == 'half'">
                <field name="date"/>
                <field name="employee_id" domain="[('pump_role', '!=', False)]"/>
                <field name="shift_id"/>
                <field name="status"/>
                <field name="overtime_hours" optional="show"/>
                <field name="note" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_pump_attendance_search" model="ir.ui.view">
        <field name="name">pump.attendance.search</field>
        <field name="model">pump.attendance</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <filter name="today" string="Today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="date" string="Date" date="date"/>
                <group>
                    <filter name="g_emp" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="g_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_pump_attendance_pivot" model="ir.ui.view">
        <field name="name">pump.attendance.pivot</field>
        <field name="model">pump.attendance</field>
        <field name="arch" type="xml">
            <pivot string="Attendance Register">
                <field name="employee_id" type="row"/>
                <field name="status" type="col"/>
            </pivot>
        </field>
    </record>
    <record id="action_pump_attendance" model="ir.actions.act_window">
        <field name="name">Attendance</field>
        <field name="res_model">pump.attendance</field>
        <field name="view_mode">list,pivot</field>
    </record>

    <record id="view_pump_salary_list" model="ir.ui.view">
        <field name="name">pump.salary.sheet.list</field>
        <field name="model">pump.salary.sheet</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="total_net" sum="Total"/>
                <field name="state" widget="badge" decoration-success="state == 'posted'"/>
            </list>
        </field>
    </record>
    <record id="view_pump_salary_form" model="ir.ui.view">
        <field name="name">pump.salary.sheet.form</field>
        <field name="model">pump.salary.sheet</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_compute" type="object" string="Compute from Attendance" invisible="state != 'draft'"/>
                    <button name="action_post" type="object" string="Pay &amp; Post" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state != 'posted'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="month" readonly="state != 'draft'"/>
                            <field name="year" readonly="state != 'draft'" options="{'format': false}"/>
                        </group>
                        <group>
                            <field name="pay_account" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="total_net" class="fw-bold"/>
                            <field name="voucher_id" invisible="not voucher_id"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state != 'draft'">
                        <list editable="bottom">
                            <field name="employee_id"/>
                            <field name="pump_role"/>
                            <field name="month_days"/>
                            <field name="paid_days"/>
                            <field name="monthly_gross"/>
                            <field name="earned" sum="Earned"/>
                            <field name="incentive" sum="Incentive"/>
                            <field name="advance" sum="Advance"/>
                            <field name="net" sum="Net"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_pump_salary" model="ir.actions.act_window">
        <field name="name">Salary Sheets</field>
        <field name="res_model">pump.salary.sheet</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
