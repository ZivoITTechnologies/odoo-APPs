<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="zivoit_fuel_management.Dashboard">
        <div class="o_bpcl_dash o_action">
            <t t-set="d" t-value="state.data"/>
            <!-- Hero -->
            <div class="bpcl-hero">
                <div class="bpcl-hero-brand">
                    <img src="/web/binary/company_logo" alt="Logo"/>
                    <div>
                        <div class="bpcl-hero-title" t-esc="d and d.company"/>
                        <div class="bpcl-hero-sub">
                            Retail Outlet Dashboard
                            <t t-if="d and d.dealer_code"> · Dealer <t t-esc="d.dealer_code"/></t>
                        </div>
                    </div>
                </div>
                <div class="bpcl-hero-date">
                    <button class="btn bpcl-icon-btn" title="Previous day" t-on-click="() => this.shiftDate(-1)"><i class="fa fa-chevron-left"/></button>
                    <div class="bpcl-date-pill">
                        <span class="bpcl-weekday" t-esc="d and d.weekday"/>
                        <input type="date" class="bpcl-date-input" t-att-value="state.date" t-on-change="onDateChange"/>
                    </div>
                    <button class="btn bpcl-icon-btn" title="Next day" t-on-click="() => this.shiftDate(1)"><i class="fa fa-chevron-right"/></button>
                    <button class="btn bpcl-today-btn" t-on-click="goToday">Today</button>
                    <button class="btn bpcl-icon-btn" title="Refresh" t-on-click="reload"><i t-attf-class="fa fa-refresh {{ state.loading ? 'fa-spin' : '' }}"/></button>
                </div>
            </div>

            <div class="bpcl-body" t-if="d">
                <!-- Alerts -->
                <div class="bpcl-alerts" t-if="d.kpi.sheets_draft or d.kpi.pending_indents or d.kpi.over_limit_count">
                    <a t-if="d.kpi.sheets_draft" class="bpcl-alert warn" t-on-click="() => this.openModel('pump.shift.sheet', [['state','=','draft']], 'Draft Shift Sheets')">
                        <i class="fa fa-clock-o"/> <b t-esc="d.kpi.sheets_draft"/> shift sheet(s) waiting to be posted
                    </a>
                    <a t-if="d.kpi.pending_indents" class="bpcl-alert info" t-on-click="() => this.openModel('pump.indent', [['state','in',['requested','approved']]], 'Open Indents')">
                        <i class="fa fa-truck"/> <b t-esc="d.kpi.pending_indents"/> open indent(s) from customers
                    </a>
                    <a t-if="d.kpi.over_limit_count" class="bpcl-alert danger" t-on-click="openOverLimit">
                        <i class="fa fa-exclamation-triangle"/> <b t-esc="d.kpi.over_limit_count"/> customer(s) over credit limit
                    </a>
                </div>

                <!-- KPI tiles -->
                <div class="bpcl-kpis">
                    <div class="bpcl-kpi primary" t-on-click="openTodaySheets">
                        <div class="bpcl-kpi-label"><i class="fa fa-tint"/> Fuel Sale</div>
                        <div class="bpcl-kpi-value" t-esc="money(d.kpi.sale_amount)"/>
                        <div class="bpcl-kpi-foot"><t t-esc="fmt(d.kpi.sale_qty)"/> Ltr · <t t-esc="d.kpi.sheets_posted"/> shift(s)</div>
                    </div>
                    <div class="bpcl-kpi" t-on-click="openTodaySlips">
                        <div class="bpcl-kpi-label"><i class="fa fa-file-text-o"/> Credit Sale</div>
                        <div class="bpcl-kpi-value" t-esc="money(d.kpi.credit_sale)"/>
                        <div class="bpcl-kpi-foot">Receipts today <t t-esc="compact(d.kpi.receipts_today)"/></div>
                    </div>
                    <div class="bpcl-kpi">
                        <div class="bpcl-kpi-label"><i class="fa fa-credit-card"/> Card / UPI / Fleet</div>
                        <div class="bpcl-kpi-value" t-esc="money(d.kpi.card_sale)"/>
                        <div t-attf-class="bpcl-kpi-foot {{ d.kpi.short_excess &lt; 0 ? 'text-danger' : '' }}">Short/Excess <t t-esc="money(d.kpi.short_excess)"/></div>
                    </div>
                    <div class="bpcl-kpi" t-on-click="() => this.openAction('zivoit_fuel_management.action_pump_daybook')">
                        <div class="bpcl-kpi-label"><i class="fa fa-money"/> Cash in Hand</div>
                        <div class="bpcl-kpi-value" t-esc="money(d.kpi.cash_in_hand)"/>
                        <div class="bpcl-kpi-foot">as on <t t-esc="displayDate"/></div>
                    </div>
                    <div class="bpcl-kpi">
                        <div class="bpcl-kpi-label"><i class="fa fa-university"/> Bank Balance</div>
                        <div class="bpcl-kpi-value" t-esc="money(d.kpi.bank_balance)"/>
                        <div class="bpcl-kpi-foot">Current account</div>
                    </div>
                    <div class="bpcl-kpi accent" t-on-click="() => this.openAction('zivoit_fuel_management.action_pump_outstanding')">
                        <div class="bpcl-kpi-label"><i class="fa fa-users"/> Outstanding</div>
                        <div class="bpcl-kpi-value" t-esc="money(d.kpi.outstanding)"/>
                        <div class="bpcl-kpi-foot">+ <t t-esc="compact(d.kpi.unbilled)"/> unbilled · <t t-esc="d.kpi.customer_count"/> customers</div>
                    </div>
                </div>

                <!-- AI command centre -->
                <div class="bpcl-ai">
                    <div class="bpcl-ai-insights">
                        <div class="bpcl-ai-title"><i class="fa fa-magic"/> AI Insights <span>auto-generated from live data</span></div>
                        <div class="bpcl-ai-list">
                            <div t-foreach="d.ai_insights" t-as="i" t-key="i_index" t-attf-class="bpcl-ai-item {{ i.level }}">
                                <i t-attf-class="fa {{ i.icon }}"/>
                                <div><b t-esc="i.title"/><div class="small" t-esc="i.text"/></div>
                            </div>
                            <div t-if="!d.ai_insights.length" class="text-muted p-2">All clear — no risks detected.</div>
                        </div>
                    </div>
                    <div class="bpcl-ai-ask">
                        <div class="bpcl-ai-title"><i class="fa fa-comments"/> Ask AI</div>
                        <form t-on-submit.prevent="askAI" class="bpcl-ai-form">
                            <input type="text" class="form-control" placeholder="e.g. Who is the highest credit risk?" t-model="state.aiQuestion"/>
                            <button class="btn bpcl-today-btn" type="submit"><i t-attf-class="fa {{ state.aiBusy ? 'fa-spinner fa-spin' : 'fa-paper-plane' }}"/></button>
                        </form>
                        <div class="bpcl-ai-chips">
                            <button t-on-click="() => this.quickAsk('Sales this week')">Sales this week</button>
                            <button t-on-click="() => this.quickAsk('Stock days left')">Stock days left</button>
                            <button t-on-click="() => this.quickAsk('Credit risk')">Credit risk</button>
                            <button t-on-click="() => this.quickAsk('Any anomaly or suspicious slips?')">Anomalies</button>
                            <button t-on-click="() => this.quickAsk('Fleet maintenance and document expiry')">Fleet alerts</button>
                        </div>
                        <div class="bpcl-ai-answer" t-if="state.aiAnswer">
                            <t t-foreach="formatAnswer(state.aiAnswer)" t-as="ln" t-key="ln_index"><div t-esc="ln.replaceAll('**', '')"/></t>
                        </div>
                    </div>
                </div>

                <!-- Quick actions -->
                <div class="bpcl-actions">
                    <button class="btn bpcl-act" t-on-click="newSheet"><i class="fa fa-tachometer"/> New Shift Sheet</button>
                    <button class="btn bpcl-act" t-on-click="newSlip"><i class="fa fa-plus-circle"/> Filling Slip</button>
                    <button class="btn bpcl-act" t-on-click="() => this.openAction('zivoit_fuel_management.action_quick_receipt')"><i class="fa fa-inr"/> Receive Payment</button>
                    <button class="btn bpcl-act" t-on-click="() => this.openAction('zivoit_fuel_management.action_quick_payment')"><i class="fa fa-share"/> Expense</button>
                    <button class="btn bpcl-act" t-on-click="() => this.openAction('zivoit_fuel_management.action_bill_generate_wizard')"><i class="fa fa-files-o"/> Generate Bills</button>
                    <button class="btn bpcl-act" t-on-click="() => this.openAction('zivoit_fuel_management.action_ledger_wizard')"><i class="fa fa-book"/> Ledger</button>
                    <button class="btn bpcl-act" t-on-click="() => this.openAction('zivoit_fuel_management.action_rate_update_wizard')"><i class="fa fa-tag"/> Update Rates</button>
                    <button class="btn bpcl-act" t-on-click="() => this.openAction('zivoit_fuel_management.action_pump_purchase')"><i class="fa fa-truck"/> Tanker Receipt</button>
                </div>

                <!-- Products / rates -->
                <div class="bpcl-products">
                    <div t-foreach="d.products" t-as="p" t-key="p.id" class="bpcl-prod" t-attf-style="--prod: {{ p.color }}">
                        <div class="bpcl-prod-name" t-esc="p.name"/>
                        <div class="bpcl-prod-rate"><t t-esc="d.currency"/> <t t-esc="fmt(p.rate)"/><small>/<t t-esc="p.uom"/></small></div>
                        <div class="bpcl-prod-meta" t-if="p.type == 'fuel'">
                            <span>Sold <b t-esc="fmt(p.qty)"/> L</span>
                            <span>Stock <b t-esc="fmt(p.stock, 0)"/> L</span>
                        </div>
                        <div class="bpcl-prod-meta" t-else=""><span>Lubricant</span></div>
                    </div>
                </div>

                <div class="bpcl-grid">
                    <div class="bpcl-card bpcl-span-2">
                        <div class="bpcl-card-head">
                            <h3>Sales — last 14 days</h3>
                            <a t-on-click="() => this.openAction('zivoit_fuel_management.action_sales_analysis')">Analysis <i class="fa fa-arrow-right"/></a>
                        </div>
                        <div class="bpcl-chart-wrap"><canvas t-ref="chart"/></div>
                    </div>
                    <div class="bpcl-card">
                        <div class="bpcl-card-head"><h3>Tank Levels</h3></div>
                        <div class="bpcl-tanks">
                            <div t-foreach="d.tanks" t-as="t" t-key="t.id" class="bpcl-tank" t-on-click="() => this.openTank(t.id)"
                                 t-attf-style="--prod: {{ t.color }}">
                                <div class="bpcl-tank-shell">
                                    <div class="bpcl-tank-fill" t-attf-style="height: {{ Math.min(t.percent, 100) }}%"/>
                                    <div class="bpcl-tank-pct"><span><t t-esc="t.percent"/>%</span></div>
                                </div>
                                <div class="bpcl-tank-name" t-esc="t.name"/>
                                <div class="bpcl-tank-qty"><t t-esc="fmt(t.stock, 0)"/> / <t t-esc="fmt(t.capacity, 0)"/> L</div>
                                <div class="badge text-bg-danger" t-if="t.low">Re-order</div>
                            </div>
                            <div t-if="!d.tanks.length" class="text-muted p-3">No tanks configured.</div>
                        </div>
                    </div>
                </div>

                <div class="bpcl-grid">
                    <div class="bpcl-card bpcl-span-2">
                        <div class="bpcl-card-head">
                            <h3>Fleet &amp; Tankers</h3>
                            <a t-on-click="() => this.openAction('zivoit_fuel_management.action_pump_fleet')">Fleet <i class="fa fa-arrow-right"/></a>
                        </div>
                        <div class="bpcl-fleet-kpis">
                            <div><b t-esc="d.fleet.vehicles"/><span>Vehicles</span></div>
                            <div class="ok"><b t-esc="d.fleet.available"/><span>Available</span></div>
                            <div class="info"><b t-esc="d.fleet.on_trip"/><span>On trip</span></div>
                            <div class="warn"><b t-esc="d.fleet.maintenance"/><span>In workshop</span></div>
                            <div t-attf-class="{{ d.fleet.docs_alert ? 'danger' : '' }}" t-on-click="() => this.openAction('zivoit_fuel_management.action_vehicle_document')"><b t-esc="d.fleet.docs_alert"/><span>Docs to renew</span></div>
                            <div t-attf-class="{{ d.fleet.maint_due ? 'warn' : '' }}" t-on-click="() => this.openAction('zivoit_fuel_management.action_maint_schedule')"><b t-esc="d.fleet.maint_due"/><span>Service due</span></div>
                            <div><b t-esc="compact(d.fleet.month_cost)"/><span>Fleet cost (month)</span></div>
                        </div>
                        <table class="table table-sm bpcl-table mt-2" t-if="d.fleet.trips.length">
                            <thead><tr><th>Trip</th><th>Type</th><th>Vehicle</th><th>Destination</th><th class="text-end">Qty</th><th>Status</th></tr></thead>
                            <tbody>
                                <tr t-foreach="d.fleet.trips" t-as="t" t-key="t.id" t-on-click="() => this.openRecord('pump.tanker.trip', t.id)">
                                    <td t-esc="t.name"/><td t-esc="t.type"/><td t-esc="t.vehicle"/><td t-esc="t.dest"/>
                                    <td class="text-end" t-esc="fmt(t.qty, 0)"/>
                                    <td><span class="badge text-bg-info" t-esc="t.state"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="bpcl-card">
                        <div class="bpcl-card-head"><h3>Stock-out Forecast</h3></div>
                        <div t-foreach="d.forecast" t-as="f" t-key="f.tank" t-attf-class="bpcl-fc {{ f.level }}">
                            <div><b t-esc="f.name"/><div class="small text-muted"><t t-esc="fmt(f.daily, 0)"/> L/day</div></div>
                            <div class="text-end"><b><t t-esc="f.days_left &gt; 99 ? '—' : f.days_left"/> days</b>
                                <div class="small" t-if="f.level != 'ok'">Order <t t-esc="fmt(f.order_qty, 0)"/> L by <t t-esc="f.order_by"/></div></div>
                        </div>
                    </div>
                </div>

                <div class="bpcl-grid">
                    <div class="bpcl-card bpcl-span-2">
                        <div class="bpcl-card-head">
                            <h3>Top Credit Exposure</h3>
                            <a t-on-click="() => this.openAction('zivoit_fuel_management.action_pump_outstanding')">All customers <i class="fa fa-arrow-right"/></a>
                        </div>
                        <table class="table table-sm bpcl-table">
                            <thead><tr><th>Customer</th><th class="text-end">Outstanding</th><th class="text-end">Unbilled</th><th class="text-end">Limit</th><th style="width:30%">Utilisation</th></tr></thead>
                            <tbody>
                                <tr t-foreach="d.top_customers" t-as="c" t-key="c.id" t-on-click="() => this.openCustomer(c.id)">
                                    <td><b t-esc="c.name"/><div class="text-muted small" t-esc="c.code"/></td>
                                    <td class="text-end" t-esc="fmt(c.balance)"/>
                                    <td class="text-end" t-esc="fmt(c.unbilled)"/>
                                    <td class="text-end" t-esc="fmt(c.limit, 0)"/>
                                    <td>
                                        <div class="bpcl-bar"><div t-attf-class="bpcl-bar-fill {{ c.over ? 'over' : (c.used &gt; 80 ? 'warn' : '') }}" t-attf-style="width: {{ Math.min(c.used, 100) }}%"/></div>
                                        <small t-esc="c.used + '%'"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="bpcl-card">
                        <div class="bpcl-card-head">
                            <h3>Recent Filling Slips</h3>
                            <a t-on-click="() => this.openAction('zivoit_fuel_management.action_credit_sale')">All <i class="fa fa-arrow-right"/></a>
                        </div>
                        <div class="bpcl-slips">
                            <div t-foreach="d.recent_slips" t-as="s" t-key="s.id" class="bpcl-slip" t-on-click="() => this.openSlip(s.id)">
                                <div>
                                    <div class="fw-bold text-truncate" t-esc="s.customer"/>
                                    <div class="text-muted small"><t t-esc="s.date"/> · <t t-esc="s.vehicle"/> · <t t-esc="s.product"/></div>
                                </div>
                                <div class="text-end">
                                    <div class="fw-bold" t-esc="fmt(s.amount)"/>
                                    <span t-attf-class="badge {{ s.state == 'billed' ? 'text-bg-success' : (s.state == 'draft' ? 'text-bg-secondary' : 'text-bg-warning') }}" t-esc="s.state"/>
                                </div>
                            </div>
                            <div t-if="!d.recent_slips.length" class="text-muted p-3">No slips yet.</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="bpcl-body text-center p-5" t-else=""><i class="fa fa-spinner fa-spin fa-2x"/></div>
        </div>
    </t>
</templates>
