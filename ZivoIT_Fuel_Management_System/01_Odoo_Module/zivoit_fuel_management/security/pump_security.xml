<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_pump" model="ir.module.category">
        <field name="name">Fuel Management</field>
        <field name="sequence">15</field>
    </record>

    <record id="res_groups_privilege_pump" model="res.groups.privilege">
        <field name="name">Fuel Management</field>
        <field name="sequence">15</field>
        <field name="category_id" ref="module_category_pump"/>
    </record>

    <record id="group_pump_user" model="res.groups">
        <field name="name">Operator / Cashier</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_pump"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('fleet.fleet_group_user'))]"/>
        <field name="comment">Shift sheets, filling slips, receipts and day-to-day entries.</field>
    </record>

    <record id="group_pump_manager" model="res.groups">
        <field name="name">Manager / Owner</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_pump"/>
        <field name="implied_ids" eval="[(4, ref('group_pump_user')), (4, ref('hr.group_hr_user')), (4, ref('fleet.fleet_group_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Masters, rates, credit limits, billing, accounts, payroll and all reports.</field>
    </record>
</odoo>
