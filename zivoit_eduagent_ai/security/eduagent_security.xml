<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_eduagent" model="ir.module.category">
        <field name="name">EduAgent AI</field>
        <field name="sequence">22</field>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_eduagent">
        <field name="name">EduAgent AI</field>
        <field name="sequence">22</field>
        <field name="category_id" ref="module_category_eduagent"/>
    </record>

    <record id="group_eduagent_user" model="res.groups">
        <field name="name">Staff (Mentor / Counsellor)</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_eduagent"/>
        <field name="implied_ids" eval="[(4, ref('website_slides.group_website_slides_officer'))]"/>
    </record>

    <record id="group_eduagent_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_eduagent"/>
        <field name="implied_ids" eval="[(4, ref('group_eduagent_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <data noupdate="1">
        <record id="rule_provider_company" model="ir.rule">
            <field name="name">EduAgent provider: multi-company</field>
            <field name="model_id" ref="model_eduagent_provider"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_conversation_company" model="ir.rule">
            <field name="name">EduAgent conversation: multi-company</field>
            <field name="model_id" ref="model_eduagent_conversation"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_usage_company" model="ir.rule">
            <field name="name">EduAgent usage: multi-company</field>
            <field name="model_id" ref="model_eduagent_usage_log"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
