<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_retention" model="ir.cron">
            <field name="name">EduAgent: Retention Coach (risk scoring, nudges, escalation)</field>
            <field name="model_id" ref="website_slides.model_slide_channel_partner"/>
            <field name="state">code</field>
            <field name="code">model._cron_eduagent_retention()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_fees" model="ir.cron">
            <field name="name">EduAgent: Fee &amp; EMI reminders</field>
            <field name="model_id" ref="model_eduagent_installment"/>
            <field name="state">code</field>
            <field name="code">model._cron_eduagent_fees()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_credentials" model="ir.cron">
            <field name="name">EduAgent: Issue verifiable credentials</field>
            <field name="model_id" ref="model_eduagent_credential"/>
            <field name="state">code</field>
            <field name="code">model._cron_issue_credentials()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_reindex" model="ir.cron">
            <field name="name">EduAgent: Re-index changed course knowledge</field>
            <field name="model_id" ref="website_slides.model_slide_channel"/>
            <field name="state">code</field>
            <field name="code">model._cron_eduagent_reindex()</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
