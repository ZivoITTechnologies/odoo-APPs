<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eduagent_usage_list" model="ir.ui.view">
        <field name="name">eduagent.usage.log.list</field>
        <field name="model">eduagent.usage.log</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" decoration-danger="status == 'error'" decoration-warning="status == 'blocked'">
                <field name="create_date"/>
                <field name="agent_id"/>
                <field name="purpose"/>
                <field name="model_name" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="input_tokens" sum="Total"/>
                <field name="output_tokens" sum="Total"/>
                <field name="cost" sum="Total"/>
                <field name="latency_ms" optional="show"/>
                <field name="high_risk" optional="show"/>
                <field name="pii_masked" optional="hide"/>
                <field name="status" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_eduagent_usage_form" model="ir.ui.view">
        <field name="name">eduagent.usage.log.form</field>
        <field name="model">eduagent.usage.log</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date"/>
                            <field name="agent_id"/>
                            <field name="provider_id"/>
                            <field name="model_name"/>
                            <field name="purpose"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="partner_id"/>
                            <field name="input_tokens"/>
                            <field name="output_tokens"/>
                            <field name="cost"/>
                            <field name="latency_ms"/>
                            <field name="high_risk"/>
                            <field name="pii_masked"/>
                        </group>
                    </group>
                    <separator string="Request (excerpt, personal data masked)"/>
                    <field name="request_excerpt"/>
                    <separator string="Response (excerpt)"/>
                    <field name="response_excerpt"/>
                    <separator string="Error" invisible="not error"/>
                    <field name="error" invisible="not error"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_eduagent_usage_pivot" model="ir.ui.view">
        <field name="name">eduagent.usage.log.pivot</field>
        <field name="model">eduagent.usage.log</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="agent_id" type="row"/>
                <field name="create_date" interval="month" type="col"/>
                <field name="total_tokens" type="measure"/>
                <field name="cost" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_eduagent_usage_graph" model="ir.ui.view">
        <field name="name">eduagent.usage.log.graph</field>
        <field name="model">eduagent.usage.log</field>
        <field name="arch" type="xml">
            <graph type="line">
                <field name="create_date" interval="day"/>
                <field name="total_tokens" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_eduagent_usage_search" model="ir.ui.view">
        <field name="name">eduagent.usage.log.search</field>
        <field name="model">eduagent.usage.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="agent_id"/>
                <field name="partner_id"/>
                <filter name="errors" string="Errors / Blocked" domain="[('status', '!=', 'ok')]"/>
                <filter name="high_risk" string="High-risk Decision Support" domain="[('high_risk', '=', True)]"/>
                <filter name="this_month" string="This Month" date="create_date"/>
                <group>
                    <filter name="group_agent" string="Agent" context="{'group_by': 'agent_id'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_eduagent_usage" model="ir.actions.act_window">
        <field name="name">AI Audit &amp; Usage</field>
        <field name="res_model">eduagent.usage.log</field>
        <field name="view_mode">list,pivot,graph,form</field>
    </record>
</odoo>
