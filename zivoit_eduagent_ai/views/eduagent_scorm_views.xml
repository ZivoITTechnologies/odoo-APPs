<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eduagent_scorm_list" model="ir.ui.view">
        <field name="name">eduagent.scorm.package.list</field>
        <field name="model">eduagent.scorm.package</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="name"/>
                <field name="channel_id"/>
                <field name="version"/>
            </list>
        </field>
    </record>
    <record id="view_eduagent_scorm_form" model="ir.ui.view">
        <field name="name">eduagent.scorm.package.form</field>
        <field name="model">eduagent.scorm.package</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="channel_id"/>
                        <field name="version" readonly="1"/>
                        <field name="attachment_id" readonly="1"/>
                    </group>
                    <field name="item_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="launch_path"/>
                            <field name="slide_id"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_eduagent_scorm" model="ir.actions.act_window">
        <field name="name">SCORM Packages</field>
        <field name="res_model">eduagent.scorm.package</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
