<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eduagent_knowledge_list" model="ir.ui.view">
        <field name="name">eduagent.knowledge.chunk.list</field>
        <field name="model">eduagent.knowledge.chunk</field>
        <field name="arch" type="xml">
            <list>
                <field name="channel_id"/>
                <field name="name"/>
                <field name="source_type"/>
                <field name="content" optional="show"/>
                <field name="embedding" string="Has Vector" widget="boolean" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_eduagent_knowledge_form" model="ir.ui.view">
        <field name="name">eduagent.knowledge.chunk.form</field>
        <field name="model">eduagent.knowledge.chunk</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="source_type"/>
                            <field name="channel_id"/>
                        </group>
                        <group>
                            <field name="slide_id"/>
                            <field name="faq_id"/>
                            <field name="url" widget="url"/>
                        </group>
                    </group>
                    <field name="content"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_eduagent_knowledge_search" model="ir.ui.view">
        <field name="name">eduagent.knowledge.chunk.search</field>
        <field name="model">eduagent.knowledge.chunk</field>
        <field name="arch" type="xml">
            <search>
                <field name="content"/>
                <field name="channel_id"/>
                <group>
                    <filter name="group_channel" string="Course" context="{'group_by': 'channel_id'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'source_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_eduagent_knowledge" model="ir.actions.act_window">
        <field name="name">Knowledge Store (RAG)</field>
        <field name="res_model">eduagent.knowledge.chunk</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No knowledge indexed yet</p>
            <p>Open a course and click "Index for AI" (or wait for the scheduled re-index). FAQs are indexed from the FAQ menu.</p>
        </field>
    </record>

    <!-- FAQ -->
    <record id="view_eduagent_faq_list" model="ir.ui.view">
        <field name="name">eduagent.faq.list</field>
        <field name="model">eduagent.faq</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="action_reindex_all" type="object" string="Re-index FAQs for AI" display="always"/>
                </header>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category"/>
                <field name="channel_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_eduagent_faq_form" model="ir.ui.view">
        <field name="name">eduagent.faq.form</field>
        <field name="model">eduagent.faq</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="category"/>
                        <field name="channel_id"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <field name="answer"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_eduagent_faq" model="ir.actions.act_window">
        <field name="name">FAQ &amp; Policies</field>
        <field name="res_model">eduagent.faq</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
