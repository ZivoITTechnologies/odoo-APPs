<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_lead_form_eduagent" model="ir.ui.view">
        <field name="name">crm.lead.form.eduagent</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="AI Admissions" name="eduagent" invisible="not eduagent_conversation_id and not eduagent_goal">
                    <group>
                        <group>
                            <field name="eduagent_score" widget="progressbar"/>
                            <field name="eduagent_goal"/>
                            <field name="eduagent_experience"/>
                            <field name="eduagent_interest"/>
                        </group>
                        <group>
                            <field name="eduagent_budget"/>
                            <field name="eduagent_timeline"/>
                            <field name="eduagent_channel_ids" widget="many2many_tags"/>
                            <field name="eduagent_conversation_id"/>
                        </group>
                    </group>
                    <separator string="Chat transcript"/>
                    <field name="eduagent_transcript" readonly="1"/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_crm_lead_list_eduagent" model="ir.ui.view">
        <field name="name">crm.lead.list.eduagent</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="eduagent_score" optional="show" widget="progressbar"/>
            </xpath>
        </field>
    </record>

    <record id="action_eduagent_leads" model="ir.actions.act_window">
        <field name="name">AI-captured Leads</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('eduagent_conversation_id', '!=', False)]</field>
        <field name="context">{'default_type': 'lead'}</field>
    </record>
</odoo>
