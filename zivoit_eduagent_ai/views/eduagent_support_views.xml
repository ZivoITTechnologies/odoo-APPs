<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eduagent_ticket_list" model="ir.ui.view">
        <field name="name">eduagent.support.ticket.list</field>
        <field name="model">eduagent.support.ticket</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'done'">
                <field name="reference"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="category"/>
                <field name="priority" widget="priority"/>
                <field name="user_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_eduagent_ticket_kanban" model="ir.ui.view">
        <field name="name">eduagent.support.ticket.kanban</field>
        <field name="model">eduagent.support.ticket</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <templates>
                    <t t-name="card">
                        <field name="reference" class="text-muted small"/>
                        <field name="name" class="fw-bold"/>
                        <field name="partner_id"/>
                        <div class="d-flex justify-content-between">
                            <field name="category"/>
                            <field name="priority" widget="priority"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="view_eduagent_ticket_form" model="ir.ui.view">
        <field name="name">eduagent.support.ticket.form</field>
        <field name="model">eduagent.support.ticket</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start" class="btn-primary" invisible="state != 'new'"/>
                    <button name="action_done" type="object" string="Mark Solved" invisible="state == 'done'"/>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <field name="reference" readonly="1" class="text-muted"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="channel_id"/>
                            <field name="category"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="priority" widget="priority"/>
                            <field name="conversation_id"/>
                            <field name="helpdesk_ticket_ref" invisible="not helpdesk_ticket_ref"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Details"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_eduagent_ticket" model="ir.actions.act_window">
        <field name="name">Support Tickets</field>
        <field name="res_model">eduagent.support.ticket</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
