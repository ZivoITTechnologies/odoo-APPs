<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eduagent_credential_list" model="ir.ui.view">
        <field name="name">eduagent.credential.list</field>
        <field name="model">eduagent.credential</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'revoked'">
                <field name="issue_date"/>
                <field name="code"/>
                <field name="partner_id"/>
                <field name="channel_id"/>
                <field name="state" widget="badge" decoration-success="state == 'valid'" decoration-danger="state == 'revoked'"/>
            </list>
        </field>
    </record>
    <record id="view_eduagent_credential_form" model="ir.ui.view">
        <field name="name">eduagent.credential.form</field>
        <field name="model">eduagent.credential</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_revoke" type="object" string="Revoke" invisible="state != 'valid'"
                            confirm="Revoke this credential? Anyone verifying it will see it as revoked."/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="code"/></h1></div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="channel_id"/>
                            <field name="issue_date"/>
                        </group>
                        <group>
                            <field name="verify_url" widget="url"/>
                            <field name="signature"/>
                            <field name="revoke_reason" invisible="state != 'revoked'"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_eduagent_credential" model="ir.actions.act_window">
        <field name="name">Verifiable Credentials</field>
        <field name="res_model">eduagent.credential</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
