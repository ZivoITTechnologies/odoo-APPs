<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eduagent_risk_list" model="ir.ui.view">
        <field name="name">slide.channel.partner.eduagent.risk.list</field>
        <field name="model">slide.channel.partner</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list create="false" default_order="eduagent_risk_score desc" decoration-danger="eduagent_risk_level == 'high'" decoration-warning="eduagent_risk_level == 'medium'">
                <header>
                    <button name="action_eduagent_recompute" type="object" string="Recompute Risk"/>
                    <button name="action_eduagent_nudge_now" type="object" string="Send AI Nudge"/>
                </header>
                <field name="partner_id"/>
                <field name="partner_email" optional="show"/>
                <field name="channel_id"/>
                <field name="completion" widget="progressbar"/>
                <field name="eduagent_risk_score"/>
                <field name="eduagent_risk_level" widget="badge" decoration-danger="eduagent_risk_level == 'high'" decoration-warning="eduagent_risk_level == 'medium'" decoration-success="eduagent_risk_level == 'low'"/>
                <field name="eduagent_risk_reasons"/>
                <field name="eduagent_last_activity" optional="show"/>
                <field name="eduagent_nudge_count" optional="show"/>
                <field name="eduagent_last_nudge" optional="hide"/>
                <field name="member_status" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_eduagent_risk_search" model="ir.ui.view">
        <field name="name">slide.channel.partner.eduagent.risk.search</field>
        <field name="model">slide.channel.partner</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="channel_id"/>
                <filter name="high" string="High Risk" domain="[('eduagent_risk_level', '=', 'high')]"/>
                <filter name="medium" string="Medium Risk" domain="[('eduagent_risk_level', '=', 'medium')]"/>
                <filter name="ongoing" string="In Progress" domain="[('member_status', 'in', ('joined', 'ongoing'))]"/>
                <group>
                    <filter name="group_channel" string="Course" context="{'group_by': 'channel_id'}"/>
                    <filter name="group_level" string="Risk Level" context="{'group_by': 'eduagent_risk_level'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_eduagent_risk_graph" model="ir.ui.view">
        <field name="name">slide.channel.partner.eduagent.risk.graph</field>
        <field name="model">slide.channel.partner</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <graph type="bar" stacked="True">
                <field name="channel_id"/>
                <field name="eduagent_risk_level"/>
            </graph>
        </field>
    </record>

    <record id="action_eduagent_risk" model="ir.actions.act_window">
        <field name="name">Learner Risk Radar</field>
        <field name="res_model">slide.channel.partner</field>
        <field name="view_mode">list,graph</field>
        <field name="domain">['|', ('partner_id.user_ids', '=', False), ('partner_id.user_ids.share', '=', True)]</field>
        <field name="search_view_id" ref="view_eduagent_risk_search"/>
        <field name="context">{'search_default_ongoing': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No risk scores yet</p>
            <p>The Retention Coach scores every active enrolment daily. Select learners and click "Recompute Risk" to score them now.</p>
        </field>
    </record>
    <record id="action_eduagent_risk_view_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_eduagent_risk_list"/>
        <field name="act_window_id" ref="action_eduagent_risk"/>
    </record>
    <record id="action_eduagent_risk_view_graph" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_eduagent_risk_graph"/>
        <field name="act_window_id" ref="action_eduagent_risk"/>
    </record>

    <record id="view_eduagent_nudge_list" model="ir.ui.view">
        <field name="name">eduagent.nudge.list</field>
        <field name="model">eduagent.nudge</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="create_date"/>
                <field name="partner_id"/>
                <field name="channel_id"/>
                <field name="subject"/>
                <field name="risk_score"/>
                <field name="re_engaged"/>
            </list>
        </field>
    </record>

    <record id="view_eduagent_nudge_form" model="ir.ui.view">
        <field name="name">eduagent.nudge.form</field>
        <field name="model">eduagent.nudge</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <field name="partner_id"/>
                        <field name="channel_id"/>
                        <field name="subject"/>
                        <field name="risk_score"/>
                        <field name="re_engaged"/>
                        <field name="mail_id"/>
                    </group>
                    <field name="body"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_eduagent_nudge" model="ir.actions.act_window">
        <field name="name">Nudges Sent</field>
        <field name="res_model">eduagent.nudge</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
