<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eduagent_agent_kanban" model="ir.ui.view">
        <field name="name">eduagent.agent.kanban</field>
        <field name="model">eduagent.agent</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage" group_create="false" records_draggable="false">
                <field name="stage"/>
                <field name="code"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold fs-5"/>
                        <field name="description" class="text-muted small"/>
                        <div class="d-flex gap-3 mt-2 small">
                            <span><field name="conversation_count"/> conversations</span>
                            <span><field name="tokens_this_month"/> tokens this month</span>
                        </div>
                        <div class="d-flex gap-2 mt-1">
                            <span class="badge text-bg-info" invisible="not public_access">Website</span>
                            <span class="badge text-bg-success" invisible="not portal_access">Learner Hub</span>
                            <span class="badge text-bg-secondary" invisible="not use_rag">RAG</span>
                        </div>
                        <field name="public_access" invisible="1"/>
                        <field name="portal_access" invisible="1"/>
                        <field name="use_rag" invisible="1"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_eduagent_agent_list" model="ir.ui.view">
        <field name="name">eduagent.agent.list</field>
        <field name="model">eduagent.agent</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="stage"/>
                <field name="code"/>
                <field name="model_tier"/>
                <field name="use_rag"/>
                <field name="public_access"/>
                <field name="portal_access"/>
                <field name="provider_id" optional="hide"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_eduagent_agent_form" model="ir.ui.view">
        <field name="name">eduagent.agent.form</field>
        <field name="model">eduagent.agent</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_conversations" type="object" class="oe_stat_button" icon="fa-comments">
                            <field name="conversation_count" widget="statinfo" string="Conversations"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-bolt" disabled="1">
                            <field name="tokens_this_month" widget="statinfo" string="Tokens (month)"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <field name="description" placeholder="What this agent does"/>
                    </div>
                    <group>
                        <group string="Identity">
                            <field name="code" readonly="1"/>
                            <field name="stage"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Model">
                            <field name="provider_id" placeholder="Company default"/>
                            <field name="model_tier"/>
                            <field name="temperature"/>
                            <field name="max_history"/>
                        </group>
                        <group string="Access">
                            <field name="public_access"/>
                            <field name="portal_access"/>
                            <field name="handoff_user_id"/>
                        </group>
                        <group string="Knowledge &amp; Actions">
                            <field name="use_rag"/>
                            <field name="rag_sources" invisible="not use_rag"/>
                            <field name="allowed_actions"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Instructions (system prompt)" name="prompt">
                            <field name="system_prompt" nolabel="1"/>
                        </page>
                        <page string="Welcome Message" name="welcome">
                            <field name="welcome_message" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_eduagent_agent" model="ir.actions.act_window">
        <field name="name">AI Agents</field>
        <field name="res_model">eduagent.agent</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
