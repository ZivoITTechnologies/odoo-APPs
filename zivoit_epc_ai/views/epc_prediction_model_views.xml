<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_epc_prediction_model_list" model="ir.ui.view">
        <field name="name">epc.prediction.model.list</field>
        <field name="model">epc.prediction.model</field>
        <field name="arch" type="xml">
            <list string="Learned Duration Factors" create="0" edit="0" delete="0">
                <header>
                    <button name="action_relearn" type="object" string="Re-learn from History" display="always"/>
                </header>
                <field name="discipline"/>
                <field name="sample_count"/>
                <field name="mean_factor"/>
                <field name="p50_factor"/>
                <field name="p80_factor"/>
                <field name="updated_on"/>
            </list>
        </field>
    </record>

    <record id="action_epc_prediction_models" model="ir.actions.act_window">
        <field name="name">Learned Duration Factors</field>
        <field name="res_model">epc.prediction.model</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No factors learned yet</p>
            <p>Factors are learned weekly from completed activities: how much longer (or shorter) each discipline
               took than planned. Press <b>Re-learn from History</b> to compute them now.</p>
        </field>
    </record>
</odoo>
