<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_epc_contract_review_list" model="ir.ui.view">
        <field name="name">epc.contract.review.list</field>
        <field name="model">epc.contract.review</field>
        <field name="arch" type="xml">
            <list string="Contract Reviews">
                <field name="name"/>
                <field name="project_id"/>
                <field name="ld_rate_pct_week" optional="show"/>
                <field name="ld_cap_pct" optional="show"/>
                <field name="high_risk_count"/>
                <field name="overall_risk" widget="badge" decoration-success="overall_risk == 'low'"
                       decoration-warning="overall_risk == 'medium'" decoration-danger="overall_risk == 'high'"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_epc_contract_review_form" model="ir.ui.view">
        <field name="name">epc.contract.review.form</field>
        <field name="model">epc.contract.review</field>
        <field name="arch" type="xml">
            <form string="Contract Review">
                <header>
                    <button name="action_analyse" type="object" string="Analyse with AI" class="btn-primary"/>
                    <button name="action_apply_to_project" type="object" string="Apply to Project"
                            invisible="state != 'analysed' or not project_id"
                            groups="zivoit_epc_ai.group_epc_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="project_id" options="{'no_create': True}"/>
                            <field name="contract_file" filename="contract_filename"/>
                            <field name="contract_filename" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group invisible="state != 'analysed'">
                            <field name="overall_risk"/>
                            <field name="high_risk_count"/>
                            <field name="ld_rate_pct_week"/>
                            <field name="ld_cap_pct"/>
                            <field name="retention_pct"/>
                            <field name="payment_days"/>
                            <field name="ai_source"/>
                        </group>
                    </group>
                    <field name="summary" nolabel="1" invisible="not summary" readonly="1"/>
                    <notebook>
                        <page string="Clauses" name="clauses">
                            <field name="clause_ids">
                                <list decoration-danger="risk_level == 'high'" decoration-warning="risk_level == 'medium'">
                                    <field name="clause_type"/>
                                    <field name="value"/>
                                    <field name="risk_level"/>
                                    <field name="comment"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="clause_type"/>
                                        <field name="value"/>
                                        <field name="risk_level"/>
                                        <field name="comment"/>
                                        <field name="excerpt"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Contract Text" name="text">
                            <field name="contract_text" placeholder="Paste the contract text here, or upload a PDF above."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_epc_contract_reviews" model="ir.actions.act_window">
        <field name="name">Contract Risk Reviews</field>
        <field name="res_model">epc.contract.review</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
