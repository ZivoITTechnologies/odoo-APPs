<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_epc_predictions" model="ir.cron">
            <field name="name">ZivoIT EPC: run delay and cost predictions</field>
            <field name="model_id" ref="model_epc_prediction_engine"/>
            <field name="state">code</field>
            <field name="code">model._cron_run_predictions()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_epc_learn" model="ir.cron">
            <field name="name">ZivoIT EPC: learn duration factors from completed activities</field>
            <field name="model_id" ref="model_epc_prediction_engine"/>
            <field name="state">code</field>
            <field name="code">model._cron_learn()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
