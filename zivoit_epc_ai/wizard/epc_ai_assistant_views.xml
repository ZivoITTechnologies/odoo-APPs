<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_epc_ai_assistant_form" model="ir.ui.view">
        <field name="name">epc.ai.assistant.form</field>
        <field name="model">epc.ai.assistant</field>
        <field name="arch" type="xml">
            <form string="Project AI Assistant">
                <group>
                    <field name="project_id" options="{'no_create': True}" readonly="1"/>
                    <field name="question" placeholder="e.g. Why is stringing section A late? What is our LD exposure? Which vendors are at risk?"/>
                </group>
                <div invisible="not answer" class="border rounded p-3 mt-2">
                    <field name="answer" nolabel="1"/>
                    <div class="text-muted small">Source: <field name="source" class="oe_inline"/></div>
                </div>
                <footer>
                    <button name="action_ask" type="object" string="Ask" class="btn-primary"/>
                    <button name="action_post_to_project" type="object" string="Post to Project" invisible="not answer"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
