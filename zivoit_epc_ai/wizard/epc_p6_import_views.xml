<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_epc_p6_import_form" model="ir.ui.view">
        <field name="name">epc.p6.import.form</field>
        <field name="model">epc.p6.import</field>
        <field name="arch" type="xml">
            <form string="Primavera P6">
                <div class="alert alert-success" role="status" invisible="not result">
                    <field name="result" nolabel="1"/>
                </div>
                <group>
                    <group>
                        <field name="project_id" options="{'no_create': True}"/>
                        <field name="xer_file" filename="xer_filename"/>
                        <field name="xer_filename" invisible="1"/>
                        <field name="hours_per_day"/>
                    </group>
                    <group>
                        <field name="update_existing"/>
                        <field name="import_actuals"/>
                        <field name="set_baseline"/>
                    </group>
                </group>
                <group invisible="not export_file">
                    <field name="export_file" filename="export_filename" readonly="1"/>
                    <field name="export_filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Import XER" class="btn-primary"/>
                    <button name="action_export" type="object" string="Export XER"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
