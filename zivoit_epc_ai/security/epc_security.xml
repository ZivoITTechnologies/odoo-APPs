<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_epc" model="ir.module.category">
        <field name="name">EPC Project Controls</field>
        <field name="sequence">20</field>
    </record>

    <record id="res_groups_privilege_epc" model="res.groups.privilege">
        <field name="name">EPC Project Controls</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="module_category_epc"/>
    </record>

    <record id="group_epc_user" model="res.groups">
        <field name="name">User</field>
        <field name="comment">Site and project staff: file DPRs, update activities, documents and risks.</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_epc"/>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
    </record>

    <record id="group_epc_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="comment">Project controls managers: approve DPRs, certify RA bills, configure AI and schedules.</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_epc"/>
        <field name="implied_ids" eval="[(4, ref('group_epc_user')), (4, ref('project.group_project_manager'))]"/>
    </record>

    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[(4, ref('group_epc_manager'))]"/>
    </record>
</odoo>
