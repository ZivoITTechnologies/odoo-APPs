<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="zivo_audit_log_view_list" model="ir.ui.view">
        <field name="name">zivo.audit.log.list</field>
        <field name="model">zivo.audit.log</field>
        <field name="arch" type="xml">
            <list string="Audit Log" create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="action" widget="badge" decoration-success="action == 'create'"
                       decoration-danger="action == 'unlink'" decoration-info="action in ('version', 'download')"/>
                <field name="model_description"/>
                <field name="record_name"/>
                <field name="changes"/>
                <field name="ip_address" optional="show"/>
            </list>
        </field>
    </record>

    <record id="zivo_audit_log_view_form" model="ir.ui.view">
        <field name="name">zivo.audit.log.form</field>
        <field name="model">zivo.audit.log</field>
        <field name="arch" type="xml">
            <form string="Audit Entry" create="0" edit="0" delete="0">
                <header>
                    <button name="action_open_record" type="object" string="Open Record" invisible="action == 'unlink'"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="user_id"/>
                            <field name="ip_address"/>
                            <field name="action"/>
                        </group>
                        <group>
                            <field name="model_description"/>
                            <field name="model"/>
                            <field name="res_id"/>
                            <field name="record_name"/>
                        </group>
                    </group>
                    <separator string="Changes"/>
                    <field name="changes"/>
                    <field name="changes_json" groups="base.group_no_one"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="zivo_audit_log_view_search" model="ir.ui.view">
        <field name="name">zivo.audit.log.search</field>
        <field name="model">zivo.audit.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="record_name"/>
                <field name="user_id"/>
                <field name="changes"/>
                <field name="ip_address"/>
                <filter string="Events" name="events" domain="[('model', '=', 'event.event')]"/>
                <filter string="Bookings" name="bookings" domain="[('model', '=', 'zivo.equipment.booking')]"/>
                <filter string="Documents" name="documents" domain="[('model', '=', 'zivo.event.document')]"/>
                <separator/>
                <filter string="Deletions" name="deletions" domain="[('action', '=', 'unlink')]"/>
                <filter string="Date" name="date" date="date"/>
                <filter string="User" name="groupby_user" context="{'group_by': 'user_id'}"/>
                <filter string="Document Type" name="groupby_model" context="{'group_by': 'model_description'}"/>
                <filter string="Action" name="groupby_action" context="{'group_by': 'action'}"/>
            </search>
        </field>
    </record>

    <record id="action_zivo_audit_log" model="ir.actions.act_window">
        <field name="name">Audit Log</field>
        <field name="res_model">zivo.audit.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No audit entry yet</p>
            <p>Every change on events, bookings, documents and invitations is recorded here with old and new values, user and IP.</p>
        </field>
    </record>
</odoo>
