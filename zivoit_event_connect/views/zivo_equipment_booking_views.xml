<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="zivo_equipment_booking_view_list" model="ir.ui.view">
        <field name="name">zivo.equipment.booking.list</field>
        <field name="model">zivo.equipment.booking</field>
        <field name="arch" type="xml">
            <list string="Equipment Bookings" decoration-muted="state in ('cancel', 'rejected')"
                  decoration-warning="state == 'submitted'" sample="1">
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="quantity"/>
                <field name="start"/>
                <field name="stop"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="event_id" optional="show"/>
                <field name="source" optional="hide"/>
                <field name="state" widget="badge" decoration-warning="state == 'submitted'"
                       decoration-success="state == 'approved'" decoration-danger="state == 'rejected'"
                       decoration-info="state == 'done'"/>
                <field name="can_approve" column_invisible="1"/>
                <button name="action_approve" type="object" icon="fa-check" title="Approve" class="text-success"
                        invisible="state != 'submitted' or not can_approve"/>
                <button name="action_open_reject_wizard" type="object" icon="fa-times" title="Reject" class="text-danger"
                        invisible="state != 'submitted' or not can_approve"/>
            </list>
        </field>
    </record>

    <record id="zivo_equipment_booking_view_form" model="ir.ui.view">
        <field name="name">zivo.equipment.booking.form</field>
        <field name="model">zivo.equipment.booking</field>
        <field name="arch" type="xml">
            <form string="Equipment Booking">
                <header>
                    <button name="action_submit" type="object" string="Submit for Approval" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="state != 'submitted' or not can_approve"/>
                    <button name="action_open_reject_wizard" type="object" string="Reject"
                            invisible="state != 'submitted' or not can_approve"/>
                    <button name="action_mark_returned" type="object" string="Mark as Returned"
                            invisible="state != 'approved' or not can_approve"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('cancel', 'done', 'rejected')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state not in ('cancel', 'rejected')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Request">
                            <field name="equipment_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="quantity" readonly="state != 'draft'"/>
                            <field name="start" readonly="state != 'draft'"/>
                            <field name="stop" readonly="state != 'draft'"/>
                            <field name="duration" widget="float_time"/>
                        </group>
                        <group string="Context">
                            <field name="user_id" widget="many2one_avatar_user" readonly="state != 'draft'"/>
                            <field name="event_id" readonly="state != 'draft'"/>
                            <field name="department_id" readonly="state != 'draft'"/>
                            <field name="source"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="can_approve" invisible="1"/>
                        </group>
                    </group>
                    <group string="Decision" invisible="state in ('draft', 'submitted')">
                        <group>
                            <field name="approver_id" widget="many2one_avatar_user"/>
                            <field name="decision_date"/>
                        </group>
                        <group>
                            <field name="reject_reason" invisible="state != 'rejected'"/>
                        </group>
                    </group>
                    <group string="Approvers" name="approvers" invisible="state != 'submitted'">
                        <field name="approver_ids" widget="many2many_avatar_user" nolabel="1" colspan="2"/>
                    </group>
                    <field name="purpose" placeholder="Purpose of the booking…" readonly="state != 'draft'"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="zivo_equipment_booking_view_calendar" model="ir.ui.view">
        <field name="name">zivo.equipment.booking.calendar</field>
        <field name="model">zivo.equipment.booking</field>
        <field name="arch" type="xml">
            <calendar string="Equipment Bookings" date_start="start" date_stop="stop" color="equipment_id"
                      mode="week" event_open_popup="1" quick_create="0">
                <field name="equipment_id" filters="1"/>
                <field name="quantity"/>
                <field name="user_id" avatar_field="avatar_128"/>
                <field name="state"/>
                <field name="event_id"/>
            </calendar>
        </field>
    </record>

    <record id="zivo_equipment_booking_view_pivot" model="ir.ui.view">
        <field name="name">zivo.equipment.booking.pivot</field>
        <field name="model">zivo.equipment.booking</field>
        <field name="arch" type="xml">
            <pivot string="Equipment Usage" sample="1">
                <field name="equipment_id" type="row"/>
                <field name="start" interval="month" type="col"/>
                <field name="duration" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="zivo_equipment_booking_view_search" model="ir.ui.view">
        <field name="name">zivo.equipment.booking.search</field>
        <field name="model">zivo.equipment.booking</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="user_id"/>
                <field name="event_id"/>
                <filter string="My Bookings" name="my" domain="[('user_id', '=', uid)]"/>
                <filter string="Waiting Approval" name="to_approve" domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <separator/>
                <filter string="Upcoming" name="upcoming" domain="[('stop', '>=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Start" name="start" date="start"/>
                <filter string="Equipment" name="groupby_equipment" context="{'group_by': 'equipment_id'}"/>
                <filter string="Status" name="groupby_state" context="{'group_by': 'state'}"/>
                <filter string="Requester" name="groupby_user" context="{'group_by': 'user_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_zivo_booking_my" model="ir.actions.act_window">
        <field name="name">My Bookings</field>
        <field name="res_model">zivo.equipment.booking</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="context">{'search_default_my': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Book your first equipment</p>
            <p>Choose a time slot, the quantity and submit: your approver is notified instantly.</p>
        </field>
    </record>

    <record id="action_zivo_booking_to_approve" model="ir.actions.act_window">
        <field name="name">To Approve</field>
        <field name="res_model">zivo.equipment.booking</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="context">{'search_default_to_approve': 1}</field>
    </record>

    <record id="action_zivo_booking_all" model="ir.actions.act_window">
        <field name="name">Booking Calendar</field>
        <field name="res_model">zivo.equipment.booking</field>
        <field name="view_mode">calendar,list,pivot,form</field>
    </record>

    <record id="action_zivo_booking_portal" model="ir.actions.act_url">
        <field name="name">Book Equipment (time slots)</field>
        <field name="url">/equipment</field>
        <field name="target">self</field>
    </record>
</odoo>
