<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="zivo_booking_reject_wizard_view_form" model="ir.ui.view">
        <field name="name">zivo.booking.reject.wizard.form</field>
        <field name="model">zivo.booking.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Booking">
                <field name="booking_ids" invisible="1"/>
                <group>
                    <field name="reason" placeholder="Explain why the request is rejected…"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Reject" class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
