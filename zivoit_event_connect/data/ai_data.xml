<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- AI feature switches: on by default once AI is enabled (AI itself is off until configured) -->
        <record id="param_ai_feature_writer" model="ir.config_parameter"><field name="key">zivoit_event_connect.ai_feature_writer</field><field name="value">True</field></record>
        <record id="param_ai_feature_search" model="ir.config_parameter"><field name="key">zivoit_event_connect.ai_feature_search</field><field name="value">True</field></record>
        <record id="param_ai_feature_booking" model="ir.config_parameter"><field name="key">zivoit_event_connect.ai_feature_booking</field><field name="value">True</field></record>
        <record id="param_ai_booking_auto" model="ir.config_parameter"><field name="key">zivoit_event_connect.ai_booking_auto</field><field name="value">True</field></record>
        <record id="param_ai_feature_survey" model="ir.config_parameter"><field name="key">zivoit_event_connect.ai_feature_survey</field><field name="value">True</field></record>
        <record id="param_ai_feature_document" model="ir.config_parameter"><field name="key">zivoit_event_connect.ai_feature_document</field><field name="value">True</field></record>
        <record id="param_ai_feature_anomaly" model="ir.config_parameter"><field name="key">zivoit_event_connect.ai_feature_anomaly</field><field name="value">True</field></record>

        <record id="ir_cron_anomaly_detection" model="ir.cron">
            <field name="name">Event Connect: detect audit anomalies</field>
            <field name="model_id" ref="model_zivo_ai_alert"/>
            <field name="state">code</field>
            <field name="code">model._cron_detect()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
