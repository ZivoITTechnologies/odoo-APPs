<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_equipment_booking" model="ir.sequence">
            <field name="name">Equipment Booking</field>
            <field name="code">zivo.equipment.booking</field>
            <field name="prefix">EQB/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="mail_activity_booking_approval" model="mail.activity.type">
            <field name="name">Equipment Booking Approval</field>
            <field name="icon">fa-check-square-o</field>
            <field name="res_model">zivo.equipment.booking</field>
            <field name="delay_count">1</field>
            <field name="summary">Approve equipment booking</field>
        </record>

        <!-- Webhook topics -->
        <record id="topic_event_created" model="zivo.webhook.topic">
            <field name="name">Event created</field><field name="code">event.created</field><field name="sequence">1</field>
        </record>
        <record id="topic_event_updated" model="zivo.webhook.topic">
            <field name="name">Event updated</field><field name="code">event.updated</field><field name="sequence">2</field>
        </record>
        <record id="topic_event_published" model="zivo.webhook.topic">
            <field name="name">Event published</field><field name="code">event.published</field><field name="sequence">3</field>
        </record>
        <record id="topic_event_unpublished" model="zivo.webhook.topic">
            <field name="name">Event unpublished</field><field name="code">event.unpublished</field><field name="sequence">4</field>
        </record>
        <record id="topic_event_deleted" model="zivo.webhook.topic">
            <field name="name">Event deleted</field><field name="code">event.deleted</field><field name="sequence">5</field>
        </record>
        <record id="topic_registration_created" model="zivo.webhook.topic">
            <field name="name">Registration created</field><field name="code">registration.created</field><field name="sequence">10</field>
        </record>
        <record id="topic_booking_submitted" model="zivo.webhook.topic">
            <field name="name">Booking submitted</field><field name="code">booking.submitted</field><field name="sequence">20</field>
        </record>
        <record id="topic_booking_approved" model="zivo.webhook.topic">
            <field name="name">Booking approved</field><field name="code">booking.approved</field><field name="sequence">21</field>
        </record>
        <record id="topic_booking_rejected" model="zivo.webhook.topic">
            <field name="name">Booking rejected</field><field name="code">booking.rejected</field><field name="sequence">22</field>
        </record>
    </data>
</odoo>
