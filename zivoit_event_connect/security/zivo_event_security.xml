<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record model="res.groups.privilege" id="res_groups_privilege_event_connect">
            <field name="name">Event Connect</field>
            <field name="sequence">19</field>
            <field name="category_id" ref="base.module_category_marketing"/>
        </record>

        <record id="group_equipment_user" model="res.groups">
            <field name="name">Equipment Requester</field>
            <field name="sequence">10</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_event_connect"/>
            <field name="comment">Can request equipment and see own bookings.</field>
        </record>

        <record id="group_equipment_approver" model="res.groups">
            <field name="name">Equipment Approver</field>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('group_equipment_user'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_event_connect"/>
            <field name="comment">Approves or rejects equipment booking requests.</field>
        </record>

        <record id="group_event_connect_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="sequence">30</field>
            <field name="implied_ids" eval="[(4, ref('group_equipment_approver')), (4, ref('event.group_event_manager'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_event_connect"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Manages API clients, webhooks, equipment, documents and audit log.</field>
        </record>

        <!-- Event users can request equipment out of the box -->
        <record id="event.group_event_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_equipment_user'))]"/>
        </record>
    </data>

    <data noupdate="1">
        <record id="rule_booking_own" model="ir.rule">
            <field name="name">Equipment booking: requester sees own</field>
            <field name="model_id" ref="model_zivo_equipment_booking"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_equipment_user'))]"/>
        </record>
        <record id="rule_booking_approver" model="ir.rule">
            <field name="name">Equipment booking: approver sees all</field>
            <field name="model_id" ref="model_zivo_equipment_booking"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_equipment_approver'))]"/>
        </record>
        <record id="rule_booking_portal" model="ir.rule">
            <field name="name">Equipment booking: portal sees own</field>
            <field name="model_id" ref="model_zivo_equipment_booking"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>
        <record id="rule_booking_company" model="ir.rule">
            <field name="name">Equipment booking: multi-company</field>
            <field name="model_id" ref="model_zivo_equipment_booking"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="rule_equipment_company" model="ir.rule">
            <field name="name">Equipment: multi-company</field>
            <field name="model_id" ref="model_zivo_equipment"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
    </data>
</odoo>
