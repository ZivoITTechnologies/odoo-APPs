<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pump_tank_list" model="ir.ui.view">
        <field name="name">pump.tank.list</field>
        <field name="model">pump.tank</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="product_id"/>
                <field name="capacity"/>
                <field name="stock_qty"/>
                <field name="ullage"/>
                <field name="fill_percent" widget="progressbar"/>
                <field name="reorder_level" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_pump_tank_form" model="ir.ui.view">
        <field name="name">pump.tank.form</field>
        <field name="model">pump.tank</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_stock_moves" type="object" class="oe_stat_button" icon="fa-exchange">
                            <div class="o_stat_info"><span class="o_stat_text">Stock Ledger</span></div>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. Tank 1 - HSD"/></h1></div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="capacity"/>
                            <field name="dead_stock"/>
                            <field name="reorder_level"/>
                            <field name="opening_stock"/>
                            <field name="opening_date"/>
                            <button name="action_post_opening" type="object" string="Post Opening Stock"
                                    class="btn-secondary" colspan="2" groups="zivoit_fuel_management.group_pump_manager"/>
                        </group>
                        <group>
                            <field name="stock_qty"/>
                            <field name="ullage"/>
                            <field name="fill_percent" widget="progressbar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Nozzles" name="nozzles">
                            <field name="nozzle_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/><field name="dispenser"/>
                                    <field name="opening_meter"/><field name="last_reading"/><field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="DIP Chart" name="dip_chart">
                            <field name="dip_chart_ids">
                                <list editable="bottom">
                                    <field name="dip_mm"/><field name="volume"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pump_tank_kanban" model="ir.ui.view">
        <field name="name">pump.tank.kanban</field>
        <field name="model">pump.tank</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="fill_percent"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="name" class="fw-bold fs-5"/>
                            <field name="product_id" class="badge text-bg-primary"/>
                        </div>
                        <div class="mt-2"><field name="fill_percent" widget="progressbar"/></div>
                        <div class="d-flex justify-content-between text-muted small mt-1">
                            <span>Stock: <field name="stock_qty"/> L</span>
                            <span>Capacity: <field name="capacity"/> L</span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_pump_tank" model="ir.actions.act_window">
        <field name="name">Tanks</field>
        <field name="res_model">pump.tank</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="view_pump_nozzle_list" model="ir.ui.view">
        <field name="name">pump.nozzle.list</field>
        <field name="model">pump.nozzle</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-muted="state == 'stopped'">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="dispenser"/>
                <field name="tank_id"/>
                <field name="product_id"/>
                <field name="opening_meter"/>
                <field name="last_reading"/>
                <field name="last_reading_date"/>
                <field name="state" widget="badge" decoration-success="state == 'running'" decoration-danger="state == 'stopped'"/>
                <field name="stop_reason" optional="show"/>
                <button name="action_toggle_state" type="object" string="Start / Stop" icon="fa-power-off"/>
            </list>
        </field>
    </record>

    <record id="action_pump_nozzle" model="ir.actions.act_window">
        <field name="name">Nozzles</field>
        <field name="res_model">pump.nozzle</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_pump_dip_list" model="ir.ui.view">
        <field name="name">pump.dip.reading.list</field>
        <field name="model">pump.dip.reading</field>
        <field name="arch" type="xml">
            <list decoration-danger="variance &lt; 0" decoration-success="variance &gt; 0">
                <field name="date"/>
                <field name="tank_id"/>
                <field name="product_id"/>
                <field name="dip_mm"/>
                <field name="physical_qty"/>
                <field name="book_qty"/>
                <field name="variance"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_pump_dip_form" model="ir.ui.view">
        <field name="name">pump.dip.reading.form</field>
        <field name="model">pump.dip.reading</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_post" type="object" string="Post Variance" class="btn-primary" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="tank_id" readonly="state != 'draft'"/>
                            <field name="dip_mm" readonly="state != 'draft'"/>
                            <field name="water_mm" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="physical_qty" readonly="state != 'draft'"/>
                            <field name="book_qty"/>
                            <field name="variance"/>
                            <field name="note"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pump_dip" model="ir.actions.act_window">
        <field name="name">DIP Readings</field>
        <field name="res_model">pump.dip.reading</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_pump_stock_move_list" model="ir.ui.view">
        <field name="name">pump.stock.move.list</field>
        <field name="model">pump.stock.move</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="date"/>
                <field name="tank_id"/>
                <field name="product_id"/>
                <field name="move_type"/>
                <field name="reference"/>
                <field name="qty_in" sum="Receipts"/>
                <field name="qty_out" sum="Issues"/>
                <field name="qty" sum="Net"/>
            </list>
        </field>
    </record>

    <record id="view_pump_stock_move_search" model="ir.ui.view">
        <field name="name">pump.stock.move.search</field>
        <field name="model">pump.stock.move</field>
        <field name="arch" type="xml">
            <search>
                <field name="tank_id"/>
                <field name="product_id"/>
                <field name="reference"/>
                <filter name="purchase" string="Tanker Receipts" domain="[('move_type', '=', 'purchase')]"/>
                <filter name="sale" string="Sales" domain="[('move_type', '=', 'sale')]"/>
                <filter name="dip" string="DIP Gain/Loss" domain="[('move_type', 'in', ('gain', 'loss'))]"/>
                <filter name="date" string="Date" date="date"/>
                <group>
                    <filter name="g_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="g_tank" string="Tank" context="{'group_by': 'tank_id'}"/>
                    <filter name="g_type" string="Type" context="{'group_by': 'move_type'}"/>
                    <filter name="g_day" string="Day" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_pump_stock_move_pivot" model="ir.ui.view">
        <field name="name">pump.stock.move.pivot</field>
        <field name="model">pump.stock.move</field>
        <field name="arch" type="xml">
            <pivot string="Stock Summary">
                <field name="product_id" type="row"/>
                <field name="move_type" type="col"/>
                <field name="qty" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_pump_stock_move" model="ir.actions.act_window">
        <field name="name">Stock Summary</field>
        <field name="res_model">pump.stock.move</field>
        <field name="view_mode">pivot,list</field>
    </record>
</odoo>
