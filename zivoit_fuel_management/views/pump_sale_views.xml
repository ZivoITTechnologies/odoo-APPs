<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_credit_sale_list" model="ir.ui.view">
        <field name="name">pump.credit.sale.list</field>
        <field name="model">pump.credit.sale</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'" decoration-info="state == 'draft'">
                <field name="date"/>
                <field name="name"/>
                <field name="slip_no" optional="show"/>
                <field name="shift_id" optional="hide"/>
                <field name="partner_id"/>
                <field name="vehicle_no"/>
                <field name="product_id"/>
                <field name="qty" sum="Qty"/>
                <field name="rate"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount" sum="Amount"/>
                <field name="bill_id" optional="show"/>
                <field name="odometer" optional="hide"/>
                <field name="kmpl" optional="show"/>
                <field name="source" optional="hide"/>
                <field name="ai_flag" optional="show" decoration-danger="ai_flag"/>
                <field name="state" widget="badge" decoration-success="state == 'billed'"
                       decoration-warning="state == 'confirmed'" decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_credit_sale_form" model="ir.ui.view">
        <field name="name">pump.credit.sale.form</field>
        <field name="model">pump.credit.sale</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm Slip" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_print" type="object" string="Print Slip" invisible="state in ('draft', 'cancel')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft', 'confirmed')"/>
                    <button name="action_draft" type="object" string="Reset to Draft" invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,billed"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not ai_flag">
                        <i class="fa fa-magic" title="AI"/> <b>AI check:</b> <field name="ai_flag" class="d-inline"/>
                    </div>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group string="Customer">
                            <field name="partner_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="vehicle_id" readonly="state != 'draft'" context="{'default_partner_id': partner_id}"/>
                            <field name="vehicle_no" readonly="state != 'draft'"/>
                            <field name="slip_no"/>
                            <field name="odometer" readonly="state == 'billed'"/>
                            <field name="kmpl" invisible="not kmpl"/>
                            <field name="source" readonly="1"/>
                            <field name="delivery_trip_id" invisible="not delivery_trip_id"/>
                        </group>
                        <group string="Filling">
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="shift_id"/>
                            <field name="product_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="qty" readonly="state != 'draft'"/>
                            <field name="rate" readonly="state != 'draft'"/>
                            <field name="discount" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount" class="fs-4 fw-bold"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="indent_id" invisible="not indent_id"/>
                        </group>
                        <group>
                            <field name="bill_id" invisible="not bill_id"/>
                            <field name="note"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_credit_sale_search" model="ir.ui.view">
        <field name="name">pump.credit.sale.search</field>
        <field name="model">pump.credit.sale</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="vehicle_no"/>
                <field name="name"/>
                <field name="slip_no"/>
                <field name="product_id"/>
                <filter name="unbilled" string="Unbilled" domain="[('state', '=', 'confirmed')]"/>
                <filter name="billed" string="Billed" domain="[('state', '=', 'billed')]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <separator/>
                <filter name="today" string="Today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="date" string="Date" date="date"/>
                <group>
                    <filter name="g_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="g_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="g_day" string="Day" context="{'group_by': 'date:day'}"/>
                    <filter name="g_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_credit_sale_pivot" model="ir.ui.view">
        <field name="name">pump.credit.sale.pivot</field>
        <field name="model">pump.credit.sale</field>
        <field name="arch" type="xml">
            <pivot string="Credit Sales">
                <field name="partner_id" type="row"/>
                <field name="product_id" type="col"/>
                <field name="qty" type="measure"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_credit_sale" model="ir.actions.act_window">
        <field name="name">Credit Filling Slips</field>
        <field name="res_model">pump.credit.sale</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Record a credit filling slip</p>
            <p>Slips are checked against the customer's credit limit and later billed in a period bill.</p></field>
    </record>

    <!-- Indents -->
    <record id="view_indent_list" model="ir.ui.view">
        <field name="name">pump.indent.list</field>
        <field name="model">pump.indent</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'requested'" decoration-muted="state in ('delivered', 'rejected')">
                <field name="date"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="vehicle_id"/>
                <field name="product_id"/>
                <field name="indent_type"/>
                <field name="qty"/>
                <field name="amount"/>
                <field name="source" widget="badge"/>
                <field name="state" widget="badge" decoration-warning="state == 'requested'"
                       decoration-success="state == 'delivered'" decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_indent_form" model="ir.ui.view">
        <field name="name">pump.indent.form</field>
        <field name="model">pump.indent</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'requested'"/>
                    <button name="action_create_slip" type="object" string="Create Filling Slip" class="btn-primary" invisible="state not in ('requested', 'approved')"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state not in ('requested', 'approved')"/>
                    <field name="state" widget="statusbar" statusbar_visible="requested,approved,delivered"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="partner_id"/>
                            <field name="vehicle_id"/>
                            <field name="source"/>
                        </group>
                        <group>
                            <field name="product_id"/>
                            <field name="indent_type"/>
                            <field name="qty" invisible="indent_type != 'qty'"/>
                            <field name="amount" invisible="indent_type != 'amount'"/>
                            <field name="comment"/>
                        </group>
                    </group>
                    <field name="sale_ids" readonly="1">
                        <list><field name="name"/><field name="date"/><field name="qty"/><field name="amount"/><field name="state"/></list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_indent" model="ir.actions.act_window">
        <field name="name">Indents</field>
        <field name="res_model">pump.indent</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>

    <record id="view_indent_search" model="ir.ui.view">
        <field name="name">pump.indent.search</field>
        <field name="model">pump.indent</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="vehicle_id"/>
                <filter name="open" string="Open" domain="[('state', 'in', ('requested', 'approved'))]"/>
                <filter name="portal" string="From Portal" domain="[('source', '=', 'portal')]"/>
            </search>
        </field>
    </record>
</odoo>
