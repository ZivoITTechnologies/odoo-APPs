<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pump_purchase_list" model="ir.ui.view">
        <field name="name">pump.purchase.list</field>
        <field name="model">pump.purchase</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'" decoration-muted="state == 'cancel'">
                <field name="date"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="invoice_no"/>
                <field name="truck_no" optional="show"/>
                <field name="tank_id"/>
                <field name="product_id"/>
                <field name="qty" sum="Qty"/>
                <field name="received_qty" optional="hide"/>
                <field name="rate"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount" sum="Amount"/>
                <field name="state" widget="badge" decoration-success="state == 'posted'"/>
            </list>
        </field>
    </record>
    <record id="view_pump_purchase_form" model="ir.ui.view">
        <field name="name">pump.purchase.form</field>
        <field name="model">pump.purchase</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_post" type="object" string="Post Receipt" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state != 'posted'" groups="zivoit_fuel_management.group_pump_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group string="Invoice">
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="invoice_no" readonly="state != 'draft'"/>
                            <field name="truck_no" readonly="state != 'draft'"/>
                            <field name="paid_from" readonly="state != 'draft'"/>
                        </group>
                        <group string="Decantation">
                            <field name="tank_id" readonly="state != 'draft'"/>
                            <field name="product_id"/>
                            <field name="qty" readonly="state != 'draft'"/>
                            <field name="received_qty" readonly="state != 'draft'"/>
                            <field name="rate" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount" class="fw-bold"/>
                            <field name="voucher_id" invisible="not voucher_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_pump_purchase" model="ir.actions.act_window">
        <field name="name">Tanker Receipts / Purchases</field>
        <field name="res_model">pump.purchase</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
