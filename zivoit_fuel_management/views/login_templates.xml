<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Branded sign-in page (used by staff and credit customers) -->
    <template id="login_layout_bpcl" inherit_id="web.login_layout" name="Fuel Station Login Layout" priority="10">
        <xpath expr="//t[@t-set='body_classname']" position="attributes">
            <attribute name="t-value">'bpcl-login-body'</attribute>
        </xpath>
        <xpath expr="//div[hasclass('container')]" position="replace">
            <div class="bpcl-login">
                <section class="bpcl-login-brand">
                    <div class="bpcl-login-brand-inner">
                        <img t-attf-src="/web/binary/company_logo{{ '?dbname='+db if db else '' }}" alt="Logo"/>
                        <h1>Fuel Station Management</h1>
                        <p>Shift sales, credit customers, billing and accounts — with a self-service portal for every fleet customer.</p>
                        <ul>
                            <li><i class="fa fa-check-circle"/> Live balance &amp; credit limit</li>
                            <li><i class="fa fa-check-circle"/> Ledger &amp; monthly statements (PDF / Excel)</li>
                            <li><i class="fa fa-check-circle"/> Filling bills, slips &amp; indents</li>
                        </ul>
                    </div>
                    <div class="bpcl-login-stripe"/>
                </section>
                <section class="bpcl-login-form">
                    <div t-attf-class="bpcl-login-card {{login_card_classes}} o_database_list">
                        <div class="bpcl-login-mobile-logo">
                            <img t-attf-src="/web/binary/company_logo{{ '?dbname='+db if db else '' }}" alt="Logo"/>
                        </div>
                        <h2>Sign in</h2>
                        <div class="bpcl-login-hint">Staff and credit customers use the same page.</div>
                        <t t-out="0"/>
                        <div class="bpcl-login-foot" t-if="not disable_footer">
                            <t t-if="not disable_database_manager">
                                <a href="/web/database/manager">Manage Databases</a> ·
                            </t>
                            <span>Powered by Odoo · ZivoIT</span>
                        </div>
                    </div>
                </section>
            </div>
        </xpath>
    </template>

    <template id="login_bpcl_labels" inherit_id="web.login" name="Fuel Station Login Labels">
        <xpath expr="//label[@for='login']" position="replace">
            <label for="login" class="form-label">Login ID</label>
        </xpath>
        <xpath expr="//input[@name='login']" position="attributes">
            <attribute name="placeholder">Email, mobile or customer code</attribute>
        </xpath>
    </template>
</odoo>
