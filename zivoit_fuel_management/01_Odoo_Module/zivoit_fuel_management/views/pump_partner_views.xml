<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Fuel credit page on the standard contact form -->
    <record id="view_partner_form_pump" model="ir.ui.view">
        <field name="name">res.partner.form.pump</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_pump_slips" type="object" class="oe_stat_button" icon="fa-tint"
                        invisible="not is_pump_customer" groups="zivoit_fuel_management.group_pump_user">
                    <field name="pump_slip_count" widget="statinfo" string="Filling Slips"/>
                </button>
                <button name="action_pump_bills" type="object" class="oe_stat_button" icon="fa-file-text-o"
                        invisible="not is_pump_customer" groups="zivoit_fuel_management.group_pump_user">
                    <field name="pump_bill_count" widget="statinfo" string="Period Bills"/>
                </button>
                <button name="action_pump_ledger" type="object" class="oe_stat_button" icon="fa-book"
                        invisible="not is_pump_customer" groups="zivoit_fuel_management.group_pump_user">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="pump_balance" widget="monetary" options="{'currency_field': 'pump_currency_id'}"/></span>
                        <span class="o_stat_text">Outstanding</span>
                    </div>
                </button>
            </div>
            <notebook position="inside">
                <page string="Fuel Credit" name="pump_credit" groups="zivoit_fuel_management.group_pump_user">
                    <group>
                        <group string="Credit Account">
                            <field name="is_pump_customer"/>
                            <field name="is_pump_supplier"/>
                            <field name="pump_code" invisible="not is_pump_customer"/>
                            <field name="pump_currency_id" invisible="1"/>
                            <field name="pump_credit_limit" invisible="not is_pump_customer"/>
                            <field name="pump_credit_days" invisible="not is_pump_customer"/>
                            <field name="pump_billing_cycle" invisible="not is_pump_customer"/>
                            <field name="pump_block_on_limit" invisible="not is_pump_customer"/>
                        </group>
                        <group string="Position" invisible="not is_pump_customer">
                            <field name="pump_balance"/>
                            <field name="pump_unbilled"/>
                            <field name="pump_exposure"/>
                            <field name="pump_available_credit" decoration-danger="pump_available_credit &lt; 0"
                                   decoration-success="pump_available_credit &gt;= 0"/>
                            <field name="pump_over_limit" invisible="1"/>
                            <field name="pump_overdue_amount"/>
                            <field name="pump_risk_grade" widget="badge" decoration-success="pump_risk_grade == 'A'"
                                   decoration-info="pump_risk_grade == 'B'" decoration-warning="pump_risk_grade == 'C'"
                                   decoration-danger="pump_risk_grade == 'D'"/>
                            <field name="pump_risk_score"/>
                            <field name="pump_suggested_limit"/>
                        </group>
                    </group>
                    <div class="d-flex flex-wrap gap-2 mb-3" invisible="not is_pump_customer">
                        <button name="action_pump_receipt" type="object" string="Receive Payment" class="btn-primary" icon="fa-inr"/>
                        <button name="action_pump_ledger" type="object" string="Ledger / Statement" class="btn-secondary" icon="fa-book"/>
                        <button name="action_pump_opening_balance" type="object" string="Opening Balance" class="btn-secondary"
                                groups="zivoit_fuel_management.group_pump_manager"/>
                        <button name="action_pump_portal_access" type="object" string="Portal Login" class="btn-secondary"
                                icon="fa-key" groups="zivoit_fuel_management.group_pump_manager"/>
                    </div>
                    <field name="pump_vehicle_ids" invisible="not is_pump_customer">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="vehicle_type"/>
                            <field name="product_id"/>
                            <field name="tank_capacity"/>
                            <field name="driver_name"/>
                            <field name="month_qty" optional="show"/>
                            <field name="avg_kmpl" optional="show"/>
                            <field name="last_fill_date" optional="show"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

    <record id="view_partner_pump_list" model="ir.ui.view">
        <field name="name">res.partner.pump.list</field>
        <field name="model">res.partner</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <list decoration-danger="pump_over_limit">
                <field name="pump_code"/>
                <field name="name"/>
                <field name="phone" optional="show"/>
                <field name="city" optional="hide"/>
                <field name="pump_currency_id" column_invisible="1"/>
                <field name="pump_credit_limit" widget="monetary" options="{'currency_field': 'pump_currency_id'}"/>
                <field name="pump_balance" widget="monetary" options="{'currency_field': 'pump_currency_id'}"/>
                <field name="pump_unbilled" widget="monetary" options="{'currency_field': 'pump_currency_id'}"/>
                <field name="pump_available_credit" widget="monetary" options="{'currency_field': 'pump_currency_id'}"/>
                <field name="pump_overdue_amount" optional="show"/>
                <field name="pump_risk_grade" widget="badge" optional="show" decoration-success="pump_risk_grade == 'A'"
                       decoration-info="pump_risk_grade == 'B'" decoration-warning="pump_risk_grade == 'C'"
                       decoration-danger="pump_risk_grade == 'D'"/>
                <field name="pump_suggested_limit" optional="hide"/>
                <field name="pump_billing_cycle" optional="hide"/>
                <field name="pump_over_limit" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_partner_pump_kanban" model="ir.ui.view">
        <field name="name">res.partner.pump.kanban</field>
        <field name="model">res.partner</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="pump_over_limit"/>
                <field name="pump_currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <field name="name" class="fw-bold fs-6"/>
                                <div class="text-muted small"><field name="pump_code"/> · <field name="phone"/></div>
                            </div>
                            <span t-if="record.pump_over_limit.raw_value" class="badge text-bg-danger">Over limit</span>
                        </div>
                        <div class="row mt-2 small">
                            <div class="col-6">Outstanding<br/><field name="pump_balance" widget="monetary" class="fw-bold"/></div>
                            <div class="col-6 text-end">Limit<br/><field name="pump_credit_limit" widget="monetary"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_partner_pump_search" model="ir.ui.view">
        <field name="name">res.partner.pump.search</field>
        <field name="model">res.partner</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', '|', ('name', 'ilike', self), ('pump_code', 'ilike', self), ('phone', 'ilike', self)]"/>
                <field name="pump_vehicle_ids" string="Vehicle"/>
                <filter name="over_limit" string="Over Credit Limit" domain="[('pump_over_limit', '=', True)]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="g_cycle" string="Billing Cycle" context="{'group_by': 'pump_billing_cycle'}"/>
                    <filter name="g_city" string="City" context="{'group_by': 'city'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pump_customer" model="ir.actions.act_window">
        <field name="name">Credit Customers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('is_pump_customer', '=', True)]</field>
        <field name="context">{'default_is_pump_customer': True, 'default_is_company': True}</field>
        <field name="search_view_id" ref="view_partner_pump_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_partner_pump_list')}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_partner_pump_kanban')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('base.view_partner_form')})]"/>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Create your first credit customer</p>
            <p>Set a credit limit, register vehicles and give the customer a portal login.</p></field>
    </record>

    <record id="action_pump_supplier" model="ir.actions.act_window">
        <field name="name">Suppliers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_pump_supplier', '=', True)]</field>
        <field name="context">{'default_is_pump_supplier': True, 'default_is_company': True}</field>
    </record>

    <record id="view_pump_vehicle_list" model="ir.ui.view">
        <field name="name">pump.vehicle.list</field>
        <field name="model">pump.vehicle</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="vehicle_type"/>
                <field name="product_id"/>
                <field name="tank_capacity"/>
                <field name="driver_name"/>
                <field name="fill_count"/>
                <field name="month_qty"/>
                <field name="month_amount"/>
                <field name="avg_kmpl"/>
                <field name="last_fill_date"/>
            </list>
        </field>
    </record>

    <record id="action_pump_vehicle" model="ir.actions.act_window">
        <field name="name">Customer Vehicles</field>
        <field name="res_model">pump.vehicle</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
