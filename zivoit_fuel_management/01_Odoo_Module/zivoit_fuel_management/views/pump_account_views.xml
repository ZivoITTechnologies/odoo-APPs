<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pump_account_list" model="ir.ui.view">
        <field name="name">pump.account.list</field>
        <field name="model">pump.account</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="account_type"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="balance"/>
                <button name="action_view_entries" type="object" icon="fa-list" title="Entries"/>
            </list>
        </field>
    </record>
    <record id="view_pump_account_form" model="ir.ui.view">
        <field name="name">pump.account.form</field>
        <field name="model">pump.account</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_entries" type="object" class="oe_stat_button" icon="fa-list">
                            <div class="o_stat_info"><span class="o_stat_text">Entries</span></div>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="account_type"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="balance"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Notes"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_pump_account" model="ir.actions.act_window">
        <field name="name">Chart of Accounts</field>
        <field name="res_model">pump.account</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_pump_voucher_list" model="ir.ui.view">
        <field name="name">pump.voucher.list</field>
        <field name="model">pump.voucher</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'" decoration-muted="state == 'cancel'">
                <field name="date"/>
                <field name="name"/>
                <field name="voucher_type"/>
                <field name="partner_id"/>
                <field name="ref" optional="show"/>
                <field name="payment_mode" optional="hide"/>
                <field name="cheque_no" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount" sum="Total"/>
                <field name="state" widget="badge" decoration-success="state == 'posted'"/>
            </list>
        </field>
    </record>

    <record id="view_pump_voucher_form" model="ir.ui.view">
        <field name="name">pump.voucher.form</field>
        <field name="model">pump.voucher</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_post" type="object" string="Post" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state != 'posted' or origin_model"
                            groups="zivoit_fuel_management.group_pump_manager"/>
                    <button name="action_draft" type="object" string="Reset to Draft" invisible="state != 'cancel' or origin_model"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="voucher_type" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="shift_id"/>
                        </group>
                        <group>
                            <field name="payment_mode" readonly="state != 'draft'"/>
                            <field name="cheque_no" readonly="state != 'draft'"/>
                            <field name="ref" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount"/>
                            <field name="origin_model" invisible="1"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state != 'draft'">
                        <list editable="bottom">
                            <field name="account_id"/>
                            <field name="partner_id"/>
                            <field name="name"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="debit" sum="Debit"/>
                            <field name="credit" sum="Credit"/>
                        </list>
                    </field>
                    <field name="narration" placeholder="Narration..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_pump_voucher_search" model="ir.ui.view">
        <field name="name">pump.voucher.search</field>
        <field name="model">pump.voucher</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="ref"/>
                <field name="cheque_no"/>
                <filter name="receipt" string="Receipts" domain="[('voucher_type', '=', 'receipt')]"/>
                <filter name="payment" string="Payments" domain="[('voucher_type', '=', 'payment')]"/>
                <filter name="journal" string="Journals" domain="[('voucher_type', '=', 'journal')]"/>
                <filter name="auto" string="Shift / Bill / Purchase" domain="[('voucher_type', 'in', ('shift', 'sale', 'purchase'))]"/>
                <separator/>
                <filter name="posted" string="Posted" domain="[('state', '=', 'posted')]"/>
                <filter name="date" string="Date" date="date"/>
                <group>
                    <filter name="g_type" string="Type" context="{'group_by': 'voucher_type'}"/>
                    <filter name="g_day" string="Day" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pump_voucher" model="ir.actions.act_window">
        <field name="name">All Vouchers</field>
        <field name="res_model">pump.voucher</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_pump_voucher_journal" model="ir.actions.act_window">
        <field name="name">Journal Voucher</field>
        <field name="res_model">pump.voucher</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('voucher_type', 'in', ('journal', 'opening'))]</field>
        <field name="context">{'default_voucher_type': 'journal'}</field>
    </record>

    <!-- Ledger entries -->
    <record id="view_pump_voucher_line_list" model="ir.ui.view">
        <field name="name">pump.voucher.line.list</field>
        <field name="model">pump.voucher.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="date"/>
                <field name="voucher_id"/>
                <field name="voucher_type"/>
                <field name="account_id"/>
                <field name="partner_id"/>
                <field name="name"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="debit" sum="Debit"/>
                <field name="credit" sum="Credit"/>
                <field name="balance" sum="Balance"/>
            </list>
        </field>
    </record>
    <record id="view_voucher_line_ledger_list" model="ir.ui.view">
        <field name="name">pump.voucher.line.ledger</field>
        <field name="model">pump.voucher.line</field>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" default_order="date, id">
                <field name="date"/>
                <field name="voucher_id"/>
                <field name="voucher_type"/>
                <field name="name"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="debit" sum="Debit"/>
                <field name="credit" sum="Credit"/>
                <field name="balance" sum="Net"/>
            </list>
        </field>
    </record>
    <record id="view_pump_voucher_line_search" model="ir.ui.view">
        <field name="name">pump.voucher.line.search</field>
        <field name="model">pump.voucher.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="account_id"/>
                <field name="partner_id"/>
                <field name="voucher_id"/>
                <filter name="posted" string="Posted" domain="[('state', '=', 'posted')]"/>
                <filter name="date" string="Date" date="date"/>
                <separator/>
                <filter name="pl" string="Income &amp; Expense" domain="[('account_type', 'in', ('income', 'expense'))]"/>
                <filter name="bs" string="Balance Sheet" domain="[('account_type', 'not in', ('income', 'expense'))]"/>
                <group>
                    <filter name="g_type" string="Account Group" context="{'group_by': 'account_type'}"/>
                    <filter name="g_account" string="Account" context="{'group_by': 'account_id'}"/>
                    <filter name="g_partner" string="Party" context="{'group_by': 'partner_id'}"/>
                    <filter name="g_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_pump_voucher_line_pivot" model="ir.ui.view">
        <field name="name">pump.voucher.line.pivot</field>
        <field name="model">pump.voucher.line</field>
        <field name="arch" type="xml">
            <pivot string="Trial Balance">
                <field name="account_type" type="row"/>
                <field name="account_id" type="row"/>
                <field name="debit" type="measure"/>
                <field name="credit" type="measure"/>
                <field name="balance" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="action_pump_trial_pivot" model="ir.actions.act_window">
        <field name="name">Account Balances (Pivot)</field>
        <field name="res_model">pump.voucher.line</field>
        <field name="view_mode">pivot,list</field>
        <field name="context">{'search_default_posted': 1}</field>
    </record>
    <record id="action_pump_daybook" model="ir.actions.act_window">
        <field name="name">Day Book</field>
        <field name="res_model">pump.voucher.line</field>
        <field name="view_mode">list,pivot</field>
        <field name="context">{'search_default_posted': 1}</field>
    </record>
    <record id="action_pump_outstanding" model="ir.actions.act_window">
        <field name="name">Customer Outstanding</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_pump_customer', '=', True)]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_partner_pump_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('base.view_partner_form')})]"/>
        <field name="search_view_id" ref="view_partner_pump_search"/>
    </record>
</odoo>
