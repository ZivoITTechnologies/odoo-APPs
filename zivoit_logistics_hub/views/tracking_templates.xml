<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="tracking_layout" name="Logistics Hub: tracking layout">
        <t t-out="doctype"/>
        <html lang="en">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <meta name="robots" content="noindex"/>
                <title t-esc="title or 'Track your shipment'"/>
                <style>
                    :root { --bg:#f6f7fb; --card:#fff; --ink:#1d2433; --muted:#6b7280; --brand:#1f6feb; --ok:#16a34a; --warn:#d97706; --line:#e5e7eb; }
                    @media (prefers-color-scheme: dark) { :root { --bg:#0f1218; --card:#171b23; --ink:#e7eaf0; --muted:#9aa3b2; --line:#2a303b; } }
                    * { box-sizing: border-box; }
                    body { margin:0; font-family: -apple-system, Segoe UI, Roboto, Arial, sans-serif; background:var(--bg); color:var(--ink); }
                    .wrap { max-width: 720px; margin: 0 auto; padding: 24px 16px 48px; }
                    .card { background:var(--card); border:1px solid var(--line); border-radius:14px; padding:20px; margin-bottom:16px; }
                    .muted { color:var(--muted); font-size:14px; }
                    h1 { font-size:22px; margin:0 0 4px; } h2 { font-size:16px; margin:0 0 12px; }
                    .status { font-size:26px; font-weight:700; margin:8px 0; }
                    .alert { color:var(--warn); }
                    .steps { display:flex; gap:6px; margin-top:14px; }
                    .step { flex:1; text-align:center; font-size:12px; color:var(--muted); }
                    .bar { height:6px; border-radius:3px; background:var(--line); margin-bottom:6px; }
                    .done .bar { background:var(--ok); } .done { color:var(--ink); } .current { font-weight:700; }
                    ul.tl { list-style:none; padding:0; margin:0; }
                    ul.tl li { border-left:2px solid var(--line); padding:0 0 14px 14px; position:relative; }
                    ul.tl li:before { content:''; width:10px; height:10px; border-radius:50%; background:var(--brand); position:absolute; left:-6px; top:4px; }
                    .grid { display:grid; grid-template-columns: 1fr 1fr; gap:10px 16px; font-size:14px; }
                    input { width:100%; padding:10px; border:1px solid var(--line); border-radius:8px; background:var(--bg); color:var(--ink); margin:6px 0 12px; font-size:15px; }
                    button { background:var(--brand); color:#fff; border:0; border-radius:8px; padding:10px 18px; font-size:15px; cursor:pointer; }
                    .foot { text-align:center; font-size:12px; color:var(--muted); margin-top:24px; }
                </style>
            </head>
            <body><div class="wrap"><t t-out="0"/>
                <div class="foot">Powered by ZivoIT Logistics Hub</div></div></body>
        </html>
    </template>

    <template id="tracking_page" name="Logistics Hub: tracking page">
        <t t-call="zivoit_logistics_hub.tracking_layout">
            <t t-set="title" t-value="'Shipment %s' % (shipment.tracking_number or '')"/>
            <div class="card">
                <div class="muted" t-esc="company.name"/>
                <h1>Order <t t-esc="shipment.sale_id.name or shipment.name"/></h1>
                <div t-attf-class="status #{'alert' if alert else ''}" t-esc="state_label"/>
                <div class="muted" t-if="shipment.status_description" t-esc="shipment.status_description"/>
                <div class="muted" t-if="promise and shipment.state not in ('delivered', 'cancelled', 'rto_delivered')">
                    Expected delivery: <b t-esc="promise"/>
                </div>
                <div class="muted" t-if="delivered_on">Delivered on <b t-esc="delivered_on"/></div>
                <div class="steps">
                    <t t-foreach="steps" t-as="step">
                        <div t-attf-class="step #{'done' if step['done'] else ''} #{'current' if step['current'] else ''}">
                            <div class="bar"/><t t-esc="step['label']"/>
                        </div>
                    </t>
                </div>
            </div>
            <div class="card">
                <div class="grid">
                    <div><div class="muted">Courier</div><t t-esc="shipment.courier_name or shipment.account_id.provider_label"/></div>
                    <div><div class="muted">AWB</div><t t-esc="shipment.tracking_number"/></div>
                    <div><div class="muted">Destination</div><t t-esc="shipment.dest_city"/> <t t-esc="shipment.dest_zip"/></div>
                    <div><div class="muted">Payment</div><t t-esc="'Cash on delivery' if shipment.payment_mode == 'cod' else 'Prepaid'"/></div>
                </div>
            </div>
            <div class="card">
                <h2>Shipment history</h2>
                <ul class="tl">
                    <t t-foreach="events" t-as="ev">
                        <li>
                            <div><b t-esc="ev['label']"/> <span class="muted" t-if="ev['location']">| <t t-esc="ev['location']"/></span></div>
                            <div class="muted"><t t-esc="ev['when']"/><t t-if="ev['description']"> - <t t-esc="ev['description']"/></t></div>
                        </li>
                    </t>
                </ul>
                <p class="muted" t-if="not events">No scans yet. Updates appear as soon as the courier scans the parcel.</p>
            </div>
        </t>
    </template>

    <template id="tracking_lookup" name="Logistics Hub: tracking lookup">
        <t t-call="zivoit_logistics_hub.tracking_layout">
            <t t-set="title" t-value="'Track your shipment'"/>
            <div class="card">
                <h1>Track your shipment</h1>
                <p class="muted">Enter the AWB / tracking number and the last 4 digits of the phone number used for the order.</p>
                <p class="alert" t-if="error" t-esc="error"/>
                <form method="post" action="/logistics/track">
                    <label for="awb">AWB / Tracking number</label>
                    <input id="awb" name="awb" t-att-value="awb or ''" required="required" autocomplete="off"/>
                    <label for="phone">Last 4 digits of phone</label>
                    <input id="phone" name="phone" inputmode="numeric" maxlength="15" required="required"/>
                    <button type="submit">Track</button>
                </form>
            </div>
        </t>
    </template>
</odoo>
