<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_zivo" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.zivo.hub</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="60"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Logistics Hub" string="Logistics Hub" name="zivoit_logistics_hub" groups="zivoit_logistics_hub.group_logistics_manager">
                    <block title="Artificial Intelligence" name="zivo_ai">
                        <setting id="zivo_ai_provider" string="AI Provider"
                                 help="The built-in engine (RTO risk, carrier ranking, address checks, status and NDR classification) works without any key. Add an LLM for richer NDR messages, AI address repair and natural-language search.">
                            <field name="zivo_ai_provider"/>
                            <div class="mt-2" invisible="zivo_ai_provider == 'local'">
                                <label for="zivo_ai_api_key" class="o_light_label"/>
                                <field name="zivo_ai_api_key" password="True"/>
                                <label for="zivo_ai_model" class="o_light_label"/>
                                <field name="zivo_ai_model" placeholder="Default model of the provider"/>
                                <div invisible="zivo_ai_provider != 'openai_compatible'">
                                    <label for="zivo_ai_base_url" class="o_light_label"/>
                                    <field name="zivo_ai_base_url" placeholder="https://your-endpoint/v1"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Tracking &amp; Notifications" name="zivo_tracking">
                        <setting id="zivo_track_interval" string="Tracking refresh" help="Minimum hours between two tracking calls for the same open shipment.">
                            <field name="zivo_track_interval_hours"/>
                        </setting>
                        <setting id="zivo_notify" help="Send branded emails with the public tracking link when a shipment is out for delivery, delivered or fails delivery.">
                            <field name="zivo_notify_customer"/>
                        </setting>
                        <setting id="zivo_logs" string="API log retention" help="Days to keep courier API logs.">
                            <field name="zivo_log_retention_days"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_zivo_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'zivoit_logistics_hub', 'bin_size': False}</field>
    </record>
</odoo>
