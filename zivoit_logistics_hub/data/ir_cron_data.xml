<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_track_shipments" model="ir.cron">
        <field name="name">Logistics Hub: Track open shipments</field>
        <field name="model_id" ref="model_zivo_logistics_shipment"/>
        <field name="state">code</field>
        <field name="code">model._cron_track()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_process_jobs" model="ir.cron">
        <field name="name">Logistics Hub: Process job queue</field>
        <field name="model_id" ref="model_zivo_logistics_queue_job"/>
        <field name="state">code</field>
        <field name="code">model._cron_process()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_purge_logs" model="ir.cron">
        <field name="name">Logistics Hub: Purge API logs</field>
        <field name="model_id" ref="model_zivo_logistics_api_log"/>
        <field name="state">code</field>
        <field name="code">model._cron_purge()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
