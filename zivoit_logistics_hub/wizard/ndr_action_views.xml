<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zivo_ndr_action_form" model="ir.ui.view">
        <field name="name">zivo.logistics.ndr.action.form</field>
        <field name="model">zivo.logistics.ndr.action</field>
        <field name="arch" type="xml">
            <form>
                <div class="alert alert-info" role="alert">
                    <div class="fw-bold">Courier reason</div>
                    <field name="ndr_reason" nolabel="1"/>
                    <div class="fw-bold mt-2">AI advice</div>
                    <field name="ndr_advice" nolabel="1"/>
                </div>
                <group>
                    <group>
                        <field name="shipment_id" readonly="1"/>
                        <field name="action" widget="radio"/>
                        <field name="rto_risk" widget="progressbar"/>
                    </group>
                    <group>
                        <field name="reattempt_date" invisible="action not in ('reattempt', 'change_address')"/>
                        <field name="new_address" invisible="action != 'change_address'"/>
                        <field name="new_phone" invisible="action != 'change_address'"/>
                        <field name="comments"/>
                    </group>
                </group>
                <group string="Customer message">
                    <field name="message" nolabel="1" colspan="2"/>
                    <field name="send_message"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
