<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zivo_rate_shop_form" model="ir.ui.view">
        <field name="name">zivo.logistics.rate.shop.form</field>
        <field name="model">zivo.logistics.rate.shop</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="picking_id" readonly="1"/>
                        <field name="carrier_id" options="{'no_create': True}"/>
                        <field name="strategy" widget="radio" options="{'horizontal': true}"/>
                        <field name="weight_text"/>
                    </group>
                    <group>
                        <field name="rto_risk" widget="progressbar"/>
                        <field name="rto_risk_level" widget="badge" decoration-danger="rto_risk_level == 'high'"
                               decoration-warning="rto_risk_level == 'medium'" decoration-success="rto_risk_level == 'low'"/>
                        <field name="address_score" widget="progressbar"/>
                    </group>
                </group>
                <div class="alert alert-warning" role="alert" invisible="not rto_risk_reasons and not address_issues">
                    <div invisible="not rto_risk_reasons"><b>RTO risk drivers</b><field name="rto_risk_reasons" nolabel="1"/></div>
                    <div invisible="not address_issues"><b>Address issues</b><field name="address_issues" nolabel="1"/></div>
                </div>
                <field name="line_ids" nolabel="1">
                    <list create="0" delete="0" decoration-success="recommended" decoration-bf="recommended">
                        <field name="rank" string="#"/>
                        <field name="account_id"/>
                        <field name="service_name"/>
                        <field name="courier_name" optional="show"/>
                        <field name="price"/>
                        <field name="tat_days"/>
                        <field name="reliability" optional="show"/>
                        <field name="ai_score" widget="progressbar"/>
                        <field name="reasons"/>
                        <field name="rate_source" optional="hide"/>
                        <field name="recommended" column_invisible="1"/>
                        <button name="action_select" type="object" string="Select" class="btn-link"/>
                        <button name="action_ship" type="object" string="Ship" class="btn-primary"/>
                        <button name="action_ship_force" type="object" string="Ship anyway" class="btn-link text-danger"
                                confirm="Ship despite the AI risk / address warnings?"/>
                    </list>
                </field>
                <div invisible="not errors" class="text-muted">
                    <b>Unavailable carriers</b>
                    <field name="errors" nolabel="1"/>
                </div>
                <details class="mt-3">
                    <summary>AI address repair</summary>
                    <group>
                        <field name="suggested_street"/>
                        <field name="suggested_street2"/>
                        <field name="suggested_city"/>
                        <field name="suggested_zip"/>
                        <field name="suggestion_notes"/>
                    </group>
                    <button name="action_ai_fix_address" type="object" string="Suggest with AI" class="btn-secondary"/>
                    <button name="action_apply_address" type="object" string="Apply to customer" class="btn-link"
                            invisible="not suggested_street and not suggested_zip"/>
                </details>
                <footer>
                    <button name="action_recompute" type="object" string="Refresh Rates" class="btn-secondary"/>
                    <button string="Close" special="cancel" class="btn-link"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
