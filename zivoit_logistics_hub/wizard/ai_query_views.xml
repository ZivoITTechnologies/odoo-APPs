<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zivo_ai_query_form" model="ir.ui.view">
        <field name="name">zivo.logistics.ai.query.form</field>
        <field name="model">zivo.logistics.ai.query</field>
        <field name="arch" type="xml">
            <form>
                <p class="text-muted">Ask in plain language, e.g. "delayed COD shipments to Hyderabad this week",
                    "high risk orders via Delhivery", "NDR today", "weight disputes this month".</p>
                <field name="question" placeholder="Ask about your shipments..."/>
                <footer>
                    <button name="action_search" type="object" string="Search" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_zivo_ai_query" model="ir.actions.act_window">
        <field name="name">Ask Logistics AI</field>
        <field name="res_model">zivo.logistics.ai.query</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
