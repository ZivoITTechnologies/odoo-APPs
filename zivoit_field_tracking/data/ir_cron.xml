<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_purge_points" model="ir.cron">
            <field name="name">Field Tracking: purge old location history</field>
            <field name="model_id" ref="model_zivo_track_point"/>
            <field name="state">code</field>
            <field name="code">model._cron_purge_old_points()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_close_days" model="ir.cron">
            <field name="name">Field Tracking: close unfinished day logs</field>
            <field name="model_id" ref="model_zivo_track_session"/>
            <field name="state">code</field>
            <field name="code">model._cron_close_stale_days()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
