        <record id="expense_policy_default" model="zivo.expense.policy">
            <field name="name">Standard Field Sales Policy</field>
            <field name="is_default" eval="True"/>
            <field name="company_id" ref="base.main_company"/>
            <field name="da_full_amount">400</field>
            <field name="da_full_min_hours">6</field>
            <field name="da_half_amount">200</field>
            <field name="da_half_min_hours">3</field>
            <field name="da_min_visits">1</field>
            <field name="outstation_km">150</field>
            <field name="da_outstation_amount">800</field>
            <field name="km_tolerance_pct">10</field>
            <field name="location_check_km">2</field>
            <field name="rate_ids" eval="[
                (0, 0, {'vehicle_type': 'two_wheeler', 'rate_per_km': 3.5, 'max_km_per_day': 150}),
                (0, 0, {'vehicle_type': 'four_wheeler', 'rate_per_km': 9.0, 'max_km_per_day': 300}),
                (0, 0, {'vehicle_type': 'public', 'rate_per_km': 0.0}),
                (0, 0, {'vehicle_type': 'company', 'rate_per_km': 0.0}),
            ]"/>
            <field name="note" type="html"><p>Mileage is paid on the distance measured by GPS (own vehicle only).
Daily allowance depends on the hours spent in the field and needs at least one customer visit.
Fuel bills are not reimbursed on days paid with mileage. Upload a photo of every bill above the limit.</p></field>
        </record>
        <record id="cron_monthly_claims" model="ir.cron">
            <field name="name">Field Tracking: prepare monthly expense claims</field>
            <field name="model_id" ref="model_zivo_expense_claim"/>
            <field name="state">code</field>
            <field name="code">model._cron_create_monthly_claims()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
