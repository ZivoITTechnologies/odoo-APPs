        <record id="seq_expense_claim" model="ir.sequence">
            <field name="name">Field Expense Claim</field>
            <field name="code">zivo.expense.claim</field>
            <field name="prefix">FEC/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

