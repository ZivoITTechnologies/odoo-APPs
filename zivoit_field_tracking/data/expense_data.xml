        <record id="expense_category_ta" model="zivo.expense.category">
            <field name="name">Mileage (TA)</field>
            <field name="code">TA</field>
            <field name="sequence">1</field>
            <field name="line_type">travel</field>
            <field name="product_id" ref="product_expense_ta"/>
            <field name="icon">🛵</field>
            <field name="receipt_policy">never</field>
            <field name="receipt_threshold">0</field>
            <field name="daily_limit">0</field>
            <field name="conflicts_with_mileage" eval="False"/>
