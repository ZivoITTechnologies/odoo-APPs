<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="zivo_expense_claim_view_list" model="ir.ui.view">
        <field name="name">zivo.expense.claim.list</field>
        <field name="model">zivo.expense.claim</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'" decoration-danger="state == 'rejected'"
                  decoration-info="state == 'submitted'" sample="1">
                <field name="name"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="day_count" optional="show"/>
                <field name="tracked_km" optional="show" sum="km"/>
                <field name="travel_amount" optional="show" sum="TA"/>
                <field name="daily_amount" optional="show" sum="DA"/>
                <field name="expense_amount" optional="show" sum="Bills"/>
                <field name="total_amount" sum="Total" decoration-bf="1"/>
                <field name="currency_id" optional="show" options="{'no_open': True}"/>
                <field name="warning_count" optional="show" decoration-warning="warning_count &gt; 0"/>
                <field name="approver_id" widget="many2one_avatar_user" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'submitted'"
                       decoration-success="state in ('approved', 'posted')" decoration-danger="state == 'rejected'"/>
                <field name="payment_state" widget="badge" optional="show" decoration-success="payment_state == 'paid'"
                       decoration-warning="payment_state in ('to_pay', 'in_payment')"/>
            </list>
        </field>
    </record>

    <record id="zivo_expense_claim_view_form" model="ir.ui.view">
        <field name="name">zivo.expense.claim.form</field>
        <field name="model">zivo.expense.claim</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit for Approval" class="btn-primary"
                            invisible="state not in ('draft', 'rejected')" data-hotkey="s"/>
                    <button name="action_refresh" type="object" string="Refresh from GPS" icon="fa-refresh"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="state != 'submitted' or not can_approve" data-hotkey="a"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state not in ('submitted', 'approved') or not can_approve"/>
                    <button name="action_post_expenses" type="object" string="Send to Odoo Expenses" class="btn-primary"
                            invisible="state != 'approved' or not can_approve"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state not in ('submitted', 'rejected', 'cancel')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'submitted', 'rejected')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,posted"/>
                </header>
                <div class="alert alert-danger mb-0" role="alert" invisible="state != 'rejected'">
                    <strong>Rejected:</strong> <field name="reject_reason" readonly="1" class="d-inline"/>
                </div>
                <div class="alert alert-warning mb-0" role="alert" invisible="warning_count == 0 or state in ('posted', 'cancel')">
                    <i class="fa fa-exclamation-triangle me-1" title="Warning"/>
                    <field name="warning_count" class="d-inline fw-bold"/> line(s) break the expense policy - check the
                    <b>Warnings</b> column before approving.
                </div>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sessions" type="object" class="oe_stat_button" icon="fa-map-marker">
                            <field name="day_count" widget="statinfo" string="Field Days"/>
                        </button>
                        <button name="action_view_warnings" type="object" class="oe_stat_button" icon="fa-exclamation-triangle"
                                invisible="warning_count == 0">
                            <field name="warning_count" widget="statinfo" string="Warnings"/>
                        </button>
                        <button name="action_view_expenses" type="object" class="oe_stat_button" icon="fa-money"
                                invisible="payment_state == 'none'">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="payment_state" readonly="1"/></span>
                                <span class="o_stat_text">Odoo Expenses</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Paid" bg_color="text-bg-success" invisible="payment_state != 'paid'"/>
                    <div class="oe_title">
                        <span class="o_form_label">Field Expense Claim</span>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Claim">
                            <field name="user_id" widget="many2one_avatar_user" readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="employee_id" readonly="state != 'draft'" placeholder="Needed to reimburse in Odoo Expenses"/>
                            <label for="date_from" string="Period"/>
                            <div class="o_row">
                                <field name="date_from" readonly="state != 'draft'"/>
                                <i class="fa fa-long-arrow-right mx-2" aria-label="to" title="to"/>
                                <field name="date_to" readonly="state != 'draft'"/>
                            </div>
                            <field name="approver_id" widget="many2one_avatar_user" readonly="state not in ('draft', 'submitted')"
                                   options="{'no_create': True}"/>
                            <field name="policy_id"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="can_approve" invisible="1"/>
                            <field name="currency_id" options="{'no_open': True}"/>
                        </group>
                        <group string="Summary">
                            <field name="tracked_km" string="GPS Tracked km"/>
                            <field name="claimed_km"/>
                            <field name="travel_amount"/>
                            <field name="daily_amount"/>
                            <field name="expense_amount"/>
                            <field name="total_amount" class="fs-4 fw-bold"/>
                            <field name="receipt_count"/>
                            <field name="payment_state" widget="badge"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Expense Lines" name="lines">
                            <field name="line_ids" readonly="state not in ('draft', 'rejected')"
                                   context="{'default_user_id': user_id, 'default_company_id': company_id, 'default_date': date_to}">
                                <list editable="bottom" decoration-warning="has_warning" default_order="date, line_type desc">
                                    <field name="date" readonly="source == 'auto'"/>
                                    <field name="category_id" readonly="source == 'auto'" options="{'no_create': True}"
                                           domain="[('line_type', '=', 'expense')]"/>
                                    <field name="name"/>
                                    <field name="tracked_km" optional="show" invisible="line_type != 'travel'"/>
                                    <field name="quantity" string="Claimed km / Qty" invisible="line_type == 'daily'"
                                           readonly="line_type == 'expense'"/>
                                    <field name="unit_amount" string="Rate / Amount" readonly="source == 'auto'"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="receipt" widget="image" options="{'size': [36, 36]}" optional="show"
                                           invisible="line_type != 'expense'"/>
                                    <field name="has_receipt" column_invisible="1"/>
                                    <field name="warning_text" string="Warnings" class="text-warning" optional="show"/>
                                    <field name="has_warning" column_invisible="1"/>
                                    <field name="line_type" column_invisible="1"/>
                                    <field name="source" optional="hide"/>
                                    <field name="captured_offline" optional="hide"/>
                                    <field name="user_id" column_invisible="1"/>
                                    <field name="company_id" column_invisible="1"/>
                                    <button name="action_open_line" type="object" icon="fa-search-plus" title="Open"
                                            class="btn-link"/>
                                </list>
                            </field>
                        </page>
                        <page string="Day Logs" name="days">
                            <field name="session_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="vehicle_type"/>
                                    <field name="distance_km" sum="km"/>
                                    <field name="duration_hours" widget="float_time"/>
                                    <field name="visit_count"/>
                                    <field name="offline_point_count"/>
                                    <field name="mock_point_count" decoration-danger="mock_point_count &gt; 0"/>
                                    <field name="ta_amount" sum="TA"/>
                                    <field name="da_kind"/>
                                    <field name="da_amount" sum="DA"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <button name="action_open_route" type="object" string="Route" icon="fa-map" class="btn-link"/>
                                </list>
                            </field>
                        </page>
                        <page string="Remarks" name="remarks">
                            <field name="note" placeholder="Remarks for the approver…"/>
                            <group string="Approval" invisible="not submitted_date">
                                <field name="submitted_date"/>
                                <field name="approved_by_id" invisible="not approved_by_id"/>
                                <field name="approved_date" invisible="not approved_date"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="zivo_expense_claim_view_search" model="ir.ui.view">
        <field name="name">zivo.expense.claim.search</field>
        <field name="model">zivo.expense.claim</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_id"/>
                <field name="approver_id"/>
                <filter name="my" string="My Claims" domain="[('user_id', '=', uid)]"/>
                <filter name="to_approve" string="To Approve" domain="[('state', '=', 'submitted')]"/>
                <filter name="my_approvals" string="Waiting My Approval"
                        domain="[('state', '=', 'submitted'), ('approver_id', '=', uid)]"/>
                <filter name="with_warnings" string="With Warnings" domain="[('warning_count', '&gt;', 0)]"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="approved" string="Approved" domain="[('state', 'in', ('approved', 'posted'))]"/>
                <filter name="unpaid" string="Not Paid Yet" domain="[('state', '=', 'posted'), ('payment_state', '!=', 'paid')]"/>
                <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter name="date_from" string="Period" date="date_from"/>
                <group>
                    <filter name="group_user" string="Salesperson" context="{'group_by': 'user_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date_from:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="zivo_expense_claim_view_pivot" model="ir.ui.view">
        <field name="name">zivo.expense.claim.pivot</field>
        <field name="model">zivo.expense.claim</field>
        <field name="arch" type="xml">
            <pivot string="Expense Claims">
                <field name="user_id" type="row"/>
                <field name="date_from" interval="month" type="col"/>
                <field name="total_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="zivo_expense_claim_view_graph" model="ir.ui.view">
        <field name="name">zivo.expense.claim.graph</field>
        <field name="model">zivo.expense.claim</field>
        <field name="arch" type="xml">
            <graph string="Expense Claims" type="bar" stacked="1">
                <field name="user_id"/>
                <field name="travel_amount" type="measure"/>
                <field name="daily_amount" type="measure"/>
                <field name="expense_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="zivo_expense_claim_action" model="ir.actions.act_window">
        <field name="name">Expense Claims</field>
        <field name="res_model">zivo.expense.claim</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="context">{'search_default_my': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No expense claim yet</p>
            <p>Create a claim for a period: mileage and daily allowance are calculated from the GPS day logs,
               bills captured on the phone are added automatically.</p>
        </field>
    </record>

    <record id="zivo_expense_claim_approve_action" model="ir.actions.act_window">
        <field name="name">Claims to Approve</field>
        <field name="res_model">zivo.expense.claim</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="context">{'search_default_to_approve': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing to approve</p>
            <p>Submitted claims of your team appear here.</p>
        </field>
    </record>

    <!-- wizards -->
    <record id="zivo_expense_claim_wizard_view_form" model="ir.ui.view">
        <field name="name">zivo.expense.claim.wizard.form</field>
        <field name="model">zivo.expense.claim.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Expense Claims">
                <p class="text-muted">
                    Finished GPS day logs of the period become mileage (TA) and daily allowance (DA) lines.
                    Bills captured on the phone and not claimed yet are added.
                </p>
                <group>
                    <label for="date_from" string="Period"/>
                    <div class="o_row">
                        <field name="date_from"/>
                        <i class="fa fa-long-arrow-right mx-2" aria-label="to" title="to"/>
                        <field name="date_to"/>
                    </div>
                    <field name="is_manager" invisible="1"/>
                    <field name="user_ids" widget="many2many_tags_avatar" invisible="not is_manager"
                           placeholder="All selected salespeople get their own claim"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </group>
                <footer>
                    <button name="action_create" type="object" string="Create Claims" class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="zivo_expense_claim_wizard_action" model="ir.actions.act_window">
        <field name="name">Create Expense Claims</field>
        <field name="res_model">zivo.expense.claim.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="zivo_expense_reject_wizard_view_form" model="ir.ui.view">
        <field name="name">zivo.expense.reject.wizard.form</field>
        <field name="model">zivo.expense.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Claim">
                <field name="claim_ids" invisible="1"/>
                <field name="reason" placeholder="Why is the claim rejected? The salesperson is notified."/>
                <footer>
                    <button name="action_reject" type="object" string="Reject" class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
