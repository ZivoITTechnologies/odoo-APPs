<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_qb" model="ir.module.category">
        <field name="name">QuickBooks Connector</field>
        <field name="sequence">60</field>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_qb">
        <field name="name">QuickBooks Connector</field>
        <field name="category_id" ref="module_category_qb"/>
        <field name="sequence">60</field>
    </record>

    <record id="group_qb_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="comment">Can monitor the QuickBooks sync, read logs and retry jobs.</field>
        <field name="privilege_id" ref="res_groups_privilege_qb"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_qb_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="comment">Can configure connections, credentials, mappings and run imports/exports.</field>
        <field name="privilege_id" ref="res_groups_privilege_qb"/>
        <field name="implied_ids" eval="[(4, ref('group_qb_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="account.group_account_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_qb_manager'))]"/>
    </record>

    <!-- multi-company isolation -->
    <record id="rule_qb_connection_company" model="ir.rule">
        <field name="name">QuickBooks connection: multi-company</field>
        <field name="model_id" ref="model_qb_connection"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_qb_mapping_company" model="ir.rule">
        <field name="name">QuickBooks mapping: multi-company</field>
        <field name="model_id" ref="model_qb_mapping"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_qb_job_company" model="ir.rule">
        <field name="name">QuickBooks job: multi-company</field>
        <field name="model_id" ref="model_qb_sync_job"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_qb_log_company" model="ir.rule">
        <field name="name">QuickBooks log: multi-company</field>
        <field name="model_id" ref="model_qb_sync_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_qb_entity_company" model="ir.rule">
        <field name="name">QuickBooks entity settings: multi-company</field>
        <field name="model_id" ref="model_qb_entity_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
