<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_qb_sync" model="ir.cron">
        <field name="name">QuickBooks: Incremental Sync (CDC + exports)</field>
        <field name="model_id" ref="model_qb_connection"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_qb_process_queue" model="ir.cron">
        <field name="name">QuickBooks: Process Sync Queue</field>
        <field name="model_id" ref="model_qb_sync_job"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_queue()</field>
        <field name="interval_number">2</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_qb_tokens" model="ir.cron">
        <field name="name">QuickBooks: Keep OAuth Tokens Alive</field>
        <field name="model_id" ref="model_qb_connection"/>
        <field name="state">code</field>
        <field name="code">model._cron_keep_tokens_alive()</field>
        <field name="interval_number">12</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_qb_cleanup" model="ir.cron">
        <field name="name">QuickBooks: Clean Old Logs and Jobs</field>
        <field name="model_id" ref="model_qb_sync_log"/>
        <field name="state">code</field>
        <field name="code">model._cron_cleanup()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
