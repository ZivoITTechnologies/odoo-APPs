<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_qb" model="ir.ui.view">
        <field name="name">product.template.form.quickbooks</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_qb_export" type="object" class="oe_stat_button" icon="fa-refresh"
                        groups="zivoit_quickbooks_connector.group_qb_user">
                    <div class="o_stat_info">
                        <span class="o_stat_text">QuickBooks</span>
                        <field name="qb_sync_state" readonly="1" class="o_stat_text"/>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
    <record id="action_server_product_qb_export" model="ir.actions.server">
        <field name="name">Send to QuickBooks</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="group_ids" eval="[(4, ref('zivoit_quickbooks_connector.group_qb_user'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_qb_export()</field>
    </record>
</odoo>
