<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_qb" model="ir.ui.view">
        <field name="name">sale.order.form.quickbooks</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_qb_export" type="object" class="oe_stat_button" icon="fa-refresh"
                        groups="zivoit_quickbooks_connector.group_qb_user" invisible="state == 'cancel' and qb_mapping_count == 0">
                    <div class="o_stat_info">
                        <span class="o_stat_text">QuickBooks</span>
                        <field name="qb_sync_state" readonly="1" class="o_stat_text"/>
                    </div>
                </button>
                <field name="qb_mapping_count" invisible="1"/>
            </xpath>
        </field>
    </record>
    <record id="purchase_order_form_qb" model="ir.ui.view">
        <field name="name">purchase.order.form.quickbooks</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_qb_export" type="object" class="oe_stat_button" icon="fa-refresh"
                        groups="zivoit_quickbooks_connector.group_qb_user" invisible="state not in ('purchase',)">
                    <div class="o_stat_info">
                        <span class="o_stat_text">QuickBooks</span>
                        <field name="qb_sync_state" readonly="1" class="o_stat_text"/>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
