<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_qb" model="ir.ui.view">
        <field name="name">account.payment.form.quickbooks</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_qb_view_mappings" type="object" class="oe_stat_button" icon="fa-refresh"
                        groups="zivoit_quickbooks_connector.group_qb_user" invisible="qb_mapping_count == 0">
                    <div class="o_stat_info">
                        <span class="o_stat_text">QuickBooks</span>
                        <field name="qb_sync_state" readonly="1" class="o_stat_text"/>
                    </div>
                </button>
                <button name="action_qb_export" type="object" class="oe_stat_button" icon="fa-cloud-upload"
                        groups="zivoit_quickbooks_connector.group_qb_user"
                        invisible="qb_mapping_count != 0 or state in ('draft', 'canceled')">
                    <span class="o_stat_text">Send to QuickBooks</span>
                </button>
                <field name="qb_mapping_count" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
