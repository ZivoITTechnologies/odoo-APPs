<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_qb_entity_config_list" model="ir.ui.view">
        <field name="name">qb.entity.config.list</field>
        <field name="model">qb.entity.config</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0" delete="0">
                <field name="connection_id"/>
                <field name="name" string="Entity"/>
                <field name="can_import" column_invisible="1"/>
                <field name="can_export" column_invisible="1"/>
                <field name="direction"/>
                <field name="auto_sync" widget="boolean_toggle"/>
                <field name="mapped_count" string="Linked"/>
                <field name="error_count" string="Errors" decoration-danger="error_count > 0"/>
                <field name="last_import"/>
                <field name="last_export"/>
                <button name="action_import_now" type="object" icon="fa-download" title="Import now"
                        invisible="not can_import or direction in ('export', 'none')"/>
                <button name="action_export_now" type="object" icon="fa-upload" title="Export now"
                        invisible="not can_export or direction in ('import', 'none')"/>
            </list>
        </field>
    </record>
    <record id="action_qb_entity_config" model="ir.actions.act_window">
        <field name="name">Entity Sync Settings</field>
        <field name="res_model">qb.entity.config</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
