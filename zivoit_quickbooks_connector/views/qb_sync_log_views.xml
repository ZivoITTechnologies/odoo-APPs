<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_qb_sync_log_list" model="ir.ui.view">
        <field name="name">qb.sync.log.list</field>
        <field name="model">qb.sync.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" decoration-danger="level == 'error'" decoration-warning="level == 'warning'"
                  decoration-success="level == 'success'" decoration-muted="level == 'api'">
                <field name="create_date" string="Date"/>
                <field name="connection_id" optional="hide"/>
                <field name="level" widget="badge"/>
                <field name="direction"/>
                <field name="qb_entity"/>
                <field name="qb_id"/>
                <field name="message"/>
                <field name="response_status" optional="hide"/>
                <field name="duration_ms" optional="hide"/>
                <field name="res_model" column_invisible="1"/>
                <button name="action_open_record" type="object" icon="fa-external-link" title="Open record"
                        invisible="not res_model"/>
            </list>
        </field>
    </record>
    <record id="view_qb_sync_log_form" model="ir.ui.view">
        <field name="name">qb.sync.log.form</field>
        <field name="model">qb.sync.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date"/>
                            <field name="connection_id"/>
                            <field name="level"/>
                            <field name="direction"/>
                            <field name="job_id"/>
                        </group>
                        <group>
                            <field name="qb_entity"/>
                            <field name="qb_id"/>
                            <field name="res_model"/>
                            <field name="res_id"/>
                            <field name="intuit_tid"/>
                        </group>
                    </group>
                    <field name="message"/>
                    <notebook>
                        <page string="Request">
                            <group>
                                <field name="request_method"/>
                                <field name="request_url"/>
                                <field name="duration_ms"/>
                            </group>
                            <field name="request_body" widget="text"/>
                        </page>
                        <page string="Response">
                            <group><field name="response_status"/></group>
                            <field name="response_body" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_qb_sync_log_search" model="ir.ui.view">
        <field name="name">qb.sync.log.search</field>
        <field name="model">qb.sync.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="message"/>
                <field name="qb_id"/>
                <field name="intuit_tid"/>
                <filter name="errors" string="Errors" domain="[('level', '=', 'error')]"/>
                <filter name="warnings" string="Warnings" domain="[('level', '=', 'warning')]"/>
                <filter name="no_api" string="Hide API calls" domain="[('level', '!=', 'api')]"/>
                <filter name="today" string="Last 24h" domain="[('create_date', '&gt;=', (context_today() - relativedelta(days=1)).strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="by_level" string="Level" context="{'group_by': 'level'}"/>
                    <filter name="by_entity" string="Entity" context="{'group_by': 'qb_entity'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_qb_sync_log" model="ir.actions.act_window">
        <field name="name">Sync Logs</field>
        <field name="res_model">qb.sync.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_no_api': 1}</field>
    </record>
</odoo>
