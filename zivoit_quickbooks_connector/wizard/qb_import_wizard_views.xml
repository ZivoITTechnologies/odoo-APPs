<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_qb_import_wizard" model="ir.ui.view">
        <field name="name">qb.import.wizard.form</field>
        <field name="model">qb.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import from QuickBooks">
                <p class="text-muted">Records are imported in dependency order (accounts, taxes, contacts,
                    products, documents, then payments). Existing Odoo records are matched to avoid duplicates.</p>
                <group>
                    <field name="connection_id" readonly="1"/>
                    <field name="mode" widget="radio"/>
                    <field name="entity_ids" widget="many2many_tags" invisible="mode != 'select'"
                           domain="[('connection_id', '=', connection_id), ('can_import', '=', True)]"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="run_now"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Start Import" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
