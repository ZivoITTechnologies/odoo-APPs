<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_moowr" model="ir.ui.view">
        <field name="name">purchase.order.form.moowr</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='button_cancel']" position="before">
                <button name="action_create_moowr_boe" type="object" string="Create Bill of Entry"
                        invisible="not moowr_has_bonded or state not in ('purchase', 'done')"
                        groups="zivoit_moowr.group_moowr_user"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_moowr_boe" type="object" class="oe_stat_button" icon="fa-university"
                        invisible="moowr_boe_count == 0" groups="zivoit_moowr.group_moowr_user">
                    <field name="moowr_boe_count" widget="statinfo" string="Bills of Entry"/>
                </button>
                <field name="moowr_has_bonded" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_qty']" position="before">
                <field name="moowr_bonded" optional="show" groups="zivoit_moowr.group_moowr_user"/>
            </xpath>
        </field>
    </record>
</odoo>
