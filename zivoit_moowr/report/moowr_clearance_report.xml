<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_moowr_clearance_document">
        <t t-call="web.external_layout">
            <t t-set="cur" t-value="o.currency_id"/>
            <div class="page" style="font-size: 9.5pt;">
                <h4>Removal from Bonded Warehouse - <span t-out="o.name"/></h4>
                <table class="table table-sm table-borderless">
                    <tr>
                        <td><strong>Type:</strong> <span t-field="o.clearance_type"/></td>
                        <td><strong>Date:</strong> <span t-out="o.date"/></td>
                        <td><strong>Licence:</strong> <span t-out="o.licence_id.name"/></td>
                    </tr>
                    <tr>
                        <td><strong>Partner:</strong> <span t-out="o.partner_id.name or '-'"/></td>
                        <td><strong>Customs document:</strong> <span t-out="o.document_number or '-'"/></td>
                        <td><strong>Transfer:</strong> <span t-out="o.picking_id.name or '-'"/></td>
                    </tr>
                </table>
                <table class="table table-sm table-bordered">
                    <thead><tr><th>Product</th><th class="text-end">Quantity</th><th>Bill of Entry / Batch</th><th class="text-end">Assessable Value</th><th class="text-end">BCD</th><th class="text-end">SWS</th><th class="text-end">IGST</th><th class="text-end">Interest</th></tr></thead>
                    <tbody>
                        <tr t-foreach="o.ledger_ids" t-as="l">
                            <td t-out="l.product_id.display_name"/>
                            <td class="text-end"><span t-out="l.quantity" t-options="{'widget': 'float', 'precision': 2}"/> <span t-out="l.uom_id.name"/></td>
                            <td t-out="l.boe_id.name or l.batch_id.name"/>
                            <td class="text-end" t-out="l.value" t-options="{'widget': 'monetary', 'display_currency': cur}"/>
                            <td class="text-end" t-out="l.bcd_amount" t-options="{'widget': 'monetary', 'display_currency': cur}"/>
                            <td class="text-end" t-out="l.sws_amount" t-options="{'widget': 'monetary', 'display_currency': cur}"/>
                            <td class="text-end" t-out="l.igst_amount" t-options="{'widget': 'monetary', 'display_currency': cur}"/>
                            <td class="text-end" t-out="l.interest_amount" t-options="{'widget': 'monetary', 'display_currency': cur}"/>
                        </tr>
                    </tbody>
                </table>
                <table class="table table-sm" style="width: 45%; margin-left: auto;">
                    <tr><td>Total duty</td><td class="text-end" t-out="o.amount_duty" t-options="{'widget': 'monetary', 'display_currency': cur}"/></tr>
                    <tr><td>Interest</td><td class="text-end" t-out="o.amount_interest" t-options="{'widget': 'monetary', 'display_currency': cur}"/></tr>
                    <tr><td><strong>Amount payable</strong></td><td class="text-end"><strong t-out="o.amount_payable" t-options="{'widget': 'monetary', 'display_currency': cur}"/></td></tr>
                    <tr t-if="o.duty_forgone"><td>Duty not payable (export, return or destruction)</td><td class="text-end" t-out="o.duty_forgone" t-options="{'widget': 'monetary', 'display_currency': cur}"/></tr>
                </table>
            </div>
        </t>
    </template>

    <template id="report_moowr_clearance">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="zivoit_moowr.report_moowr_clearance_document"/>
            </t>
        </t>
    </template>
</odoo>
