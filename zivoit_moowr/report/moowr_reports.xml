<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_moowr_return" model="ir.actions.report">
        <field name="name">MOOWR Monthly Return</field>
        <field name="model">moowr.return</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">zivoit_moowr.report_moowr_return</field>
        <field name="report_file">zivoit_moowr.report_moowr_return</field>
        <field name="print_report_name">'MOOWR Return - %s' % (object.name)</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
        <field name="binding_model_id" ref="model_moowr_return"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_moowr_clearance" model="ir.actions.report">
        <field name="name">MOOWR Clearance</field>
        <field name="model">moowr.clearance</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">zivoit_moowr.report_moowr_clearance</field>
        <field name="report_file">zivoit_moowr.report_moowr_clearance</field>
        <field name="print_report_name">'MOOWR Clearance - %s' % (object.name.replace('/', '-'))</field>
        <field name="binding_model_id" ref="model_moowr_clearance"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
