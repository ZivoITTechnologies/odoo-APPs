<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_moowr" model="res.groups.privilege">
        <field name="name">MOOWR Bonded Warehouse</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>

    <record id="group_moowr_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_moowr"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="group_moowr_manager" model="res.groups">
        <field name="name">Compliance Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_moowr"/>
        <field name="implied_ids" eval="[(4, ref('group_moowr_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="moowr_licence_company_rule" model="ir.rule">
        <field name="name">MOOWR licence: multi-company</field>
        <field name="model_id" ref="model_moowr_licence"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="moowr_boe_company_rule" model="ir.rule">
        <field name="name">MOOWR bill of entry: multi-company</field>
        <field name="model_id" ref="model_moowr_boe"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="moowr_boe_line_company_rule" model="ir.rule">
        <field name="name">MOOWR bill of entry line: multi-company</field>
        <field name="model_id" ref="model_moowr_boe_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="moowr_batch_company_rule" model="ir.rule">
        <field name="name">MOOWR batch: multi-company</field>
        <field name="model_id" ref="model_moowr_batch"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="moowr_ledger_company_rule" model="ir.rule">
        <field name="name">MOOWR register: multi-company</field>
        <field name="model_id" ref="model_moowr_ledger"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="moowr_clearance_company_rule" model="ir.rule">
        <field name="name">MOOWR clearance: multi-company</field>
        <field name="model_id" ref="model_moowr_clearance"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="moowr_return_company_rule" model="ir.rule">
        <field name="name">MOOWR return: multi-company</field>
        <field name="model_id" ref="model_moowr_return"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
