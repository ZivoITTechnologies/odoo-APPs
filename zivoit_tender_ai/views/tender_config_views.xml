<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zivoit_tender_stage_list" model="ir.ui.view">
        <field name="name">zivoit.tender.stage.list</field>
        <field name="model">zivoit.tender.stage</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="stage_type"/>
                <field name="fold"/>
                <field name="mail_template_id"/>
            </list>
        </field>
    </record>
    <record id="action_zivoit_tender_stage" model="ir.actions.act_window">
        <field name="name">Pipeline Stages</field>
        <field name="res_model">zivoit.tender.stage</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_zivoit_tender_sector_list" model="ir.ui.view">
        <field name="name">zivoit.tender.sector.list</field>
        <field name="model">zivoit.tender.sector</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="keywords"/>
                <field name="tender_count"/>
            </list>
        </field>
    </record>
    <record id="view_zivoit_tender_sector_form" model="ir.ui.view">
        <field name="name">zivoit.tender.sector.form</field>
        <field name="model">zivoit.tender.sector</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group><field name="name"/><field name="code"/><field name="color" widget="color_picker"/></group>
                        <group><field name="active"/><field name="tender_count"/></group>
                    </group>
                    <group string="Classifier">
                        <field name="keywords" placeholder="road, highway, widening, NH-"/>
                        <field name="exclude_keywords"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_zivoit_tender_sector" model="ir.actions.act_window">
        <field name="name">Sectors &amp; Keywords</field>
        <field name="res_model">zivoit.tender.sector</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_zivoit_tender_zone_list" model="ir.ui.view">
        <field name="name">zivoit.tender.zone.list</field>
        <field name="model">zivoit.tender.zone</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="zone_type"/>
                <field name="headquarters"/>
                <field name="aliases"/>
            </list>
        </field>
    </record>
    <record id="action_zivoit_tender_zone" model="ir.actions.act_window">
        <field name="name">Railway Zones &amp; PSUs</field>
        <field name="res_model">zivoit.tender.zone</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_zivoit_tender_tag_list" model="ir.ui.view">
        <field name="name">zivoit.tender.tag.list</field>
        <field name="model">zivoit.tender.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom"><field name="name"/><field name="color" widget="color_picker"/></list>
        </field>
    </record>
    <record id="action_zivoit_tender_tag" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">zivoit.tender.tag</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_zivoit_tender_lost_reason_list" model="ir.ui.view">
        <field name="name">zivoit.tender.lost.reason.list</field>
        <field name="model">zivoit.tender.lost.reason</field>
        <field name="arch" type="xml">
            <list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="reason_type"/></list>
        </field>
    </record>
    <record id="action_zivoit_tender_lost_reason" model="ir.actions.act_window">
        <field name="name">Lost / No-Bid Reasons</field>
        <field name="res_model">zivoit.tender.lost.reason</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_zivoit_checklist_template_form" model="ir.ui.view">
        <field name="name">zivoit.tender.checklist.template.form</field>
        <field name="model">zivoit.tender.checklist.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group><field name="name"/><field name="is_default"/></group>
                        <group><field name="sector_ids" widget="many2many_tags"/><field name="active"/></group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="category"/>
                            <field name="name"/>
                            <field name="weight"/>
                            <field name="mandatory"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_zivoit_checklist_template_list" model="ir.ui.view">
        <field name="name">zivoit.tender.checklist.template.list</field>
        <field name="model">zivoit.tender.checklist.template</field>
        <field name="arch" type="xml">
            <list><field name="sequence" widget="handle"/><field name="name"/><field name="sector_ids" widget="many2many_tags"/><field name="is_default"/></list>
        </field>
    </record>
    <record id="action_zivoit_checklist_template" model="ir.actions.act_window">
        <field name="name">Bid / No-Bid Checklists</field>
        <field name="res_model">zivoit.tender.checklist.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_zivoit_corrigendum_list" model="ir.ui.view">
        <field name="name">zivoit.tender.corrigendum.list</field>
        <field name="model">zivoit.tender.corrigendum</field>
        <field name="arch" type="xml">
            <list>
                <field name="tender_id"/>
                <field name="date"/>
                <field name="name"/>
                <field name="description"/>
                <field name="new_date_closing"/>
                <field name="applied"/>
            </list>
        </field>
    </record>
    <record id="view_zivoit_corrigendum_form" model="ir.ui.view">
        <field name="name">zivoit.tender.corrigendum.form</field>
        <field name="model">zivoit.tender.corrigendum</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group><field name="tender_id"/><field name="name"/><field name="date"/></group>
                        <group><field name="new_date_closing"/><field name="new_date_opening"/><field name="new_estimated_value"/><field name="applied"/></group>
                    </group>
                    <field name="description"/>
                    <field name="attachment_ids" widget="many2many_binary"/>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
