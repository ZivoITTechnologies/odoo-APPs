<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_tender" model="ir.module.category">
        <field name="name">Tenders &amp; Bidding</field>
        <field name="sequence">25</field>
    </record>

    <record id="res_groups_privilege_tender" model="res.groups.privilege">
        <field name="name">Tender AI</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_tender"/>
    </record>

    <record id="group_tender_user" model="res.groups">
        <field name="name">Tender Executive</field>
        <field name="comment">Finds tenders, runs agents, prepares and submits bids.</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_tender"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_tender_manager" model="res.groups">
        <field name="name">Tender Manager</field>
        <field name="comment">Full access including configuration, sources, AI settings and pipeline stages.</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_tender"/>
        <field name="implied_ids" eval="[(4, ref('group_tender_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- multi-company -->
    <record id="rule_tender_company" model="ir.rule">
        <field name="name">Tender: multi-company</field>
        <field name="model_id" ref="model_zivoit_tender"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_tender_source_company" model="ir.rule">
        <field name="name">Tender source: multi-company</field>
        <field name="model_id" ref="model_zivoit_tender_source"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <!-- agents: own + shared for executives, all for managers -->
    <record id="rule_tender_profile_user" model="ir.rule">
        <field name="name">Tender agent: own or shared</field>
        <field name="model_id" ref="model_zivoit_tender_profile"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('shared', '=', True)]</field>
        <field name="groups" eval="[(4, ref('group_tender_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_tender_profile_user_write" model="ir.rule">
        <field name="name">Tender agent: edit own</field>
        <field name="model_id" ref="model_zivoit_tender_profile"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_tender_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_tender_profile_manager" model="ir.rule">
        <field name="name">Tender agent: managers see all</field>
        <field name="model_id" ref="model_zivoit_tender_profile"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_tender_manager'))]"/>
    </record>
</odoo>
