<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_zivoit_tender" model="ir.sequence">
            <field name="name">Tender</field>
            <field name="code">zivoit.tender</field>
            <field name="prefix">TND/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
    <function model="res.currency" name="write" eval="[[ref('base.INR')], {'active': True}]"/>
</odoo>
