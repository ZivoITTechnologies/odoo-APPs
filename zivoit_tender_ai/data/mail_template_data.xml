<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_tender_digest" model="mail.template">
            <field name="name">Tender AI: Daily Digest</field>
            <field name="model_id" ref="model_zivoit_tender_profile"/>
            <field name="subject">Tender digest - {{ object.name }} - {{ len(object._get_digest_tenders()['new']) }} new, {{ len(object._get_digest_tenders()['closing']) }} closing soon</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; font-size: 13px; color: #1f2a44;">
    <t t-set="digest" t-value="object._get_digest_tenders()"/>
    <div style="background:#0b2a5b; color:#ffffff; padding:14px 18px;">
        <span style="font-size:18px; font-weight:bold;">Tender AI Digest</span><br/>
        <span>Agent: <t t-out="object.name"/></span>
    </div>
    <p style="margin:14px 0 6px 0;"><b>New matching tenders (last 24 hours): <t t-out="len(digest['new'])"/></b></p>
    <table t-if="digest['new']" style="border-collapse:collapse; width:100%;" cellpadding="6">
        <tr style="background:#1d4f91; color:#ffffff;">
            <th align="left">Tender</th><th align="left">Buyer</th><th align="right">Value</th><th align="left">Closes</th><th align="right">Score</th>
        </tr>
        <tr t-foreach="digest['new'][:30]" t-as="t" style="border-bottom:1px solid #dde3ee;">
            <td><t t-out="t.code"/> - <t t-out="t.name"/></td>
            <td><t t-out="t.organisation or '-'"/></td>
            <td align="right"><t t-out="t._format_inr(t.estimated_value) if t.estimated_value else '-'"/></td>
            <td><t t-out="t.date_closing_local or '-'"/></td>
            <td align="right"><t t-out="t.relevance_score"/></td>
        </tr>
    </table>
    <p style="margin:18px 0 6px 0;"><b>Matched tenders closing within 3 days: <t t-out="len(digest['closing'])"/></b></p>
    <table t-if="digest['closing']" style="border-collapse:collapse; width:100%;" cellpadding="6">
        <tr style="background:#b3261e; color:#ffffff;">
            <th align="left">Tender</th><th align="left">Stage</th><th align="left">Closes</th>
        </tr>
        <tr t-foreach="digest['closing']" t-as="t" style="border-bottom:1px solid #dde3ee;">
            <td><t t-out="t.code"/> - <t t-out="t.name"/></td>
            <td><t t-out="t.stage_id.name"/></td>
            <td><t t-out="t.date_closing_local"/></td>
        </tr>
    </table>
    <p style="color:#6b7690; margin-top:18px;">Sent by ZivoIT Tender AI.</p>
</div>
            </field>
        </record>

        <record id="mail_template_tender_shortlisted" model="mail.template">
            <field name="name">Tender AI: Tender Shortlisted</field>
            <field name="model_id" ref="model_zivoit_tender"/>
            <field name="subject">Shortlisted: {{ object.code }} {{ object.name[:80] }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; font-size: 13px;">
    <p>The tender <b><t t-out="object.name"/></b> (<t t-out="object.reference or object.code"/>) has been shortlisted for bidding.</p>
    <ul>
        <li>Buyer: <t t-out="object.organisation or '-'"/></li>
        <li>Estimated value: <t t-out="object._format_inr(object.estimated_value) if object.estimated_value else 'not published'"/></li>
        <li>EMD: <t t-out="object._format_inr(object.emd_amount) if object.emd_amount else '-'"/></li>
        <li>Bid submission end: <t t-out="object.date_closing_local or '-'"/></li>
        <li>Bid manager: <t t-out="object.user_id.name or '-'"/></li>
    </ul>
    <p>Please complete the Bid / No-Bid checklist and BOQ costing.</p>
</div>
            </field>
        </record>

        <record id="stage_shortlist" model="zivoit.tender.stage">
            <field name="mail_template_id" ref="mail_template_tender_shortlisted"/>
        </record>
    </data>
</odoo>
