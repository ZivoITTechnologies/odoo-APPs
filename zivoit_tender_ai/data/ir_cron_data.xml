<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_run_agents" model="ir.cron">
            <field name="name">Tender AI: Run Tender Agents</field>
            <field name="model_id" ref="model_zivoit_tender_profile"/>
            <field name="state">code</field>
            <field name="code">model._cron_run_agents()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
        </record>
        <record id="cron_fetch_feeds" model="ir.cron">
            <field name="name">Tender AI: Fetch Feeds &amp; APIs</field>
