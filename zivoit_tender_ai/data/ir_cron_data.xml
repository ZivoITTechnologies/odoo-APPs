            <field name="interval_type">hours</field>
        </record>
        <record id="cron_refresh_flags" model="ir.cron">
            <field name="name">Tender AI: Refresh Deadlines &amp; Expire Missed Tenders</field>
            <field name="model_id" ref="model_zivoit_tender"/>
